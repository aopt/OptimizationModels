G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
          Ramsey Growth Model,
          an example of a dynamic general equilibrium model.
          December 2001, Erwin Kalvelagen
          
          References:
             F.P. Ramsey: A Mathematical Theory of Saving,
             Economics Journal, December 1928.
             
             A. Manne: GAMS/MINOS: Three examples, manuscript,
             Department of Operations Research, Stanford University,
             1986
             
             M.I. Lau, A. Pahlke, and T.F. Rutherford,
             Modeling Economic Adjustment: A Primer in Dynamic General
             Equilibrium Analysis, Report, University of Colorado, 1997
             
  20   
  21  *
  22  * data for the model
  23  *
  24   
  25  set t 'time periods' / t0*t25 /;
  26  scalars
  27     rho    'discount factor'             / 0.05 /
  28     g      'labor growth rate'           / 0.03 /
  29     delta  'capital depreciation factor' / 0.02 /
  30     K0     'initial capital'             / 3.00 /
  31     I0     'initial investment'          / 0.05 /
  32     C0     'initial consumption'         / 0.95 /
  33     L0     'initial labor'               / 1.00 /
  34     b      'Cobb-Douglas coefficient'    / 0.25 /
  35     a      'Cobb-Douglas coefficient'
  36  ;
  37   
  38  *
  39  * derived sets
  40  *
  41  sets
  42     tfirst(t) ’first period’
  43     tlast(t) ’last period’
  44     tnotlast(t) ’all but last’
  45  ;
  46   
  47  tfirst(t)$(ord(t)=1) = yes;
  48  tlast(t)$(ord(t)=card(t)) = yes;
  49  tnotlast(t)= not tlast(t);
  50   
  51  parameters
  52     L(t)     'Labor (production input, exogeneous)'
  53     beta(t)  'weight factor for future utilities'
  54     tval(t)  'numerical value of t'
  55  ;
  56   
  57  tval(t) = ord(t)-1;
  58   
  59  *
  60  * the terminal weight beta(tlast) will get extra emphasis to
  61  * compensate for future utilities beyond tlast.
  62  *
  63  beta(tnotlast(t)) = (1+rho)**(-tval(t));
  64  beta(tlast(t)) = (1/rho)*(1+rho)**(1-tval(t));
  65  display beta;
  66   
  67  *
  68  * labor is exogeneously determined using an exponential growth process
  69  *
  70  L(t) = (1+g)**tval(t) * L0;
  71  display L;
  72   
  73  *
  74  * we can calculate a from Y0 = C0 + I0 and Y0 = f(K0,L0) = a K0^b L0^(1-b)
  75  *
  76  a = (C0 + I0) / (K0**b * L0**(1-b));
  77  display a;
  78   
  79   
  80  positive variables
  81     C(t) 'consumption'
  82     Y(t) 'production output'
  83     K(t) 'capital (production input,endogeneous)'
  84     I(t) 'investment'
  85  ;
  86  variable
  87     W    'total utility'
  88  ;
  89   
  90  equation
  91     production(t)   'Cobb-Douglas production function'
  92     allocation(t)   'household chooses between consumption and saving'
  93     accumulation(t) 'capital accumulation'
  94     utility         'discounted utility'
  95     final(t)        'minimal investment in final period'
  96  ;
  97   
  98  utility..                   W =e= sum(t,beta(t)*log(C(t)));
  99  production(t)..             Y(t) =e= a * (K(t)**b) * (L(t)**(1-b));
 100  allocation(t)..             Y(t) =e= C(t) + I(t);
 101  accumulation(tnotlast(t)).. K(t+1) =e= (1-delta)*K(t) + I(t);
 102  final(tlast)..              I(tlast) =g= (g+delta)*K(tlast);
 103   
 104  *
 105  * bounds so real power and log can be evaluated
 106  *
 107  K.lo(t) = 0.001; C.lo(t) = 0.001;
 108   
 109  *
 110  * initial conditions
 111  *
 112  K.fx(tfirst) = K0;
 113  I.fx(tfirst) = I0;
 114  C.fx(tfirst) = C0;
 115   
 116  *
 117  * initial point for nonlinear variables
 118  *
 119  K.l(t) = K0;
 120  C.l(t) = C0;
 121   
 122  model ramsey /all/;
 123  option nlp=conopt;
 124  solve ramsey maximizing W using nlp;
 125   
 126   
 127  parameter results(t,*);
 128  results(t,'C') = C.l(t);
 129  results(t,'Y') = Y.l(t);
 130  results(t,'K') = K.l(t);
 131  results(t,'I') = I.l(t);
 132  option decimals=8;
 133  display results,W.l;


