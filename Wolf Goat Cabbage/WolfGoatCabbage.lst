G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
      A farmer with a wolf, a goat, and a cabbage must cross a river by boat. The boat can carry
      only the farmer and a single item. If left unattended together, the wolf would eat the goat,
      or the goat would eat the cabbage. How can they cross the river without anything being eaten?
       
      https://en.wikipedia.org/wiki/Wolf,_goat_and_cabbage_problem
       
  10   
  11   
  12  *-------------------------------------------------------------------------
  13  * data
  14  *-------------------------------------------------------------------------
  15   
  16  sets
  17  ** basic sets
  18     dummy 'for ordering in displays' /initial/
  19     trip 'trips' /trip1*trip10/
  20     item /wolf,goat,cabbage/
  21     side 'left/right bank' /L,R/
  22     dir 'direction of trip' /'L->R','R->L'/
  23     case 'forbidden item combinations' /case1,case2/
  24   
  25  ** derived sets
  26     tripDir(trip,dir) 'trip direction combos'
  27     arrival(trip,side) 'this is an arrival'
  28     departure(trip,side) 'this is a departure'
  29  ;
  30   
  31  * trips 1,3,5,.. are L->R, trips 2,4,6,..  are R->L
  32  tripDir(trip,'L->R') = mod(ord(trip),2) = 1;
  33  tripDir(trip,'R->L') = mod(ord(trip),2) = 0;
  34  display trip,dir,tripDir;
  35   
  36  * arrival or departure
  37  arrival(trip,'L') = tripdir(trip,'R->L');
  38  arrival(trip,'R') = tripdir(trip,'L->R');
  39  departure(trip,side) = not arrival(trip,side);
  40  display arrival,departure;
  41   
  42  * all items are on the left bank initially
  43  parameter InvInitial(item,side,trip) 'start inventory before trip1' /
  44      (wolf, goat, cabbage).L.trip1   1
  45  /;
  46   
  47  * the final state is to have all items on the right bank
  48  parameter InvTarget(item,side) 'target inventory' /
  49      (wolf, goat, cabbage).R   1
  50  /;
  51   
  52  * these combinations can not be left alone
  53  table Eat(case,item) 'combinations not allowed'
  54          wolf  goat  cabbage
  55  case1     1     1
  56  case2           1      1
  57  ;
  58   
  59  *-------------------------------------------------------------------------
  60  * Model
  61  *-------------------------------------------------------------------------
  62   
  63  variables
  64     pax(trip,item)      'passengers: items taken on each trip'
  65     inv(trip,side,item) 'inventory just after trip'
  66     done(trip)          'if 1 we are done'
  67     z                   'objective'
  68  ;
  69  binary variable pax,inv,done;
  70   
  71  equations
  72     countPassengers(trip)       'max number of passengers/items on a trip'
  73     invBal(side,item,trip,dir)  'inventory balance after trip'
  74     eating(trip,side,case)      'some combinations of items are forbidden when unattended'
  75     isDone1(trip,item)          "done = prod(item,inv(trip,'R',item))"
  76     isDone2(trip)               "done = prod(item,inv(trip,'R',item))"
  77     ordering(trip)              'done(trip)>=done(trip-1)'
  78     obj                         'objective'
  79  ;
  80   
  81  * capacity constraint
  82  countPassengers(trip).. sum(item,pax(trip,item)) =l= 1;
  83   
  84  * inventory just after trip
  85  invBal(side,item,tripDir(trip,dir))..
  86      inv(trip,side,item) =e= inv(trip-1,side,item) + pax(trip,item)$arrival(trip,side) - pax(trip,item)$departure(trip,side) 
      + invInitial(item,side,trip);
  87   
  88  * forbidden combinations
  89  eating(departure(trip,side),case)..
  90      sum(item, Eat(case,item)*inv(trip,side,item)) =l= 1+done(trip);
  91   
  92  * done = prod(item,inv(trip,'R',item))
  93  isDone1(trip,item).. done(trip) =l= inv(trip,'R',item);
  94  isDone2(trip).. done(trip) =g= sum(item,inv(trip,'R',item))-2;
  95   
  96  * done(trip)>=done(trip-1)
  97  * ordering(trip-1).. makes sure we only generate the constraints that are needed
  98  ordering(trip-1).. done(trip) =g= done(trip-1);
  99   
 100  * maximize number of "done" trips
 101  obj.. z =e= sum(trip, done(trip));
 102   
 103  * optional
 104  done.fx(trip)$(ord(trip)=card(trip)) = 1;
 105  inv.fx(trip,side,item)$(ord(trip)=card(trip)) = invTarget(item,side);
 106   
 107  model m /all/;
 108  solve m maximizing z using mip;
 109  abort$(m.modelstat <> 1 and m.modelstat <> 8) "No solution";
 110   
 111  *-------------------------------------------------------------------------
 112  * raw results
 113  *-------------------------------------------------------------------------
 114   
 115  option pax:0,inv:0:1:2,done:0;
 116  display pax.l,inv.l,done.l,z.l;
 117   
 118  *-------------------------------------------------------------------------
 119  * more meaningful trip report
 120  *-------------------------------------------------------------------------
 121   
 122  alias(item,item2);
 123   
 124  parameter trace(*,*,*,side,item) 'trip report';
 125  trace('initial','','',side,item) = invInitial(item,side,'trip1');
 126  loop(trip,
 127     trace(tripDir(trip,dir),item,side,item2)$(pax.l(trip,item)>0.5) = inv.l(trip,side,item2);
 128     trace(tripDir(trip,dir),'',side,item2)$(sum(item,pax.l(trip,item))<0.5) = inv.l(trip,side,item2);
 129     break$(done.l(trip)>0.5);
 130  );
 131  option trace:0:3:2;
 132  display trace;
 133   
 134  *-------------------------------------------------------------------------
 135  * find second solution
 136  * for binary variable x(i):
 137  *   ecut(cut).. sum(i$sol(i,cut),x(i)) - sum(i$(sol(i,cut)=0),x(i)) =l= sum(i$sol(i,cut),1) - 1;
 138  *-------------------------------------------------------------------------
 139   
 140  sets
 141     cut 'static set' /cut1*cut2/
 142     dcut(cut) 'dynamic subset'
 143     ti(trip,item) 'trip-item combos'
 144  ;
 145  ti(trip,item) = yes;
 146   
 147  parameter sol(trip,item,cut) 'earlier solutions';
 148   
 149  equation ecut(cut) 'no-good cut';
 150   
 151  ecut(dcut).. sum(ti$sol(ti,dcut),pax(ti)) - sum(ti$(sol(ti,dcut)=0),pax(ti)) =l= sum(ti$sol(ti,dcut),1) - 1;
 152   
 153  * find second solution with same objective value
 154  model m2/m,ecut/;
 155  dcut('cut1') = yes;
 156  sol(ti,'cut1') = round(pax.l(ti));
 157  z.fx = round(z.l);
 158  solve m2 maximizing z using mip;
 159  abort$(m2.modelstat <> 1 and m2.modelstat <> 8) "No second solution";
 160  display pax.l;
 161   
 162  * there should be no third solution: this model is infeasible
 163  dcut('cut2') = yes;
 164  sol(ti,'cut2') = round(pax.l(ti));
 165  solve m2 maximizing z using mip;
 166  abort$(m2.modelstat = 1 or m2.modelstat = 8) "Expected model to be infeasible";


