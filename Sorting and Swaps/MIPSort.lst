G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        MIP model
       
        Find a way to reorganize the list
            BDADDDBCCC → ABBCCCDDDD
        (sorting) using as few swaps as
        passible.  
       
        We can use a numerical version:
            2414442333 → 1223334444  
        
  14   
  15   
  16  *---------------------------------------------------------------
  17  * data
  18  *---------------------------------------------------------------
  19   
  20  Set
  21    i 'items' /item1*item10/
  22    k 'max iterations' /iter0*iter10/
  23  ;
  24   
  25  alias(i,j);
  26   
  27  Parameter
  28     init(i) 'initial ordering 2414442333' /
  29        item3 1
  30        (item1, item7) 2
  31        (item8*item10) 3
  32        (item2, item4*item6) 4
  33     /;
  34   
  35  display init;
  36   
  37  *---------------------------------------------------------------
  38  * linear MIP model
  39  *---------------------------------------------------------------
  40   
  41  variables
  42      x(k,i) 'values'
  43      itcount 'to minimize'
  44   
  45  ;
  46   
  47  x.lo(k,i) = smin(j,init(j));
  48  x.up(k,i) = smax(j,init(j));
  49  x.fx('iter0',i) = init(i);
  50   
  51   
  52  Scalar M 'big-M';
  53  M = smax(i,init(i))-smin(i,init(i));
  54   
  55   
  56  binary Variables
  57     s(k,i) 's(k,i)=1 : x(k,i) stays the same'
  58     d(k)   'd(k)=1 : we are done. No change needed anymore.'
  59  ;
  60  s.fx('iter0',i) = 0;
  61   
  62   
  63  equations
  64    count_same(k) 'number of x(k,i) that should stay the same'
  65    calc_itcount  'calc iteration count (obj)'
  66    same1(k,i)    'big-M constraint for x(k,i) staying the same'
  67    same2(k,i)    'big-M constraint for x(k,i) staying the same'
  68    swap1(k,i,j)  'big-M constraint for x(k,i) being swapped'
  69    swap2(k,i,j)  'big-M constraint for x(k,i) being swapped'
  70    isSorted(k,i) 'big-M constraint for detecting x(k,i) is sorted'
  71   
  72  * optional constraints
  73    order(k)      'optional: d(k) is ordered'
  74    extra(k)      'optional: x always adds up to the same number'
  75  ;
  76   
  77  * counts
  78  * done(k)=0 => sum(i, same(k,i)) = n-2
  79  * done(k)=1 => sum(i, same(k,i)) = n
  80  count_same(k)$(ord(k)>1).. sum(i, s(k,i)) =e= card(i)-2*(1-d(k));
  81   
  82  * same
  83  * same(k,i)=1 ==> x(k,i) = x(k-1,i)
  84  same1(k,i)$(ord(k)>1)..x(k,i) =l= x(k-1,i) + M*(1-s(k,i));
  85  same2(k,i)$(ord(k)>1)..x(k,i) =g= x(k-1,i) - M*(1-s(k,i));
  86   
  87  * swap
  88  * same(k,i)=0 & same(k,j)=0 ==> x(k,i) = x(k-1,j), x(k,j) = x(k-1,i)
  89  * we will allow useless swaps
  90  swap1(k,i,j)$(ord(i)<>ord(j) and ord(k)>1).. x(k,i) =l= x(k-1,j) + M*(s(k,i)+s(k,j));
  91  swap2(k,i,j)$(ord(i)<>ord(j) and ord(k)>1).. x(k,i) =g= x(k-1,j) - M*(s(k,i)+s(k,j));
  92   
  93  * done
  94  isSorted(k,i)$(ord(i)>1 and ord(k)>1).. x(k-1,i) =g= x(k-1,i-1) - M*(1-d(k));
  95   
  96  * optional constraints (they help performance)
  97  order(k)$(ord(k)>1).. d(k) =g= d(k-1);
  98   
  99  extra(k).. sum(i, x(k,i)) =e= sum(i,init(i));
 100   
 101  * obj
 102  calc_itcount.. itcount =e= sum(k$(ord(k)>1), 1-d(k));
 103   
 104  model sort /all/;
 105  solve sort minimizing itcount using mip;
 106  display x.l, s.l, d.l, itcount.l;
 107   
 108  * make a little report
 109  parameter trace(k,*);
 110  trace(k,i)$(d.l(k)<0.5) = x.l(k,i);
 111  display trace;
 112   


