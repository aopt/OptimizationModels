GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 03/19/26 23:41:40 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given are n data points (2d).
        Find the smallest triangle that contains all points.
       
        Three different definitions of size.
        
        Model m1: area, absolute value using variable splitting
              m2: area, absolute value using bounding
              m3: circumference 
              m4: sum of squares
              m5: as m4, use convex hull instead of all points 
       
  15   
  16  option nlp=scip, reslim=1000;
  17   
  18  *---------------------------------------------------------------------
  19  * data: points
  20  *---------------------------------------------------------------------
  21   
  22  sets
  23     i 'points'   /point1*point50/
  24     s(i) 'subset (e.g. convex hull)'
  25     c 'coordinates' /x,y/
  26     k  'corner points of triangle' /corner1*corner3/
  27  ;
  28   
  29  parameter p(i,c) 'data points';
  30  p(i,c) = uniform(0,100);
  31  display p;
  32   
  33   
  34  *---------------------------------------------------------------------
  35  * reporting
  36  *---------------------------------------------------------------------
  37   
  38  parameter
  39     results(*,*) 'combined results'
  40     triangle(*,k,c) 'solution'
  41  ;
  42   
  43  acronym timelimit;
  44   
  45  $macro report(m,id) \
  46  results(id,'area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))]); \
  47  results(id,'time') = m.resusd; \
  48  results(id,'obj') = m.objval;  \
  49  results(id,'best bound') = m.objest; \
  50  results(id,'gap%') = 100*abs(m.objest-m.objval)/m.objval; \
  51  results(id,'status')$(m.solvestat=3) = timelimit;\
  52  triangle(id,k,c) = t.l(k,c); \
  53  display results,triangle;
  54   
  55   
  56   
  57  *---------------------------------------------------------------------
  58  * constraints:
  59  *  points inside triangle using barymetric coordinates
  60  *  order corner points by x coordinate
  61  *---------------------------------------------------------------------
  62   
  63   
  64  positive variable
  65     lambda(i,k)  'barycentric coordinates'
  66  ;
  67   
  68  free variable
  69     t(k,c)  'triangle'
  70  ;
  71  * some reasonable bounds
  72  t.lo(k,c) = -1000;
  73  t.up(k,c) = +1000;
  74   
  75   
  76  equations
  77     calcLambda(i,c)  'solve for barycentric coordinates'
  78     sumLambda(i)     'lambdas need to add up to one'
  79     order            'order corner points by their x coordinate'
  80  ;
  81   
  82  calcLambda(s,c)..  p(s,c) =e= sum(k, lambda(s,k)*t(k,c));
  83  sumLambda(s)..     sum(k, lambda(s,k)) =e= 1;
  84  order(k-1)..       t(k,'x') =g= t(k-1,'x');
  85   
  86  model cons 'constraints' /calcLambda,sumLambda,order/;
  87   
  88   
  89  *---------------------------------------------------------------------
  90  * objective 1: area (variable splitting)
  91  *---------------------------------------------------------------------
  92   
  93  * use all points
  94  s(i) = yes;
  95   
  96  set
  97     pm 'plusmin -- used in linearizing abs()' /'+','-'/
  98  ;
  99   
 100  * shorthands to make our area calculation easier
 101  singleton sets
 102     x1(k,c) /'corner1'.'x'/
 103     x2(k,c) /'corner2'.'x'/
 104     x3(k,c) /'corner3'.'x'/
 105     y1(k,c) /'corner1'.'y'/
 106     y2(k,c) /'corner2'.'y'/
 107     y3(k,c) /'corner3'.'y'/
 108  ;
 109   
 110  variable
 111     z       'objective'
 112  ;
 113   
 114  positive variable
 115     area(pm)     'area (using variable splitting)'
 116  ;
 117   
 118  equations
 119     calcArea         'calculate area given its three corner points'
 120     obj              'objective'
 121  ;
 122   
 123  calcArea..         area('+')-area('-') =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
 124  obj..              z =e= sum(pm,area(pm));
 125   
 126  model m1 'area -- var splitting' /calcArea,obj,cons/;
 127  solve m1 minimizing z using nlp;
 128   
 129   results('m1 area var split','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l
      (y2))]); results('m1 area var split','time') = m1.resusd; results('m1 area var split','obj') = m1.objval;  results('m1 area 
      var split','best bound') = m1.objest; results('m1 area var split','gap%') = 100*abs(m1.objest-m1.objval)/m1.objval; results(
      'm1 area var split','status')$(m1.solvestat=3) = timelimit;triangle('m1 area var split',k,c) = t.l(k,c); display results,tri
      angle;
 130   
 131  *---------------------------------------------------------------------
 132  * objective 2: area (bounding)
 133  *---------------------------------------------------------------------
 134   
 135  variable
 136     a 'area'
 137     absa 'abs area'
 138  ;
 139  absa.lo = 0;
 140   
 141  equations
 142     calcArea2       'calculate area given its three corner points'
 143     bnd1            'objective bound'
 144     bnd2            'objective bound'
 145  ;
 146   
 147  calcArea2..         a =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
 148  bnd1..              a =l= absa;
 149  bnd2..              a =g= -absa;
 150   
 151  model m2 'area -- bounding' /calcArea2,bnd1,bnd2,cons/;
 152  solve m2 minimizing absa using nlp;
 153   
 154   results('m2 area bnd','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))]
      ); results('m2 area bnd','time') = m2.resusd; results('m2 area bnd','obj') = m2.objval;  results('m2 area bnd','best bound')
       = m2.objest; results('m2 area bnd','gap%') = 100*abs(m2.objest-m2.objval)/m2.objval; results('m2 area bnd','status')$(m2.so
      lvestat=3) = timelimit;triangle('m2 area bnd',k,c) = t.l(k,c); display results,triangle;
 155   
 156  *---------------------------------------------------------------------
 157  * objective 3: circumference
 158  *---------------------------------------------------------------------
 159   
 160  alias(k,kk);
 161   
 162  equations
 163     circumference    'calculate perimeter of triangle'
 164  ;
 165   
 166  circumference..    z =e= sum((k,kk)$(ord(k)<ord(kk)), sqrt(sum(c,sqr(t(k,c)-t(kk,c)))));
 167   
 168  model m3 'area -- bounding' /circumference,cons/;
 169  solve m3 minimizing z using nlp;
 170   
 171   results('m3 circumference','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(
      y2))]); results('m3 circumference','time') = m3.resusd; results('m3 circumference','obj') = m3.objval;  results('m3 circumfe
      rence','best bound') = m3.objest; results('m3 circumference','gap%') = 100*abs(m3.objest-m3.objval)/m3.objval; results('m3 c
      ircumference','status')$(m3.solvestat=3) = timelimit;triangle('m3 circumference',k,c) = t.l(k,c); display results,triangle;
 172   
 173  *---------------------------------------------------------------------
 174  * objective 4: sum of squares
 175  *---------------------------------------------------------------------
 176   
 177  alias(k,kk);
 178   
 179  equations
 180     sos    'drop square root'
 181  ;
 182   
 183  sos..    z =e= sum((k,kk)$(ord(k)<ord(kk)), sum(c,sqr(t(k,c)-t(kk,c))));
 184   
 185  model m4 'area -- bounding' /sos,cons/;
 186  solve m4 minimizing z using nlp;
 187   
 188   results('m4 sos','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))]); re
      sults('m4 sos','time') = m4.resusd; results('m4 sos','obj') = m4.objval;  results('m4 sos','best bound') = m4.objest; result
      s('m4 sos','gap%') = 100*abs(m4.objest-m4.objval)/m4.objval; results('m4 sos','status')$(m4.solvestat=3) = timelimit;triangl
      e('m4 sos',k,c) = t.l(k,c); display results,triangle;
 189   
 190   
 191  *---------------------------------------------------------------------
 192  * model 4 hull: as previous but now use only the points
 193  * that are part of the convex hull
 194  *---------------------------------------------------------------------
 195   
 196  set hull(i) 'convex hull';
 197   
 198  embeddedCode Python:
 199  import scipy as sp
 200  import numpy as np
 201  import gams.transfer as gt
 202   
 203  i = list(gams.get("i"))
 204  p = gt.Container(gams.db)["p"].toDense()
 205  hull = sp.spatial.ConvexHull(p).vertices
 206  h = [i[pt] for pt in hull]
 207  gams.set("hull",h)
 208  endEmbeddedCode hull
 209   
 210  display hull;
 211   
 212  s(i) = no;
 213  s(hull) = yes;
 214  solve m4 minimizing z using nlp;
 215   
 216   results('m4 sos hull','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))]
      ); results('m4 sos hull','time') = m4.resusd; results('m4 sos hull','obj') = m4.objval;  results('m4 sos hull','best bound')
       = m4.objest; results('m4 sos hull','gap%') = 100*abs(m4.objest-m4.objval)/m4.objval; results('m4 sos hull','status')$(m4.so
      lvestat=3) = timelimit;triangle('m4 sos hull',k,c) = t.l(k,c); display results,triangle;
 217   
 218  *---------------------------------------------------------------------
 219  * visualization
 220  *---------------------------------------------------------------------
 221   
 224   
 225  file fdata /data.js/; put fdata;
 226   
 227  * points
 228  put "px=["; loop(i,put p(i,'x'):0:3,","); put "];"/;
 229  put "py=["; loop(i,put p(i,'y'):0:3,","); put "];"/;
 230  * triangles
 231  put "txm1=["; loop(k,put triangle('m1 area var split',k,'x'):0:3,","); put "];"/;
 232  put "tym1=["; loop(k,put triangle('m1 area var split',k,'y'):0:3,","); put "];"/;
 233  put "txm3=["; loop(k,put triangle('m3 circumference',k,'x'):0:3,","); put "];"/;
 234  put "tym3=["; loop(k,put triangle('m3 circumference',k,'y'):0:3,","); put "];"/;
 235  put "txm4=["; loop(k,put triangle('m4 sos',k,'x'):0:3,","); put "];"/;
 236  put "tym4=["; loop(k,put triangle('m4 sos',k,'y'):0:3,","); put "];"/;
