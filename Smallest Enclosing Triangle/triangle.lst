GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 03/18/26 10:51:33 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given are n data points (2d).
        Find the smallest triangle that contains all points.
       
        Global NLP solvers have problems with this model.
        The lower bound does not move from 0, even if we reduce
        the size of the problem to 3 points.
       
       
        https://yetanothermathprogrammingconsultant.blogspot.com/2023/01/tiny-non-convex-quadratic-model-brings.html
        https://yetanothermathprogrammingconsultant.blogspot.com/2026/03/revisiting-crazy-global-nlp-problem.html
        
        
  16   
  17  option nlp=scip, reslim=1000;
  18   
  19  *---------------------------------------------------------------------
  20  * data: points
  21  *---------------------------------------------------------------------
  22   
  23  set
  24     i 'points'   /point1*point3/
  25     c 'coordinates' /x,y/
  26  ;
  27   
  28  parameter p(i,c) 'data points';
  29  p(i,c) = uniform(0,100);
  30   
  31  *---------------------------------------------------------------------
  32  * find smallest triangle to contain all points
  33  * original formulation
  34  *---------------------------------------------------------------------
  35   
  36  sets
  37     k  'corner points of triangle' /corner1*corner3/
  38     pm 'plusmin -- used in linearizing abs()' /'+','-'/
  39  ;
  40   
  41  * shorthands to make our area calculation easier
  42  singleton sets
  43     x1(k,c) /'corner1'.'x'/
  44     x2(k,c) /'corner2'.'x'/
  45     x3(k,c) /'corner3'.'x'/
  46     y1(k,c) /'corner1'.'y'/
  47     y2(k,c) /'corner2'.'y'/
  48     y3(k,c) /'corner3'.'y'/
  49  ;
  50   
  51   
  52  variable
  53     t(k,c)  'triangle'
  54     z       'objective'
  55  ;
  56   
  57  positive variable
  58     area(pm)     'area (using variable splitting)'
  59     lambda(i,k)  'barycentric coordinates'
  60  ;
  61   
  62  equations
  63     calcArea         'calculate area given its three corner points'
  64     calcLambda(i,c)  'solve for barycentric coordinates'
  65     sumLambda(i)     'lambdas need to add up to one'
  66     obj              'objective'
  67     order            'order corner points by their x coordinate'
  68  ;
  69   
  70  calcArea..         area('+')-area('-') =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
  71  calcLambda(i,c)..  p(i,c) =e= sum(k, lambda(i,k)*t(k,c));
  72  sumLambda(i)..     sum(k, lambda(i,k)) =e= 1;
  73  obj..              z =e= sum(pm,area(pm));
  74  order(k-1)..       t(k,'x') =g= t(k-1,'x');
  75   
  76   
  77  * some reasonable bounds
  78  t.lo(k,c) = -1000;
  79  t.up(k,c) = +1000;
  80   
  81  model m1 /all/;
  82  solve m1 minimizing z using nlp;
  83   
  84  *---------------------------------------------------------------------
  85  * reporting
  86  *---------------------------------------------------------------------
  87   
  88  display p,t.l,area.l,lambda.l;


