GAMS 52.1.0  4f802a74 Nov 28, 2025          WEX-WEI x86 64bit/MS Windows - 12/09/25 06:59:45 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
      Find
       
        |x1|x2|x3|  where x(i) ∈ {0,..,9}
       
      with the following rules
       
        |6|8|2|  One number is correct and well placed
        
        |6|1|4|  One number is correct but wrongly placed
        
        |2|0|6|  Two numbers are correct but wrongly placed
        
        |7|3|8|  Nothing is correct
        
        |7|8|0|  One number is correct but wrongly placed 
       
       
      References:
       
         https://yetanothermathprogrammingconsultant.blogspot.com/2025/12/crack-passcode.html
         https://www.reddit.com/r/mathmemes/comments/1bbld8t/okay_reddit_geniuses_what_is_the_answer_im_stuck/
         https://www.youtube.com/watch?v=lK857tIT4X4
         
       
      ---------------------------------------------------------------    
       
        |6|8|2|  One number is correct and well placed
        <=> x[1,6]+x[2,8]+x[3,2]=1
            
        |6|1|4|  One number is correct but wrongly placed
        <=> x[2,6]+x[3,6]+x[1,1]+x[3,1]+x[1,4]+x[2,4]=1
          
        |2|0|6|  Two numbers are correct but wrongly placed
        <=> x[2,2]+x[3,2]+x[1,0]+x[3,0]+x[1,6]+x[2,6]=2    
       
        |7|3|8|  Nothing is correct
        <=> x[1,7]+x[2,7]+x[3,7]+x[1,3]+x[2,3]+x[3,3]+x[1,8]+x[2,8]+x[3,8]=0
          
        |7|8|0|  One number is correct but wrongly placed 
        <=> x[2,7]+x[3,7]+x[1,8]+x[3,8]+x[1,0]+x[2,0]=1
          
       
  46   
  47  *-----------------------------------------------------------------------
  48  * base model
  49  *-----------------------------------------------------------------------
  50   
  51   
  52  Sets
  53     i 'position' /i1,i2,i3/
  54     v 'value'    /0*9/
  55  ;
  56   
  57  binary variable x(i,v);
  58   
  59  equations
  60     onevalue(i) 'each position has one value'
  61     e1 '|6|8|2|  One number is correct and well placed'
  62     e2 '|6|1|4|  One number is correct but wrongly placed'
  63     e3 '|2|0|6|  Two numbers are correct but wrongly placed'
  64     e4 '|7|3|8|  Nothing is correct'
  65     e5 '|7|8|0|  One number is correct but wrongly placed'
  66  ;
  67   
  68  onevalue(i).. sum(v, x(i,v)) =e= 1;
  69  e1..   x['i1','6']+x['i2','8']+x['i3','2'] =e= 1;
  70  e2..  x['i2','6']+x['i3','6']+x['i1','1']+x['i3','1']+x['i1','4']+x['i2','4'] =e= 1;
  71  e3..  x['i2','2']+x['i3','2']+x['i1','0']+x['i3','0']+x['i1','6']+x['i2','6'] =e= 2;
  72  e4..  sum(i,x[i,'7']+x[i,'3']+x[i,'8']) =e= 0;
  73  e5..  x['i2','7']+x['i3','7']+x['i1','8']+x['i3','8']+x['i1','0']+x['i2','0'] =e= 1;
  74   
  75  variable z;
  76  equation obj 'dummy';
  77  obj.. z=e=0;
  78   
  79  * model 1: solve problem as is
  80  model m1 /all/;
  81  solve m1 minimizing z using mip;
  82  display x.l;
  83   
  84  * result:
  85  * |0|4|2|
  86   
  87   
  88  *-----------------------------------------------------------------------
  89  * check solution is unique
  90  * this model should be infeasible
  91  *-----------------------------------------------------------------------
  92   
  93  * model m2: forbid this solution (from m1)
  94  * now should be infeasible
  95  equation forbid 'cut off solution';
  96  forbid.. sum((i,v)$(x.l[i,v]>0.5),x[i,v]) =l= 2;
  97   
  98  model m2/m1+forbid/;
  99  solve m2 minimizing z using mip;
 100   
 101  abort$(m2.modelstat = 1 or m2.modelstat = 8) "This should be infeasible;";
 102   
 103  * result:
 104  * (integer) infeasible
 105   
 106   
 107  *-----------------------------------------------------------------------
 108  * can we find the same solution using just equations 1,2,3?
 109  * this will give a wrong solution
 110  *-----------------------------------------------------------------------
 111   
 112  model m3 /m1-e4-e5/;
 113  solve m3 minimizing z using mip;
 114  display x.l;
 115   
 116  * result (depending on solver):
 117  * |6|6|3|


