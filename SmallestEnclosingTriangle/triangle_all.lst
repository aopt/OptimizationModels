G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given are n data points (2d).
        Find the smallest triangle that contains all points.
       
        Three different definitions of size.
       
   9   
  10  option nlp=scip, reslim=1000;
  11   
  12  *---------------------------------------------------------------------
  13  * data: points
  14  *---------------------------------------------------------------------
  15   
  16  sets
  17     i 'points'   /point1*point50/
  18     c 'coordinates' /x,y/
  19  ;
  20   
  21  parameter p(i,c) 'data points';
  22  p(i,c) = uniform(0,100);
  23   
  24  *---------------------------------------------------------------------
  25  * constraints:
  26  *  points inside triangle using barymetric coordinates
  27  *  order corner points by x coordinate
  28  *---------------------------------------------------------------------
  29   
  30  set
  31     k  'corner points of triangle' /corner1*corner3/
  32  ;
  33   
  34  positive variable
  35     lambda(i,k)  'barycentric coordinates'
  36  ;
  37   
  38  free variable
  39     t(k,c)  'triangle'
  40  ;
  41  * some reasonable bounds
  42  t.lo(k,c) = -1000;
  43  t.up(k,c) = +1000;
  44   
  45   
  46  equations
  47     calcLambda(i,c)  'solve for barycentric coordinates'
  48     sumLambda(i)     'lambdas need to add up to one'
  49     order            'order corner points by their x coordinate'
  50  ;
  51   
  52  calcLambda(i,c)..  p(i,c) =e= sum(k, lambda(i,k)*t(k,c));
  53  sumLambda(i)..     sum(k, lambda(i,k)) =e= 1;
  54  order(k-1)..       t(k,'x') =g= t(k-1,'x');
  55   
  56   
  57  model cons 'constraints' /calcLambda,sumLambda,order/;
  58   
  59  *---------------------------------------------------------------------
  60  * objective 1: area (variable splitting)
  61  *---------------------------------------------------------------------
  62   
  63  parameter
  64     results(*,*) 'combined results'
  65     triangle(*,k,c) 'solution'
  66  ;
  67   
  68   
  69  set
  70     pm 'plusmin -- used in linearizing abs()' /'+','-'/
  71  ;
  72   
  73  * shorthands to make our area calculation easier
  74  singleton sets
  75     x1(k,c) /'corner1'.'x'/
  76     x2(k,c) /'corner2'.'x'/
  77     x3(k,c) /'corner3'.'x'/
  78     y1(k,c) /'corner1'.'y'/
  79     y2(k,c) /'corner2'.'y'/
  80     y3(k,c) /'corner3'.'y'/
  81  ;
  82   
  83  variable
  84     z       'objective'
  85  ;
  86   
  87  positive variable
  88     area(pm)     'area (using variable splitting)'
  89  ;
  90   
  91  equations
  92     calcArea         'calculate area given its three corner points'
  93     obj              'objective'
  94  ;
  95   
  96  calcArea..         area('+')-area('-') =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
  97  obj..              z =e= sum(pm,area(pm));
  98   
  99  model m1 'area -- var splitting' /calcArea,obj,cons/;
 100  solve m1 minimizing z using nlp;
 101   
 102  results('m1 area var split','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(
      y2))]);
 103  results('m1 area var split','time') = m1.resusd;
 104  triangle('m1',k,c) = t.l(k,c);
 105  display results,triangle;
 106   
 107  *---------------------------------------------------------------------
 108  * objective 2: area (bounding)
 109  *---------------------------------------------------------------------
 110   
 111  variable
 112     a 'area'
 113     absa 'abs area'
 114  ;
 115  absa.lo = 0;
 116   
 117  equations
 118     calcArea2       'calculate area given its three corner points'
 119     bnd1            'objective bound'
 120     bnd2            'objective bound'
 121  ;
 122   
 123  calcArea2..         a =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
 124  bnd1..              a =l= absa;
 125  bnd2..              a =g= -absa;
 126   
 127  model m2 'area -- bounding' /calcArea2,bnd1,bnd2,cons/;
 128  solve m2 minimizing absa using nlp;
 129   
 130  results('m2 area bnd','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))])
      ;
 131  results('m2 area bnd','time') = m2.resusd;
 132  triangle('m2',k,c) = t.l(k,c);
 133  display results,triangle;
 134   
 135  *---------------------------------------------------------------------
 136  * objective 3: circumference
 137  *---------------------------------------------------------------------
 138   
 139  alias(k,kk);
 140   
 141  equations
 142     circumference    'calculate perimeter of triangle'
 143  ;
 144   
 145  circumference..    z =e= sum((k,kk)$(ord(k)<ord(kk)), sqrt(sum(c,sqr(t(k,c)-t(kk,c)))));
 146   
 147  model m3 'area -- bounding' /circumference,cons/;
 148  solve m3 minimizing z using nlp;
 149   
 150  results('m3 circumference','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y
      2))]);
 151  results('m3 circumference','time') = m3.resusd;
 152  triangle('m3',k,c) = t.l(k,c);
 153  display results,triangle;
 154   
 155  *---------------------------------------------------------------------
 156  * objective 4: sum of squares
 157  *---------------------------------------------------------------------
 158   
 159  alias(k,kk);
 160   
 161  equations
 162     sos    'drop square root'
 163  ;
 164   
 165  sos..    z =e= sum((k,kk)$(ord(k)<ord(kk)), sum(c,sqr(t(k,c)-t(kk,c))));
 166   
 167  model m4 'area -- bounding' /sos,cons/;
 168  solve m4 minimizing z using nlp;
 169   
 170  results('m4 sos','area') = abs(0.5*[t.l(x1)*(t.l(y2)-t.l(y3)) + t.l(x2)*(t.l(y3)-t.l(y1)) + t.l(x3)*(t.l(y1)-t.l(y2))]);
 171  results('m4 sos','time') = m4.resusd;
 172  triangle('m4',k,c) = t.l(k,c);
 173  display results,triangle;
 174   
 175  *---------------------------------------------------------------------
 176  * visualization
 177  *---------------------------------------------------------------------
 178   
 181   
 182  file fdata /data.js/; put fdata;
 183   
 184  * points
 185  put "px=["; loop(i,put p(i,'x'):0:3,","); put "];"/;
 186  put "py=["; loop(i,put p(i,'y'):0:3,","); put "];"/;
 187  * triangles
 188  put "txm1=["; loop(k,put triangle('m1',k,'x'):0:3,","); put "];"/;
 189  put "tym1=["; loop(k,put triangle('m1',k,'y'):0:3,","); put "];"/;
 190  put "txm3=["; loop(k,put triangle('m3',k,'x'):0:3,","); put "];"/;
 191  put "tym3=["; loop(k,put triangle('m3',k,'y'):0:3,","); put "];"/;
 192  put "txm4=["; loop(k,put triangle('m4',k,'x'):0:3,","); put "];"/;
 193  put "tym4=["; loop(k,put triangle('m4',k,'y'):0:3,","); put "];"/;
 194   
 195  set mall /m1,m3,m4/;
 196   
 197  parameter box;
 198  box(c,'lo') = smin((mall,k),triangle(mall,k,c));
 199  box(c,'up') = smax((mall,k),triangle(mall,k,c));
 200  box(c,'range') = box(c,'up')-box(c,'lo');
 201  box(c,'lo2') =  box(c,'lo') - 0.1*box(c,'range');
 202  box(c,'up2') =  box(c,'up') + 0.1*box(c,'range');
 203  display box;
 204   
 205  put "cmin=["; loop(c, put box(c,'lo2'):0:3,","); put "];"/;
 206  put "cmax=["; loop(c, put box(c,'up2'):0:3,","); put "];"/;
 207   
 208   
