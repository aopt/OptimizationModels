G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given are n data points (2d).
        Find the smallest triangle that contains all points.
       
        Global NLP solvers have problems with this model.
        The lower bound does not move from 0.
        
        https://yetanothermathprogrammingconsultant.blogspot.com/2023/01/tiny-non-convex-quadratic-model-brings.html
        https://yetanothermathprogrammingconsultant.blogspot.com/2026/03/revisiting-crazy-global-nlp-problem.html
        
        
  14   
  15  option nlp=scip, reslim=1000;
  16   
  17  *---------------------------------------------------------------------
  18  * data: points
  19  *---------------------------------------------------------------------
  20   
  21  set
  22     i 'points'   /point1*point25/
  23     c 'coordinates' /x,y/
  24  ;
  25   
  26  parameter p(i,c) 'data points';
  27  p(i,c) = uniform(0,100);
  28   
  29  *---------------------------------------------------------------------
  30  * find smallest triangle to contain all points
  31  * original formulation
  32  *---------------------------------------------------------------------
  33   
  34  sets
  35     k  'corner points of triangle' /corner1*corner3/
  36     pm 'plusmin -- used in linearizing abs()' /'+','-'/
  37  ;
  38   
  39  * shorthands to make our area calculation easier
  40  singleton sets
  41     x1(k,c) /'corner1'.'x'/
  42     x2(k,c) /'corner2'.'x'/
  43     x3(k,c) /'corner3'.'x'/
  44     y1(k,c) /'corner1'.'y'/
  45     y2(k,c) /'corner2'.'y'/
  46     y3(k,c) /'corner3'.'y'/
  47  ;
  48   
  49   
  50  variable
  51     t(k,c)  'triangle'
  52     z       'objective'
  53  ;
  54   
  55  positive variable
  56     area(pm)     'area (using variable splitting)'
  57     lambda(i,k)  'barycentric coordinates'
  58  ;
  59   
  60  equations
  61     calcArea         'calculate area given its three corner points'
  62     calcLambda(i,c)  'solve for barycentric coordinates'
  63     sumLambda(i)     'lambdas need to add up to one'
  64     obj              'objective'
  65     order            'order corner points by their x coordinate'
  66  ;
  67   
  68  calcArea..         area('+')-area('-') =e= 0.5*[t(x1)*(t(y2)-t(y3)) + t(x2)*(t(y3)-t(y1)) + t(x3)*(t(y1)-t(y2))];
  69  calcLambda(i,c)..  p(i,c) =e= sum(k, lambda(i,k)*t(k,c));
  70  sumLambda(i)..     sum(k, lambda(i,k)) =e= 1;
  71  obj..              z =e= sum(pm,area(pm));
  72  order(k-1)..       t(k,'x') =g= t(k-1,'x');
  73   
  74   
  75  * some reasonable bounds
  76  t.lo(k,c) = -1000;
  77  t.up(k,c) = +1000;
  78   
  79  model m1 /all/;
  80  solve m1 minimizing z using nlp;
  81   
  82  *---------------------------------------------------------------------
  83  * reporting
  84  *---------------------------------------------------------------------
  85   
  86  display p,t.l,area.l,lambda.l;


