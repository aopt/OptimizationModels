G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
       Implementation of Dijkstra's algorithm for the shortest path problem.
       
       From: https://en.wikipedia.org/wiki/Dijkstra%27s_algorithm
       
       
        1. Dijkstra's shortest path algorithm implemented in GAMS
        2. Dijkstra's shortest path algorithm implemented in Python
        3. Shortest path as (primal) LP (single destination)
        4. Dual LP, single destination
        5. Primal LP, all destinations
        6. Dual LP, all destinations
        7. Visualization of network and shortest path
        
  17   
  18   
  19  *-----------------------------------------------------
  20  * set up network
  21  *-----------------------------------------------------
  22   
  23  Sets
  24     i 'nodes' /node1*node50/
  25     c 'coordinates' /x,y/
  26     a(i,i) 'arcs of sparse network'
  27  ;
  28  alias (i,j,v);
  29   
  30  Parameters
  31     point(i,c) 'location of points'
  32     cost(i,j) 'random costs (lengths)'
  33     d(i,j) 'distances'
  34  ;
  35   
  36  point(i,c) = uniform(0,100);
  37  d(i,j) = sqrt(sum(c,sqr(point(i,c)-point(j,c))));
  38  scalar dmin;
  39  a(i,j)$(ord(i)<>ord(j) and d(i,j) < 50) = uniform(0,1)<0.25;
  40  cost(a) = d(a);
  41   
  42  singleton sets
  43     source(i) /node1/
  44     sink(i)   /node40/
  45  ;
  46  * sink is chosen so optimal path needs quite a few hops
  47   
  48  option a:0:0:7, cost:3:0:6;
  49  display$(card(i)<=50)
  50     "============== data ==============",
  51     i,source,sink,a,cost;
  52   
  53  parameter pointx(*,*);
  54  pointx(i,c) = point(i,c);
  55  pointx("min",c) = smin(i,point(i,c));
  56  pointx("max",c) = smax(i,point(i,c));
  57  display pointx;
  58   
  59   
  60  *=====================================================
  61  * 1.  Dijkstra GAMS algorithm
  62  *=====================================================
  63   
  64  *-----------------------------------------------------
  65  * data structures
  66  *-----------------------------------------------------
  67   
  68  sets
  69     prev(i,j) 'i is previous wrt j'
  70     Q(i)      'unvisited nodes'
  71  ;
  72  parameter dist(i) 'distance from source';
  73   
  74  * initialize
  75  Q(i) = yes;
  76  dist(i) = INF;
  77  dist(source) = 0;
  78   
  79   
  80  *-----------------------------------------------------
  81  * algorithm
  82  *-----------------------------------------------------
  83   
  84  scalar mindist;
  85  singleton set u(i);
  86  scalar alt;
  87   
  88  * if multiple assignments to singleton set,
  89  * only the last one will remain. This will
  90  * guarantee a singleton set will hold
  91  * 0 or 1 elements.
  92  option strictSingleton=0;
  93   
  94  while(card(Q)>0,
  95   
  96  * find node in Q with minimum distance from the source
  97     mindist = smin(q,dist(q));
  98     u(Q) = dist(Q)=mindist;
  99   
 100  * remove u from Q
 101     Q(u) = no;
 102   
 103  * loop over neighbors of u in Q
 104     loop(a(u,v)$Q(v),
 105        alt = dist(u) + cost(a);
 106        if(alt < dist(v),
 107           dist(v) = alt;
 108           prev(i,v) = no;
 109           prev(u,v) = yes;
 110        );
 111     );
 112  );
 113   
 114  option prev:0:0:7,dist:3:0:6;
 115  display
 116     "============== Dijkstra (GAMS) ==============",
 117     prev,dist;
 118  parameter results(*,*);
 119  results('Dijkstra (GAMS)','obj') = dist(sink);
 120  results('Dijkstra (GAMS)','sumobj') = sum(i,dist(i));
 121  display results;
 122   
 123  *-----------------------------------------------------
 124  * recover path
 125  * more complicated than the algorithm itself
 126  *-----------------------------------------------------
 127   
 128  set s /step1*step25/;
 129  singleton sets
 130     n(i) 'current node'
 131     p(i) 'previous node'
 132  ;
 133  parameter steps(s,i,j) 'cost for each step taken';
 134  option steps:3:0:1;
 135  steps(s,i,j) = 0;
 136   
 137  * initialization
 138  n(sink) = yes;
 139   
 140  * loop from last (sink) to first (source)
 141  repeat
 142     p(i) = no;
 143  * loop finds v given n
 144  * body of loop is executed 0 or 1 times
 145     loop(prev(v,n),
 146  * make room by moving all steps one down
 147        steps(s,i,j) = steps(s-1,i,j);
 148        steps('step1',prev) = cost(prev)+EPS;
 149        p(v) = yes;
 150     );
 151     n(i) = p(i);
 152  until card(n)=0;
 153   
 154  display steps;
 155   
 156  *-----------------------------------------------------
 157  * save path for visualization
 158  *-----------------------------------------------------
 159   
 160  set plotpath(i,j) 'for visualization';
 161  plotpath(i,j) = sum(s,steps(s,i,j));
 162  display plotpath;
 163   
 164   
 165  *=====================================================
 166  * 2.  Dijkstra Python algorithm
 167  *=====================================================
 168   
 169  parameters
 170     psteps(s,i,j) 'results from python code'
 171     pobj   'objective function value'
 172     sumobj 'sum of all distances'
 173  ;
 174   
 175  * just in case we have arcs with costs=0
 176  cost(a)$(cost(a)=0) = eps;
 177   
 178  embeddedCode Python:
 179   
 180  #-- import GAMS data
 181  import gams.transfer as gt
 182   
 183  nodes=list(gams.get('i'))
 184  print(f"i={nodes}")
 185   
 186  source=list(gams.get('source'))[0]
 187  print(f"source={source}")
 188   
 189  sink=list(gams.get('sink'))[0]
 190  print(f"sink={sink}")
 191   
 192  m = gt.Container(gams.db)
 193  dfcost = m.data["cost"].records
 194  print(dfcost)
 195   
 196  #-- data structures
 197  successors = {v:[] for v in nodes}
 198  cost = {}
 199  for index, row in dfcost.iterrows():
 200      u = row['i']
 201      v = row['j']
 202      successors[u].append(v)
 203      cost[(u,v)] = row['value']    
 204   
 205  #print(successors)
 206   
 207  #-- initialization
 208  Q=set(nodes)
 209  inf=float('inf')
 210  dist = {v:inf for v in nodes}
 211  dist[source] = 0
 212  prev = {v:None for v in nodes}
 213   
 214  #-- run algorithm
 215  while len(Q)>0:
 216      u = min(Q, key=lambda n:dist[n])
 217      Q.remove(u)
 218      
 219      for v in successors[u]:
 220          if v in Q:
 221             alt = dist[u] + cost[(u,v)]
 222             if alt < dist[v]:
 223                dist[v] = alt
 224                prev[v] = u
 225                
 226  print(f"optimal total cost: {dist[sink]}")
 227   
 228  #-- recover path
 229  path = []
 230  u = sink
 231  while u is not None:
 232     path.insert(0,u)
 233     u = prev[u]
 234     
 235  print(path)
 236   
 237  #-- move things back to GAMS
 238   
 239  stepsdata = [(f"step{i}",path[i-1],path[i],cost[(path[i-1],path[i])]) for i in range(1,len(path))]
 240  gams.set("psteps",stepsdata)
 241  gams.set("pobj",[dist[sink]])
 242  sumobj = sum([dist[v] for v in nodes])
 243  gams.set("sumobj",[sumobj])
 244   
 245  endEmbeddedCode psteps,pobj,sumobj
 246   
 247   
 248   
 249  option psteps:3:0:1;
 250  display
 251     "============== Dijkstra (Python) ==============",
 252     psteps,pobj;
 253   
 254  results('Dijkstra (Python)','obj') = pobj;
 255  results('Dijkstra (Python)','sumobj') = sumobj;
 256  display results;
 257   
 258   
 259  *=====================================================
 260  * 3.  LP Model: single source, single destination
 261  *=====================================================
 262   
 263  parameters supply(i), demand(i);
 264  supply(source) = 1;
 265  demand(sink) = 1;
 266   
 267  positive variables x(i,j) 'flow along i->j';
 268  variable z 'objective';
 269   
 270  equations
 271     obj 'objective'
 272     nodebal(i) 'node balance'
 273  ;
 274   
 275  obj.. z =e= sum((i,j),cost(i,j)*x(i,j));
 276  nodebal(i).. sum(a(j,i),x(a)) + supply(i) =e= sum(a(i,j),x(a)) + demand(i);
 277   
 278  model m /all/;
 279  solve m minimizing z using lp;
 280   
 281  display
 282     "============== LP model ==============",
 283     x.l,z.l;
 284  results('LP','obj') = z.l;
 285  display results;
 286   
 287   
 288  *-----------------------------------------------------
 289  * recover path
 290  *-----------------------------------------------------
 291   
 292  parameters
 293     lpsteps(s,i,j) 'results from LP model'
 294  ;
 295  singleton set next(i) 'next node';
 296   
 297  n(i) = source(i);
 298  loop(s$card(n),
 299       next(i) = x.l(n,i)>0.5;
 300       lpsteps(s,n,next) = cost(n,next);
 301       n(i) = next(i);
 302  );
 303  option lpsteps:3:0:1;
 304  display lpsteps;
 305   
 306  *=====================================================
 307  * 4. Dual LP, single destination
 308  *=====================================================
 309   
 310  free variable pi(i) 'dual variables';
 311   
 312  Equations
 313     dualObj   'objective of dual LP'
 314     dualCons  'constraint of dual LP'
 315  ;
 316   
 317  dualObj.. z =e= sum(i, (supply(i)-demand(i))*pi(i));
 318  dualCons(a(i,j)).. pi(i) - pi(j) =l= cost(i,j);
 319   
 320  model dual /dualObj,dualCons/;
 321  solve dual maximizing z using lp;
 322   
 323  * the optimal flows are the dual values of equation dualCons
 324  * get rid of EPS values
 325  dualCons.m(a)$(dualCons.m(a)=EPS) = 0;
 326   
 327  display
 328     "============== Dual LP model ==============",
 329     pi.l,dualCons.m;
 330  results('dualLP','obj') = z.l
 331  display results;
 332  ;
 333   
 334   
 335  *=====================================================
 336  * 5.  LP Model: single source, multiple destinations
 337  *
 338  * Dijkstra find all shortest paths from a single source.
 339  * We adapt the LP model to do the same.
 340  *=====================================================
 341   
 342   
 343  * just change supply and demand:
 344  *demand(i) = 1;
 345  *demand(source) = 0;
 346  *supply(source) = card(i)-1;
 347   
 348  * or even simpler:
 349  demand(i) = 1;
 350  supply(source) = card(i);
 351   
 352  solve m minimizing z using lp;
 353  display    "============== LP model, all destinations ==============",
 354      z.l,x.l,nodebal.m;
 355   
 356  results('LP','sumobj') = z.l;
 357  display results;
 358   
 359   
 360  * now we need to move backwards from the destination node
 361   
 362  * initialization
 363  steps(s,i,j) = 0;
 364  prev(i,j) = x.l(i,j)>0.5;
 365  n(sink) = yes;
 366   
 367  * loop from last (sink) to first (source)
 368  repeat
 369     p(i) = no;
 370  * loop finds v given n
 371  * body of loop is executed 0 or 1 times
 372     loop(prev(v,n),
 373  * make room by moving all steps one down
 374        steps(s,i,j) = steps(s-1,i,j);
 375        steps('step1',prev) = cost(prev);
 376        p(v) = yes;
 377     );
 378     n(i) = p(i);
 379  until card(n)=0;
 380   
 381  display steps;
 382   
 383   
 384  *=====================================================
 385  * 6.  Dual LP Model: single source, multiple destinations
 386  *=====================================================
 387   
 388  solve dual maximizing z using lp;
 389  results('dualLP','sumobj') = z.l;
 390  display results;
 391   
 392   
 393  *=====================================================
 394  * 7.  Visualization
 395  *=====================================================
 396   
 397   
 398  *-----------------------------------------------------------
 399  * Plot network using put statement
 400  * We generate some JavaScript code to hold the data
 401  * For documentation on plotting library, see:
 402  * https://js.cytoscape.org/
 403  *-----------------------------------------------------------
 404   
 407   
 408  file fln /networkdata.js/;
 409  put fln;
 410  put 'networkdata=['/;
 411  loop(i,
 412      put$(ord(i)>1) ",";
 413      put "{data:{id:",(ord(i)):0:0;
 414      put$(supply(i)=0 and demand(i)=0) ",color:'black'";
 415      put$(supply(i)>0) ",color:'blue'";
 416      put$(demand(i)>0) ",color:'green'";
 417      put$(supply(i)=0 and demand(i)=0) ",size:1";
 418      put$(supply(i)>0 or demand(i)>0) ",size:2";
 419      put "},position:{x:",point(i,'x'):0:2,",y:",point(i,'y'):0:2,"}}"/;
 420  );
 421  loop(a(i,j),
 422      put ",{data:{id:'",(ord(i)):0:0,'-',(ord(j)):0:0,"',";
 423      put "source:",(ord(i)):0:0,",target:",(ord(j)):0:0;
 424      put$(plotpath(a)) ",color:'red',width:0.2";
 425      put$(not plotpath(a)) ",color:'grey',width:0.1";
 426      put "}}"/;
 427  );
 428  put '];'/;
 429   
 430  put "table='<h4>GAMS Shortest Path</h4>"
 431      "Number of nodes: ",(card(i)):0:0,"<br>"
 432      "Number of arcs: ",(card(a)):0:0,"<br><br>"
 433      "<table><tr><th>From</th><th>To</th><th>cost</th></tr>'+"/;
 434  loop((s,i,j)$lpsteps(s,i,j),
 435     put "'<tr><td>",i.tl:0,"</td><td>",j.tl:0,"</td><td><pre>",cost(i,j):10:3,"</pre></td></tr>'+"/;
 436  );
 437  put "'<tr><td colspan=2>Total cost</td><td><pre>",z.l:10:3,"</pre></td></tr>'+"/;
 438   
 439  put "'</table><br>';";
 440  putclose;
