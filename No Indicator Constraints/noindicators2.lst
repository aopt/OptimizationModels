      l 1','mip','indic','obj')    = m1.objval; results('model 1','mip','indic','time')   = m1.resusd; results('model 1','mip','in
      dic','nodes')  = m1.nodusd; results('model 1','mip','indic','status')$(m1.solvestat=3)  = timelimit;
 181   results('model 2','minlp','left','vars')   = m2.numvar; results('model 2','minlp','left','equs')   = m2.numequ; results('mo
      del 2','minlp','left','obj')    = m2.objval; results('model 2','minlp','left','time')   = m2.resusd; results('model 2','minl
      p','left','nodes')  = m2.nodusd; results('model 2','minlp','left','status')$(m2.solvestat=3)  = timelimit;
 182   results('model 2a','minlp','left v2','vars')   = m2a.numvar; results('model 2a','minlp','left v2','equs')   = m2a.numequ; r
      esults('model 2a','minlp','left v2','obj')    = m2a.objval; results('model 2a','minlp','left v2','time')   = m2a.resusd; res
      ults('model 2a','minlp','left v2','nodes')  = m2a.nodusd; results('model 2a','minlp','left v2','status')$(m2a.solvestat=3)  
      = timelimit;
 183   results('model 3','minlp','both','vars')   = m3.numvar; results('model 3','minlp','both','equs')   = m3.numequ; results('mo
      del 3','minlp','both','obj')    = m3.objval; results('model 3','minlp','both','time')   = m3.resusd; results('model 3','minl
      p','both','nodes')  = m3.nodusd; results('model 3','minlp','both','status')$(m3.solvestat=3)  = timelimit;
 184   results('model 3a','minlp','both v2','vars')   = m3a.numvar; results('model 3a','minlp','both v2','equs')   = m3a.numequ; r
