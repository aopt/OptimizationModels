G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Find dispersed k out-of n locations by maximizing the minimum distance.
         
         Experiment with alternatives for indicator constraints.
       
         See:
         https://yetanothermathprogrammingconsultant.blogspot.com/2026/06/minlp-instead-of-indicator-constraints.html
       
  11   
  12   
  13  option seed = 12345;
  14  option minlp=baron,mip=cplex;
  15   
  16  * select k out of n points
  17  *$set n 50
  18  *$set k 10
  21   
  22  * 0: no plot
  24   
  25  *-----------------------------------------------------------------
  26  * data
  27  *-----------------------------------------------------------------
  28   
  29  Scalars
  30    n 'total number of locations' /100/
  31    k 'number of locations to choose' /15/
  32  ;
  33   
  34  set
  35      i 'possibe locations' /location1*location100/
  36      c 'coordinates' /x,y/
  37  ;
  38   
  39  parameter
  40      p(i,c) 'possible locations'
  41  ;
  42  p(i,c) = uniform(0,100);
  43  display p;
  44   
  45  *-----------------------------------------------------------------
  46  * derived data: distances
  47  *-----------------------------------------------------------------
  48   
  49  alias(i,j);
  50  set lt(i,j) 'upper triangular part';
  51  lt(i,j) = ord(i)<ord(j);
  52   
  53  parameter dist(i,j) 'distance between locations';
  54  dist(lt(i,j)) = sqrt(sum(c, sqr(p(i,c)-p(j,c))));
  55  display$(n<=50) dist;
  56   
  57  scalars
  58     mind 'minimum distance'
  59     maxd 'maximum distance'
  60  ;
  61  mind = smin(lt(i,j),dist(i,j));
  62  maxd = smax(lt(i,j),dist(i,j));
  63  display mind,maxd;
  64   
  65  *-----------------------------------------------------------------
  66  * models
  67  *-----------------------------------------------------------------
  68   
  69  parameter M(i,j) 'big-M';
  70  M(lt(i,j)) = maxd-dist(i,j);
  71   
  72  set s1 'for sos1' /sos1-1,sos1-2/;
  73   
  74  binary variables
  75      s(i)   'location is selected'
  76      t(i,j) 's(i)*s(j)'
  77  ;
  78  positive variable tr(i,j) 'relaxed version of t(i,j)';
  79  tr.up(i,j) = 1;
  80   
  81  variable z 'objective: max min dist';
  82   
  83  sos1 variable slack(i,j,s1);
  84   
  85   
  86  Equations
  87      count     'select n locations'
  88      mindist1  'using indicator constraints'
  89      mindist2  'min distance (bound): MINLP formulation of indicator constraint'
  90      mindist2a 'min distance (bound): MINLP formulation of indicator constraint'
  91      mindist3  'min distance (bound): MINLP formulation of indicator constraint'
  92      mindist3a 'min distance (bound): MINLP formulation of indicator constraint'
  93      mindist4  'min distance (bound): Linearized big-M formulation'
  94      tbound    's(i)=s(j)=1 => t(i,j)=1'
  95      tbounda   's(i)=s(j)=1 => tr(i,j)=1'
  96      sosbound  "s(i)=s(j)=1 => slack(i,j,'sos1-1')=1"
  97      sos_1
  98      sos_2
  99  ;
 100   
 101  mindist1(lt(i,j))..  z =l= dist(i,j);
 102  mindist2(lt(i,j))..  z*s(i)*s(j) =l= dist(i,j);
 103  mindist2a(lt(i,j)).. z*tr(i,j) =l= dist(i,j);
 104  mindist3(lt(i,j))..  z*s(i)*s(j) =l= dist(i,j)*s(i)*s(j);
 105  mindist3a(lt(i,j))..  z*tr(i,j) =l= dist(i,j)*tr(i,j);
 106  mindist4(lt(i,j))..  z =l= dist(i,j) + M(i,j)*(1-s(i)) + M(i,j)*(1-s(j));
 107  tbound(lt(i,j))..    t(i,j) =g= s(i)+s(j)-1;
 108  tbounda(lt(i,j))..   tr(i,j) =g= s(i)+s(j)-1;
 109  count.. sum(i, s(i)) =e= k;
 110   
 111  slack.up(lt,'sos1-1') = 1;
 112  sos_1(lt(i,j)).. slack(i,j,'sos1-1') =g= s(i)+s(j)-1;
 113  sos_2(lt(i,j)).. z =l= dist(i,j) + slack(i,j,'sos1-2');
 114   
 115  * gams indicator constraints are nuts
 119   
 120  * bounds for the benefit of Baron
 121  z.lo = 0;
 122  z.up = maxd;
 123   
 124  model m1 /mindist1, tbound, count/;
 125  model m2 /mindist2, count/;
 126  model m2a /mindist2a, tbounda, count/;
 127  model m3 /mindist3, count/;
 128  model m3a /mindist3a, tbounda, count/;
 129  model m4 /mindist4, count/;
 130  model m5 /sos_1,sos_2, count/;
 131   
 132  option reslim = 1000;
 133   
 134  m1.optfile=1;
 135  solve m1 maximizing z using mip;
 136  s.l(i) = 0;
 137  solve m2 maximizing z using minlp;
 138  s.l(i) = 0;
 139  solve m2a maximizing z using minlp;
 140  s.l(i) = 0;
 141  solve m3 maximizing z using minlp;
 142  s.l(i) = 0;
 143  solve m3a maximizing z using minlp;
 144  s.l(i) = 0;
 145  solve m4 maximizing z using mip;
 146  s.l(i) = 0;
 147  solve m5 maximizing z using mip;
 148   
 149  *-----------------------------------------------------------------
 150  * reporting
 151  *-----------------------------------------------------------------
 152   
 153  parameter d(i,j) 'distance of used points';
 154  d(lt(i,j))$(s.l(i)>0.5 and s.l(j)>0.5) = dist(i,j);
 155  display z.l,s.l,d;
 156   
 157  scalar xmind 'z.l is not exact';
 158  xmind = smin((i,j)$d(i,j),d(i,j));
 159   
 160  set mindist_id(i,j) 'min distance nodes';
 161  mindist_id(i,j)$d(i,j) = d(i,j) = xmind;
 162  display mindist_id;
 163   
 164  parameter results,size;
 165  size('n') = n;
 166  size('k') = k;
 167   
 168   
 169  acronym TimeLimit;
 170   
 171  $macro modelresult(name1,type,descr,modelid) \
 172     results(name1,type,descr,'vars')   = modelid.numvar; \
 173     results(name1,type,descr,'equs')   = modelid.numequ; \
 174     results(name1,type,descr,'obj')    = modelid.objval; \
 175     results(name1,type,descr,'time')   = modelid.resusd; \
 176     results(name1,type,descr,'nodes')  = modelid.nodusd; \
 177     results(name1,type,descr,'status')$(modelid.solvestat=3)  = timelimit;
 178   
