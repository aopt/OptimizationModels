GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 06/02/26 14:57:53 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Find dispersed k out-of n locations by maximizing the minimum distance.
         
         Experiment with alternatives for indicator constraints.
       
         See:
         https://yetanothermathprogrammingconsultant.blogspot.com/2026/06/minlp-instead-of-indicator-constraints.html
       
  11   
  12   
  13  option seed = 12345;
  14  option minlp=baron,mip=cplex;
  15   
  16  * select k out of n points
  19   
  20  * 0: no plot
  22   
  23  *-----------------------------------------------------------------
  24  * data
  25  *-----------------------------------------------------------------
  26   
  27  Scalars
  28    n 'total number of locations' /50/
  29    k 'number of locations to choose' /10/
  30  ;
  31   
  32  set
  33      i 'possibe locations' /location1*location50/
  34      c 'coordinates' /x,y/
  35  ;
  36   
  37  parameter
  38      p(i,c) 'possible locations'
  39  ;
  40  p(i,c) = uniform(0,100);
  41  display p;
  42   
  43  *-----------------------------------------------------------------
  44  * derived data: distances
  45  *-----------------------------------------------------------------
  46   
  47  alias(i,j);
  48  set lt(i,j) 'upper triangular part';
  49  lt(i,j) = ord(i)<ord(j);
  50   
  51  parameter dist(i,j) 'distance between locations';
  52  dist(lt(i,j)) = sqrt(sum(c, sqr(p(i,c)-p(j,c))));
  53  display dist;
  54   
  55  scalars
  56     mind 'minimum distance'
  57     maxd 'maximum distance'
  58  ;
  59  mind = smin(lt(i,j),dist(i,j));
  60  maxd = smax(lt(i,j),dist(i,j));
  61  display mind,maxd;
  62   
  63  *-----------------------------------------------------------------
  64  * models
  65  *-----------------------------------------------------------------
  66   
  67  parameter M(i,j) 'big-M';
  68  M(lt(i,j)) = maxd-dist(i,j);
  69   
  70  binary variable s(i) 'location is selected';
  71  variable z 'objective: max min dist';
  72   
  73  Equations
  74      count     'select n locations'
  75      mindist1  'min distance (bound): MINLP formulation of indicator constraint'
  76      mindist2  'min distance (bound): MINLP formulation of indicator constraint'
  77      mindist3  'min distance (bound): Linearized big-M formulation'
  78  ;
  79   
  80  mindist1(lt(i,j))..  z*s(i)*s(j) =l= dist(i,j);
  81  mindist2(lt(i,j))..  z*s(i)*s(j) =l= dist(i,j)*s(i)*s(j);
  82  mindist3(lt(i,j))..  z =l= dist(i,j) + M(i,j)*(1-s(i)) + M(i,j)*(1-s(j));
  83  count.. sum(i, s(i)) =e= k;
  84   
  85  z.lo = 0;
  86  z.up = maxd;
  87   
  88  model m1 /mindist1, count/;
  89  model m2 /mindist2, count/;
  90  model m3 /mindist3, count/;
  91   
  92  solve m1 maximizing z using minlp;
  93  solve m2 maximizing z using minlp;
  94  solve m3 maximizing z using mip;
  95   
  96  parameter d(i,j) 'distance of used points';
  97  d(lt(i,j))$(s.l(i)>0.5 and s.l(j)>0.5) = dist(i,j);
  98  display z.l,s.l,d;
  99   
 100  scalar xmind 'z.l is not exact';
 101  xmind = smin((i,j)$d(i,j),d(i,j));
 102   
 103  set mindist_id(i,j) 'min distance nodes';
 104  mindist_id(i,j)$d(i,j) = d(i,j) = xmind;
 105  display mindist_id;
 106   
 107  parameter results,size;
 108  size('n') = n;
 109  size('k') = k;
 110  results('model 1','minlp','obj')=m1.objval;
 111  results('model 1','minlp','time')=m1.resusd;
 112  results('model 1','minlp','nodes')=m1.nodusd;
 113  results('model 2','minlp','obj')=m2.objval;
 114  results('model 2','minlp','time')=m2.resusd;
 115  results('model 2','minlp','nodes')=m2.nodusd;
 116  results('model 3','mip','obj')=m3.objval;
 117  results('model 3','mip','time')=m3.resusd;
 118  results('model 3','mip','nodes')=m3.nodusd;
 119  display size,results;
 120   
 121  *---------------------------------------------------------------------
 122  * visualization
 123  *---------------------------------------------------------------------
 126   
 128   
 129   
 130   
 131  file fdata /data.js/; put fdata;
 132   
 133  *  points
 134  put "px=["/;
 135  loop(i$(s.l(i)<0.5),
 136    put p(i,'x'):0:4,","/;
 137  );
 138  put "]"/;
 139  put "py=["/;
 140  loop(i$(s.l(i)<0.5),
 141    put p(i,'y'):0:4,","/;
 142  );
 143  put "]"/;
 144  put "sx=["/;
 145  loop(i$(s.l(i)>0.5),
 146    put p(i,'x'):0:4,","/;
 147  );
 148  put "]"/;
 149  put "sy=["/;
 150  loop(i$(s.l(i)>0.5),
 151    put p(i,'y'):0:4,","/;
 152  );
 153  put "]"/;
 154   
 252   
 253  executetool 'win32.ShellExecute "plot.html"';
 254   
 256   


