G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Solve smallest ellipse problem using an NLP solver
        Use same starting point as smallest circle problem
        
   7   
   8  option nlp = conopt;
   9   
  10  *----------------------------------------------------------------------
  11  * data
  12  *----------------------------------------------------------------------
  13   
  14  set
  15    i 'points' /point1*point50/
  16    c  'coordinates' /x,y/
  17    h(i) 'subset: convex hull'
  18  ;
  19   
  20  parameter p(i,c) 'points';
  21   
  22   
  51   
  52  display p,h;
  53   
  54  set j(i) 'used points';
  55  *j(i) = yes;
  56  j(h) = yes;
  57   
  58   
  59  *----------------------------------------------------------------------
  60  * initial circle
  61  *----------------------------------------------------------------------
  62   
  63  alias (c,cc);
  64  parameter
  65     ic(c) 'initial center'
  66     ir2   'squared initial radius'
  67  ;
  68   
  69  ic(c) = sum(j,p(j,c))/card(j);
  70  ir2 = smax(j,sum(c, sqr(p(j,c)-ic(c))));
  71  display ic,ir2;
  72   
  73  *----------------------------------------------------------------------
  74  * formulation 1
  75  * max det(A)
  76  * s.t. (p-c)'A(p-c) <= 1
  77  *----------------------------------------------------------------------
  78   
  79  variable z;
  80  positive variable a11,a22;
  81  variable a12, center(c), pc(i,c);
  82   
  83  * initial values A
  84  a11.l = 1/ir2;
  85  a22.l = 1/ir2;
  86  a12.l = 0;
  87  z.l = a11.l*a22.l-sqr(a12.l);
  88   
  89  * initial values center
  90  center.l(c) = ic(c);
  91  pc.l(j(i),c) = p(i,c) - center.l(c);
  92   
  93  Equations
  94     determinant 'det(A)'
  95     pminc(i,c)  'p(i)-c'
  96     pinside(i)  'point p is inside ellipse'
  97  ;
  98   
  99  determinant..  z =e= a11*a22-sqr(a12);
 100  pminc(j(i),c)..   pc(i,c) =e= p(i,c)-center(c);
 101  pinside(j(i))..   a11*sqr(pc(i,'x'))+a22*sqr(pc(i,'y'))+2*a12*pc(i,'x')*pc(i,'y') =l= 1;
 102   
 103  model m1 /all/;
 104  solve m1 maximizing z using nlp;
 105   
 106  display center.l,a11.l,a22.l,a12.l,z.l;
 107  scalar Area;
 108  Area = pi/sqrt(z.l);
 109  display Area;
 110   
 111  *----------------------------------------------------------------------
 112  * formulation 2
 113  * max det(A)
 114  * s.t. ||Ap+b|| <= 1
 115  *----------------------------------------------------------------------
 116   
 117  variable ap1(i),ap2(i);
 118  variable b(c);
 119   
 120  * initial values A
 121  a11.l = 1/sqrt(ir2);
 122  a22.l = 1/sqrt(ir2);
 123  a12.l = 0;
 124  z.l = a11.l*a22.l-sqr(a12.l);
 125   
 126  * initial values b = -A*center
 127  b.l('x') = -a11.l*ic('x')-a12.l*ic('y');
 128  b.l('y') = -a12.l*ic('x')-a22.l*ic('y');
 129   
 130  * initial values ap = Ap+b
 131  ap1.l(j(i)) = a11.l*p(i,'x')+a12.l*p(i,'y') + b.l('x');
 132  ap2.l(j(i)) = a12.l*p(i,'x')+a22.l*p(i,'y') + b.l('y');
 133   
 134  equations
 135     defap1(i)   'first element of Ap+b'
 136     defap2(i)   'second element of Ap+b'
 137     pinside2(i)
 138  ;
 139   
 140   
 141  defap1(j(i))..     ap1(i) =e= a11*p(i,'x')+a12*p(i,'y') + b('x');
 142  defap2(j(i))..     ap2(i) =e= a12*p(i,'x')+a22*p(i,'y') + b('y');
 143  pinside2(j(i))..   sqr(ap1(i)) + sqr(ap2(i)) =l= 1;
 144   
 145  model m2 /determinant,defap1,defap2,pinside2/;
 146  solve m2 maximizing z using nlp;
 147   
 148  display a11.l,a22.l,a12.l,b.l,z.l;
 149  scalar Area;
 150  Area = pi/z.l;
 151  display Area;


