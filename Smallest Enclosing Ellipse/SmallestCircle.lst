GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 03/24/26 20:41:01 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given n data points, find the smallest circle that contains all the points. 
       
   6   
   7  option nlp=conopt, qcp=cplex;
   8   
   9  * 0: use all data points
  10  * 1: use only convex hull
  11  scalar convexhull /0/;
  12   
  13  *-----------------------------------------------------
  14  * data
  15  *-----------------------------------------------------
  16   
  17  set
  18     i 'data points' /point1*point100/
  19     k 'coordinates' /x,y/
  20  ;
  21   
  22  parameter p(i,k) 'data points';
  23  p(i,k) = uniform(0,100);
  24  display p;
  25   
  26  *-----------------------------------------------------
  27  * convex hull
  28  *-----------------------------------------------------
  29   
  30   
  31  set hull(i) 'convex hull';
  32   
  33  embeddedCode Python:
  34  import scipy as sp
  35  import numpy as np
  36  import gams.transfer as gt
  37   
  38  print(f"scipy version {sp.__version__}")
  39   
  40  i = list(gams.get("i"))
  41  p = gt.Container(gams.db)["p"].toDense()
  42  hull = sp.spatial.ConvexHull(p)
  43  h = [i[pt] for pt in hull.vertices]
  44  gams.set("hull",h)
  45  endEmbeddedCode hull 
  46   
  47  parameter numpoints(*) 'number of points';
  48  numpoints('data points') = card(i);
  49  numpoints('convex hull') = card(hull);
  50  display numpoints,hull;
  51   
  52   
  53   
  54  *-----------------------------------------------------
  55  * model 1: nlp model
  56  *-----------------------------------------------------
  57   
  58  set j(i) 'subset of points used in model';
  59   
  60  j(i)$(convexhull=0) = yes;
  61  j(hull)$(convexhull=1) = yes;
  62   
  63  variables
  64     c(k)   'center'
  65     r2     'squared radius'
  66  ;
  67   
  68  equation inside(i) 'point i is inside circle';
  69   
  70  inside(j).. sum(k, sqr(p(j,k)-c(k))) =l= r2;
  71   
  72  * (very good) initial point
  73  c.l(k) = sum(j,p(j,k))/card(i);
  74  r2.l = smax(j,sum(k, sqr(p(j,k)-c.l(k))));
  75   
  76  model m1 /inside/;
  77   
  78  *-----------------------------------------------------
  79  * solve and reporting
  80  *-----------------------------------------------------
  81   
  82  parameter results(*,*,*);
  83  results('c',k,'initial') = c.l(k);
  84  results('r','','initial') = sqrt(r2.l);
  85   
  86  solve m1 minimizing r2 using nlp;
  87   
  88  results('c',k,'nlp') = c.l(k);
  89  results('r','','nlp') = sqrt(r2.l);
  90  results('time','','nlp') = m1.resusd;
  91  results('iterations','','nlp') = m1.iterusd;
  92  display results;
  93   
  94  *-----------------------------------------------------
  95  * model 2: conic model
  96  *-----------------------------------------------------
  97   
  98  variable
  99    r 'radius'
 100    diff(i,k) 'p(i,k)-c(k)'
 101  ;
 102  r.lo = 0;
 103   
 104  positive variable
 105    s(i) 'needed for mosek'
 106  ;
 107   
 108  equations
 109     ediff(i,k) 'auxiliary constraint, needed for socp'
 110     es(i)       'needed for mosek'
 111     inside2(i)  'point i is inside circle'
 112  ;
 113   
 114  ediff(j,k)..   diff(j,k) =e= p(j,k)-c(k);
 115  es(j)..        r =e= s(j);
 116  inside2(j)..   sum(k, sqr(diff(j,k))) =l= sqr(s(j));
 117   
 118  model m2 /ediff,es,inside2/;
 119   
 120  *-----------------------------------------------------
 121  * solve and reporting
 122  *-----------------------------------------------------
 123   
 124  solve m2 minimizing r using qcp;
 125   
 126  results('c',k,'socp') = c.l(k);
 127  results('r','','socp') = r.l;
 128  results('time','','socp') = m2.resusd;
 129  results('iterations','','socp') = m2.iterusd;
 130  display results;
 131   
 132   
 133   
 134  *---------------------------------------------------------------------
 135  * visualization
 136  *---------------------------------------------------------------------
 137   
 140   
 141   
 142  parameter init(k), initr;
 143  init(k) = sum(j,p(j,k))/card(j);
 144  initr = sqrt(smax(j,sum(k, sqr(p(j,k)-init(k)))));
 145   
 146   
 147  file fdata /data.js/; put fdata;
 148   
 149  * points
 150  put "px=["; loop(j,put p(j,'x'):0:4,","); put "];"/;
 151  put "py=["; loop(j,put p(j,'y'):0:4,","); put "];"/;
 152  put "xa0=",(init('x')-initr):0:4,";"/;
 153  put "ya0=",(init('y')-initr):0:4,";"/;
 154  put "xa1=",(init('x')+initr):0:4,";"/;
 155  put "ya1=",(init('y')+initr):0:4,";"/;
 156  put "xb0=",(c.l('x')-r.l):0:4,";"/;
 157  put "yb0=",(c.l('y')-r.l):0:4,";"/;
 158  put "xb1=",(c.l('x')+r.l):0:4,";"/;
 159  put "yb1=",(c.l('y')+r.l):0:4,";"/;
 160   
 161   
 211   
 212  executetool 'win32.ShellExecute "plot.html"';
 213   
 214   


