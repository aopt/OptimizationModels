GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 04/24/26 22:39:14 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Given n circles or disks (with different radii), find the smallest
        enclosing circle.
        
        We use a NLP model and a SOCP model
       
   9   
  10   
  11  *---------------------------------------------------------------------
  12  * options
  13  *---------------------------------------------------------------------
  14   
  15  * 0: no plot
  16  * 1: produce html plot
  18   
  19  * 0: don't remove circles contained in another circle
  20  * 1: do remove them
  22   
  23  option nlp=conopt, qcp = cplex;
  24   
  25  *---------------------------------------------------------------------
  26  * data
  27  *---------------------------------------------------------------------
  28   
  29  sets
  30    i 'inner circles' /circle1*circle15/
  31    a 'attributes for storing results' /x,y,r/
  32    k(a) 'coordinate' /x,y/
  33  ;
  34   
  35  alias (i,j);
  36   
  37  Parameters
  38   circles(*,*)   'coordinates of center and radius'
  39  ;
  40   
  41  circles(i,k) = uniform(0,25);
  42  circles(i,'r') = uniform(1,7);
  43  display circles;
  44   
  45   
  46  *---------------------------------------------------------------------
  47  * preprocessing
  48  * remove circles inside another one
  49  *---------------------------------------------------------------------
  50  scalar d 'distance between centers';
  51   
  52  set ne(i,j) ' not the same';
  53  ne(i,j) = ord(i)<>ord(j);
  54   
  55  circles(i,'candrop')=0;
  56  loop(ne(i,j)$(circles(i,'r')<=circles(j,'r') and circles(i,'candrop')=0),
  57   
  58     d = sqrt(sum(k, sqr(circles(i,k)-circles(j,k))));
  59     circles(i,'candrop')$(d + circles(i,'r') <= circles(j,'r')) = 1;
  60   
  61  );
  62  display circles;
  63   
  64  set keep(i) 'circle is not dropped from data set';
  65  keep(i) = yes;
  66  keep(i)$0 = circles(i,'candrop')=0;
  67  display keep;
  68   
  69  *---------------------------------------------------------------------
  70  * NLP Model
  71  *---------------------------------------------------------------------
  72   
  73  variables
  74     c(k)   'center'
  75     r      'radius'
  76  ;
  77   
  78  r.lo = smax(keep(i),circles(i,'r'));
  79   
  80  *
  81  * initial point calculation
  82  *
  83  parameters
  84     dist(i) 'distance'
  85     init(a) 'initial values'
  86  ;
  87  init(k) = sum(keep(i),circles(i,k))/card(keep);
  88  dist(keep(i)) = sqrt(sum(k, sqr(init(k)-circles(i,k))));
  89  init('r') = smax(keep(i), dist(i) + circles(i,'r'));
  90  c.l(k) = init(k);
  91  r.l = init('r');
  92   
  93  Equations
  94     inside(i)
  95  ;
  96   
  97  inside(keep(i))..
  98    sum(k,sqr(c(k)-circles(i,k))) =l= sqr(r-circles(i,'r'));
  99   
 100  model m1 /all/;
 101  solve m1 minimizing r using nlp;
 102   
 103  parameter results(*,*);
 104  results('init',a) = init(a);
 105  results('NLP',k) = c.l(k);
 106  results('NLP','r') = r.l;
 107   
 108  display results;
 109   
 110  *---------------------------------------------------------------------
 111  * SOCP Model
 112  *---------------------------------------------------------------------
 113   
 114  variables
 115     diffc(i,k) 'difference between outer center and inner centers'
 116     diffr(i) 'difference between outer radius and inner radii'
 117  ;
 118  positive variable diffr;
 119   
 120  * no need for bound on r
 121  r.lo = -INF;
 122   
 123  Equations
 124     calcdiffc(i,k)
 125     calcdiffr(i)
 126     inside2(i)
 127  ;
 128   
 129  calcdiffc(keep(i),k).. diffc(i,k) =e= c(k)-circles(i,k);
 130  calcdiffr(keep(i))..   diffr(i) =e= r-circles(i,'r');
 131  inside2(keep(i))..     sum(k,sqr(diffc(i,k))) =l= sqr(diffr(i));
 132   
 133  model m2 /all-m1/;
 134  solve m2 minimizing r using qcp;
 135   
 136  results('SOCP',k) = c.l(k);
 137  results('SOCP','r') = r.l;
 138   
 139  display results;
 140   
 141   
 142  *---------------------------------------------------------------------
 143  * visualization
 144  *---------------------------------------------------------------------
 145   
 148   
 149   
 151   
 152  file fdata /data.js/; put fdata;
 153   
 154   
 155  * plot first not dropped (large) circles
 156  * then plot dropped circles.
 157  set
 158     sd /keep,drop,outer/
 159     sdi(sd,*)
 160  ;
 161  sdi('keep',i)$(not circles(i,'candrop')) = yes;
 162  sdi('drop',i)$circles(i,'candrop') = yes;
 163  sdi('outer','optimal') = yes;
 164  sdi('outer','initial') = yes;
 165   
 166  circles('initial','r') = init('r');
 167  circles('initial',k) = init(k);
 168  circles('optimal','r') = r.l;
 169  circles('optimal',k) = c.l(k);
 170  display sdi,circles;
 171   
 172  Scalars
 173     firstred /1/
 174     firstblue /1/
 175  ;
 176   
 177  alias (*,item);
 178   
 179  * circles
 180  put "circles = ["/;
 181  loop(sdi(sd,item),
 182    put " {"/;
 183    put "   type:'circle',"/;
 184    put "   xref:'x',"/;
 185    put "   yref:'y',"/;
 186    put "   x0:",(circles(item,'x')-circles(item,'r')):0:4,","/;
 187    put "   y0:",(circles(item,'y')-circles(item,'r')):0:4,","/;
 188    put "   x1:",(circles(item,'x')+circles(item,'r')):0:4,","/;
 189    put "   y1:",(circles(item,'y')+circles(item,'r')):0:4,","/;
 190    if (sameas(item,'optimal'),
 191       put "   line:{color:'Black'},"/;
 192       put "   name:'optimal solution',"/;
 193       put "   showlegend:true,"/;
 194    elseif sameas(item,'initial'),
 195       put "   line:{color:'Grey'},"/;
 196       put "   name:'initial solution',"/;
 197       put "   showlegend:true,"/;
 198    elseif circles(item,'candrop'),
 199       put "   line:{color:'Red'},"/;
 200       put "   fillcolor:'Pink',"/;
 201       put$firstred "   name:'dropped',"/;
 202       put$firstred "   showlegend:true,"/;
 203       firstred = 0;
 204    else
 205       put "   line:{color:'Blue'},"/;
 206       put "   fillcolor:'LightSkyBlue',"/;
 207       put$firstblue "   name:'data',"/;
 208       put$firstblue "   showlegend:true,"/;
 209       firstblue = 0;
 210    );
 211    put "   opacity:0.5,"/;
 212    put " },"/;
 213  );
 214  put "];"/;
 215   
 216  scalars xmin,xmax,ymin,ymax,range0,range1;
 217  xmin = min(init('x')-init('r'),c.l('x')-r.l);
 218  xmax = max(init('x')+init('r'),c.l('x')+r.l);
 219  ymin = min(init('y')-init('r'),c.l('y')-r.l);
 220  ymax = max(init('y')+init('r'),c.l('y')+r.l);
 221  range0 = floor(min(xmin,ymin));
 222  range1 = ceil(max(xmax,ymax));
 223   
 224  put "range0=",range0:0:4,";"/;
 225  put "range1=",range1:0:4,";"/;
 226   
 227  putclose;
 228   
 251   
 252  executetool 'win32.ShellExecute "plot.html"';
 253   
 255   


