G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi with 4 pegs
         MIP model   
         
   7   
   8  *-----------------------------------------------------------------------------------
   9  * size of problem
  10  *-----------------------------------------------------------------------------------
  11   
  14   
  15  *-----------------------------------------------------------------------------------
  16  * data
  17  *-----------------------------------------------------------------------------------
  18   
  19  * max number of moves
  21   
  22  sets
  23     dummy 'for ordering' /initial/
  24     peg /pegA,pegB,pegC,pegD/
  25     disk  /disk1*disk4/
  26     t 'moves or timesteps' /t1*t25/
  27  ;
  28  display peg,disk,t;
  29   
  30  alias (peg,peg1,peg2);
  31   
  32  Parameters
  33      n 'number of disks' /4/
  34      size(disk) 'size of each disk: 1..n'
  35      maxsize 'maximum size of disk'
  36  ;
  37   
  38  Sets
  39    initial(disk,peg) 'initial inventory (state)' / (disk1*disk4).pegA /
  40    final(disk,peg) 'final inventory (state)'     / (disk1*disk4).pegB /
  41  ;
  42   
  43  size(disk) = ord(disk);
  44  maxsize = smax(disk,size(disk));
  45   
  46  display n,size,maxsize,initial,final;
  47   
  48   
  49  *-----------------------------------------------------------------------------------
  50  * MIP model
  51  *-----------------------------------------------------------------------------------
  52   
  53  binary variable
  54     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  55     inv(t,disk,peg)        'inventory after move'
  56     done(t)                'we are done'
  57  ;
  58  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
  59  smallestPrev.lo(t,peg) = 1;
  60  smallestPrev.up(t,peg) = maxsize;
  61   
  62  variable z 'obj';
  63   
  64  equations
  65     move1disk(t)           'move 1 disk (or 0 if done)'
  66     bndsmall(t,disk,peg)   'bound on smallest size of disk'
  67     smallfrom(t,peg)       'need to select smallest disk from source peg'
  68     smallto(t,peg)         'size restriction on destination peg'
  69     inventory(t,disk,peg)  'inventory balance'
  70     isdone(t)              'we are done'
  71     ordering(t)            'optional'
  72     assignment(t,disk)     'optional assignment constraint'
  73     obj                    'objective'
  74  ;
  75   
  76   
  77  * if done=1: move zero disks
  78  * if done=0: move exactly one disk
  79  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
  80   
  81  * don't move a disk from and to the same peg
  82  move.fx(t,disk,peg,peg) = 0;
  83   
  84  * we can only move the smallest disk
  85  parameter initsmallest(t,peg) 'smallest disk on each peg for initial configuration';
  86  initsmallest('t1',peg)$(sum(initial(disk,peg),1)=0) = maxsize;
  87  initsmallest('t1',peg)$(sum(initial(disk,peg),1)>0) = smin(initial(disk,peg),size(disk));
  88  display initsmallest;
  89   
  90  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
  91  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
  92  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
  93  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
  94   
  95  * inventory balance
  96  inventory(t,disk,peg)..
  97    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + 1$(initial(dis
      k,peg) and ord(t)=1);
  98   
  99  * done if we reached final state
 100  isdone(t).. sum((disk,peg)$final(disk,peg),inv(t,disk,peg)) =g= n*done(t);
 101   
 102  obj.. z =e= sum(t,done(t));
 103   
 104  * optional constraints
 105  ordering(t-1).. done(t) =g= done(t-1);
 106  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 107   
 108  * optional fixes
 109  set lastt(t);
 110  lastt(t) = ord(t)=card(t);
 111  done.fx(lastt) = 1;
 112  inv.fx(lastt,disk,peg) = final(disk,peg);
 113   
 114  model m /all/;
 115   
 116  *-----------------------------------------------------------------------------------
 117  * Solve
 118  *-----------------------------------------------------------------------------------
 119   
 120  solve m maximizing z using mip;
 121  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 122   
 123  * raw results
 124  option move:0:2:2;
 125  display smallestPrev.l,move.l,inv.l,done.l;
 126   
 127  *-----------------------------------------------------------------------------------
 128  * Reporting
 129  *-----------------------------------------------------------------------------------
 130   
 131  set sinv(*,disk,peg) 'include initial, and stop after done';
 132  sinv('initial',initial) = yes;
 133  loop(t,
 134     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 135     break$(done.l(t)>0.5);
 136  );
 137  display sinv;
 138   
 139  *-----------------------------------------------------------------------------------
 140  * Visualization
 141  *-----------------------------------------------------------------------------------
 142   
 143  abort.noError$(n>6 or 1=0) "skipping plot";
 144   
 146   
 147  file f /hanoiplots5.html/;
 148  put f;
 149   
 150  put '<!DOCTYPE html>'/;
 151  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 152  put '<h2>Towers of Hanoi Extension 2</h2>'/;
 153  put 'Number of disks: 4'/;
 154   
 155  put '<table border="1">'/;
 156  put '<tr>'/;
 157   
 159   
 160  alias (t1,*);
 161  parameter ndisks(*,peg) 'number of disks on each peg';
 162  ndisks(t1,peg) = sum(sinv(t1,disk,peg),1);
 163  display ndisks;
 164   
 165  scalar nd,x,y,w,k /0/;
 166  parameter pegpos(peg) 'x position of pegs';
 167  pegpos(peg) = 3*ord(peg);
 168   
 169   
 170  loop(t1$sum(sinv(t1,disk,peg),1),
 171     if (k=3,
 172         put "</tr><tr>"/;
 173         k = 0;
 174      );
 175     k = k + 1;
 176   
 177     put '<td style="text-align: center">'/;
 178     put '<svg height="100" width="300" viewBox="0 0 16 6">'/;
 179   
 180  * draw pegs
 181     loop(peg,
 182        put '<line x1="',(pegpos(peg)):0:0,'" y1="1" x2="',(pegpos(peg)):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>
      '/;
 183     );
 184  * draw disks
 185     loop(peg,
 186        nd = ndisks(t1,peg);
 187        loop(sinv(t1,disk,peg),
 188           y = n+1-nd+1;
 189           w = size(disk)*3/n;
 190           x = pegpos(peg)-0.5*w;
 191  *         display x,w,y;
 192           put '<rect x="',x:0:2,'" y="',y:0:2,'" height="1" width="',w:0:2,'" fill="lightblue"/>'/;
 193           put '<text x="',pegpos(peg):0:2,'" y="',(y+0.6):0:2,'" dominant-baseline="middle" text-anchor="middle" font-size="0
      .6">',(ord(disk)):0:0,'</text>'/;
 194           nd = nd-1;
 195        );
 196     );
 197     put '</svg><br>',t1.tl:0/;
 198     put '</td>'/;
 199  );
 200   
 201  put '</tr></table>';
 202  putclose;
 203  executetool 'win32.ShellExecute "hanoiplots5.html"';
 204   


