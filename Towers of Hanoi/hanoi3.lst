G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi
         
         This model finds a solution from a given starting configuration to
         a given final configuration.
         
         This can't be done with a standard recursive Towers of Hanoi algorithm
         
  11   
  12  *-----------------------------------------------------------------------------------
  13  * size of problem
  14  *-----------------------------------------------------------------------------------
  15   
  18   
  19  *-----------------------------------------------------------------------------------
  20  * data
  21  *-----------------------------------------------------------------------------------
  22   
  23  * max number of moves
  25   
  26  sets
  27     dummy 'for ordering' /initial/
  28     peg /pegA,pegB,pegC/
  29     disk  /disk1*disk4/
  30     t 'moves or timesteps' /t1*t25/
  31  ;
  32  display peg,disk,t;
  33   
  34  alias (peg,peg1,peg2);
  35   
  36  Parameters
  37      n 'number of disks' /4/
  38      size(disk) 'size of each disk: 1..n'
  39      maxsize 'maximum size of disk'
  40  ;
  41   
  42  Sets
  43    initial(disk,peg) 'initial inventory (state)' / (disk1,disk2).pegA, (disk3,disk4).pegB /
  44    final(disk,peg) 'final inventory (state)'     / (disk1,disk2).pegB, (disk3,disk4).pegC /
  45  ;
  46   
  47  abort$(card(t)<2**n-1) "increase size of set t";
  48   
  49  size(disk) = ord(disk);
  50  maxsize = smax(disk,size(disk));
  51   
  52  display n,size,maxsize,initial,final;
  53   
  54   
  55  *-----------------------------------------------------------------------------------
  56  * MIP model
  57  *-----------------------------------------------------------------------------------
  58   
  59  binary variable
  60     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  61     inv(t,disk,peg)        'inventory after move'
  62     done(t)                'we are done'
  63  ;
  64  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
  65  smallestPrev.lo(t,peg) = 1;
  66  smallestPrev.up(t,peg) = maxsize;
  67   
  68  variable z 'obj';
  69   
  70  equations
  71     move1disk(t)           'move 1 disk (or 0 if done)'
  72     bndsmall(t,disk,peg)   'bound on smallest size of disk'
  73     smallfrom(t,peg)       'need to select smallest disk from source peg'
  74     smallto(t,peg)         'size restriction on destination peg'
  75     inventory(t,disk,peg)  'inventory balance'
  76     isdone(t)              'we are done'
  77     ordering(t)            'optional'
  78     assignment(t,disk)     'optional assignment constraint'
  79     obj                    'objective'
  80  ;
  81   
  82   
  83  * if done=1: move zero disks
  84  * if done=0: move exactly one disk
  85  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
  86   
  87  * don't move a disk from and to the same peg
  88  move.fx(t,disk,peg,peg) = 0;
  89   
  90  * we can only move the smallest disk
  91  parameter initsmallest(t,peg) 'smallest disk on each peg for initial configuration';
  92  initsmallest('t1',peg)$(sum(initial(disk,peg),1)=0) = maxsize;
  93  initsmallest('t1',peg)$(sum(initial(disk,peg),1)>0) = smin(initial(disk,peg),size(disk));
  94  display initsmallest;
  95   
  96  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
  97  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
  98  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
  99  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
 100   
 101  * inventory balance
 102  inventory(t,disk,peg)..
 103    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + 1$(initial(dis
      k,peg) and ord(t)=1);
 104   
 105  * done if we reached final state
 106  isdone(t).. sum((disk,peg)$final(disk,peg),inv(t,disk,peg)) =g= n*done(t);
 107   
 108  obj.. z =e= sum(t,done(t));
 109   
 110  * optional constraints
 111  ordering(t-1).. done(t) =g= done(t-1);
 112  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 113   
 114  * optional fixes
 115  set lastt(t);
 116  lastt(t) = ord(t)=card(t);
 117  done.fx(lastt) = 1;
 118  inv.fx(lastt,disk,peg) = final(disk,peg);
 119   
 120  model m /all/;
 121   
 122  *-----------------------------------------------------------------------------------
 123  * Solve
 124  *-----------------------------------------------------------------------------------
 125   
 126  solve m maximizing z using mip;
 127  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 128   
 129  * raw results
 130  option move:0:2:2;
 131  display smallestPrev.l,move.l,inv.l,done.l;
 132   
 133  *-----------------------------------------------------------------------------------
 134  * Reporting
 135  *-----------------------------------------------------------------------------------
 136   
 137  set sinv(*,disk,peg) 'include initial, and stop after done';
 138  sinv('initial',initial) = yes;
 139  loop(t,
 140     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 141     break$(done.l(t)>0.5);
 142  );
 143  display sinv;
 144   
 145  *-----------------------------------------------------------------------------------
 146  * Visualization
 147  *-----------------------------------------------------------------------------------
 148   
 149  abort.noError$(n>6 or 1=0) "skipping plot";
 150   
 152   
 153  file f /hanoiplots3.html/;
 154  put f;
 155   
 156  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 157  put '<h2>Towers of Hanoi Extension 1</h2>'/;
 158  put 'Number of disks: 4'/;
 159   
 160  put '<table border="1">'/;
 161  put '<tr>'/;
 162   
 164   
 165  alias (t1,*);
 166  parameter ndisks(*,peg) 'number of disks on each peg';
 167  ndisks(t1,peg) = sum(sinv(t1,disk,peg),1);
 168  display ndisks;
 169   
 170  scalar nd,x,y,w,k /0/;
 171  parameter pegpos(peg) /pegA 3, pegB 6, pegC 9/;
 172   
 173  loop(t1$sum(sinv(t1,disk,peg),1),
 174     if (k=4,
 175         put "</tr><tr>"/;
 176         k = 0;
 177      );
 178     k = k + 1;
 179   
 180     put '<td style="text-align: center">'/;
 181     put '<svg height="100" width="300" viewBox="0 0 12 6">'/;
 182   
 183     loop(peg,
 184  * draw peg
 185        put '<line x1="',(pegpos(peg)):0:0,'" y1="1" x2="',(pegpos(peg)):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>
      '/;
 186  * draw disk
 187        nd = ndisks(t1,peg);
 188        loop(sinv(t1,disk,peg),
 189           y = n+1-nd+1;
 190           w = size(disk)*3/n;
 191           x = 3*ord(peg)-0.5*w;
 192  *         display x,w,y;
 193           put '<rect x="',x:4:2,'" y="',y:4:2,'" height="1" width="',w:4:2,'" fill="lightblue"/>'/;
 194           put '<text x="',(3*ord(peg)):0:0,'" y="',(y+0.6):3:1,'" dominant-baseline="middle" text-anchor="middle" font-size="
      0.6">',(ord(disk)):0:0,'</text>'/;
 195           nd = nd-1;
 196        );
 197     );
 198     put '</svg><br>',t1.tl:0/;
 199     put '</td>'/;
 200  );
 201   
 202  put '</tr></table>';
 203  putclose;
 204  executetool 'win32.ShellExecute "hanoiplots3.html"';


