G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
        Towers of Hanoi, network formulation
       
        
   7   
   8   
   9  *-----------------------------------------------------------------------------------
  10  * size of problem
  11  *-----------------------------------------------------------------------------------
  12   
  15   
  16  *-----------------------------------------------------------------------------------
  17  * nodes
  18  *-----------------------------------------------------------------------------------
  19   
  21   
  22  set
  23    node /node1*node81/
  24    disk /disk1*disk4/
  25    peg /pegA,pegB,PegC/
  26    nodes(node,disk,peg) / system.powersetRight /
  27  ;
  28   
  29  scalars
  30     n  'number of disks' /4/
  31     nn 'number of nodes' /81/
  32  ;
  33   
  34  display disk,peg,node,nodes;
  35   
  36  *-----------------------------------------------------------------------------------
  37  * arcs
  38  *-----------------------------------------------------------------------------------
  39   
  40  set arc(node,node);
  41   
  42  alias (node,node1,node2), (disk,disk1,disk2), (peg,peg1,peg2), (nodes,nodes1,nodes2);
  43   
  44  set smallest(node,disk,peg) 'smallest disk on peg';
  45  smallest(node,disk,peg) = smin(disk2$nodes(node,disk2,peg),ord(disk2)) = ord(disk);
  46  display smallest;
  47   
  48  parameter nodeVal(node,disk) 'peg number of (node,disk)';
  49  nodeVal(node,disk) = sum(nodes(node,disk,peg),ord(peg));
  50  display nodeVal;
  51   
  52  set nodediff1(node,node) '(node1,node2) combos with one difference';
  53  nodediff1(node1,node2) = sum(disk$(abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5),1)=1;
  54  display nodediff1;
  55   
  56  set nodeDiff1disk(node,node,disk) 'augment nodediff1 with disk id';
  57  nodeDiff1Disk(nodeDiff1(node1,node2),disk) = abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5;
  58  display nodeDiff1Disk;
  59   
  60  set diskMoved(node,node,disk) 'feasible moves';
  61  singleton set p1(peg),p2(peg);
  62  loop(nodeDiff1disk(node1,node2,disk),
  63     p1(peg) = nodeval(node1,disk)=ord(peg);
  64     p2(peg) = nodeval(node2,disk)=ord(peg);
  65     diskMoved(node1,node2,disk) = smallest(node1,disk,p1) and smallest(node2,disk,p2);
  66  );
  67  display diskMoved;
  68   
  69  arc(node1,node2) = sum(diskMoved(node1,node2,disk),1);
  70   
  71  * check
  72  scalar narcs 'number of directed arcs in Hanoi graph';
  73  narcs = 3*(power(3,n) - 1);
  74  abort$(card(arc)<>narcs) "number of arcs is incorrect";
  75   
  76  *----------------------------------------------------------------------
  77  * shortest path model
  78  *----------------------------------------------------------------------
  79   
  80  Parameters
  81     supply(node)
  82     demand(node)
  83  ;
  84  supply(node)$(sum(nodes(node,disk,'pegA'),1) = n) = 1;
  85  demand(node)$(sum(nodes(node,disk,'pegB'),1) = n) = 1;
  86   
  87  binary variable f(node,node) 'flow';
  88  variable z 'objective';
  89   
  90  equations
  91     flowbal(node) 'flow balance'
  92     obj           'objective'
  93  ;
  94   
  95  obj.. z =e= sum(arc,f(arc));
  96   
  97  flowbal(node1)..
  98     sum(arc(node2,node1),f(node2,node1)) + supply(node1) =e= sum(arc(node1,node2),f(node1,node2)) + demand(node1);
  99   
 100  model shortestpath /all/;
 101  solve shortestpath minimizing z using rmip;
 102  display f.l;
 103   
 104  *----------------------------------------------------------------------
 105  * reporting
 106  *----------------------------------------------------------------------
 107   
 108  set
 109      move/move1*move100/
 110      trace(move,node,node,disk,peg,peg)
 111  ;
 112   
 113  singleton sets
 114    cur(node) 'current node' /node1/
 115    next(node) 'next node'
 116  ;
 117   
 118  cur(node) = supply(node)>0;
 119   
 120  loop(move$card(cur),
 121   
 122      next(node) = f.l(cur,node)>0.5;
 123   
 124      loop(diskMoved(cur,next,disk),
 125          p1(peg) = nodeval(cur,disk)=ord(peg);
 126          p2(peg) = nodeval(next,disk)=ord(peg);
 127          trace(move,cur,next,disk,p1,p2) = yes;
 128      );
 129   
 130      cur(node) = next(node);
 131  );
 132   
 133  option trace:0:0:1;
 134  display trace;
 135   
 136  *-----------------------------------------------------------------------------------
 137  * Visualization
 138  *-----------------------------------------------------------------------------------
 139   
 140  abort.noError$(n>6 or 1=0) "skipping plot";
 141   
 143   
 144  file fname /hanoiplots2.html/;
 145  put fname;
 146   
 147  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 148  put '<h2>Towers of Hanoi Network Results</h2>'/;
 149  put 'Number of pegs: ',card(peg):0:0,'<br>'/;
 150  put 'Number of disks: 4 <br>'/;
 151  put 'Number of moves: ',z.l:0:0,'<br>'/;
 152  put 'Network has ',nn:0:0,' nodes and ',narcs:0:0,' arcs<br><br>';
 153   
 154  put '<table border="1">'/;
 155  put '<tr>'/;
 156   
 158   
 159  scalar nd,x,y,w,k /0/;
 160  parameter pegpos(peg) /pegA 3, pegB 6, pegC 9/;
 161   
 162  cur(node) = supply(node)>0;
 163   
 164  loop(move$card(cur),
 165     if (k=4,
 166         put "</tr><tr>"/;
 167         k = 0;
 168      );
 169     k = k + 1;
 170   
 171     put '<td style="text-align: center">'/;
 172     put '<svg height="100" width="300" viewBox="0 0 12 6">'/;
 173   
 174     loop(peg,
 175  * draw peg
 176        put '<line x1="',(pegpos(peg)):0:0,'" y1="1" x2="',(pegpos(peg)):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>
      '/;
 177  * draw disk
 178        nd = sum(nodes(cur,disk,peg),1);
 179        loop(nodes(cur,disk,peg),
 180           y = n+1-nd+1;
 181           w = ord(disk)*3/n;
 182           x = 3*ord(peg)-0.5*w;
 183  *         display x,w,y;
 184           put '<rect x="',x:4:2,'" y="',y:4:2,'" height="1" width="',w:4:2,'" fill="lightblue"/>'/;
 185           put '<text x="',(3*ord(peg)):0:0,'" y="',(y+0.6):3:1,'" dominant-baseline="middle" text-anchor="middle" font-size="
      0.6">',(ord(disk)):0:0,'</text>'/;
 186           nd = nd-1;
 187        );
 188     );
 189     put '</svg><br>',cur.tl:0/;
 190     put '</td>'/;
 191   
 192     next(node) = f.l(cur,node)>0.5;
 193     cur(node) = next(node);
 194   
 195  );
 196   
 197  put '</tr></table>';
 198  putclose;
 199  executetool 'win32.ShellExecute "hanoiplots2.html"';


