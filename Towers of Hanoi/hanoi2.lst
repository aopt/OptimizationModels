   4   
   5   
   6  *-----------------------------------------------------------------------------------
   7  * size of problem
   8  *-----------------------------------------------------------------------------------
   9   
  11   
  12  *-----------------------------------------------------------------------------------
  13  * nodes
  14  *-----------------------------------------------------------------------------------
  15   
  17   
  18  set
  19    node /node1*node27/
  20    disk /disk1*disk3/
  21    peg /pegA,pegB,PegC/
  22    nodes(node,disk,peg) / system.powersetRight /
  23  ;
  24   
  25  scalars
  26     n  'number of disks' /3/
  27     nn 'number of nodes' /27/
  28  ;
  29   
  30  display disk,peg,node,nodes;
  31   
  32  *-----------------------------------------------------------------------------------
  33  * arcs
  34  *-----------------------------------------------------------------------------------
  35   
  36  set arc(node,node);
  37   
  38  alias (node,node1,node2), (disk,disk1,disk2), (peg,peg1,peg2), (nodes,nodes1,nodes2);
  39   
  40  set smallest(node,disk,peg) 'smallest disk on peg';
  41  smallest(node,disk,peg) = smin(disk2$nodes(node,disk2,peg),ord(disk2)) = ord(disk);
  42  display smallest;
  43   
  44  parameter nodeVal(node,disk) 'peg number of (node,disk)';
  45  nodeVal(node,disk) = sum(nodes(node,disk,peg),ord(peg));
  46  display nodeVal;
  47   
  48  set nodediff1(node,node) '(node1,node2) combos with one difference';
  49  nodediff1(node1,node2) = sum(disk$(abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5),1)=1;
  50  display nodediff1;
  51   
  52  set nodeDiff1disk(node,node,disk) 'augment nodediff1 with disk id';
  53  nodeDiff1Disk(nodeDiff1(node1,node2),disk) = abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5;
  54  display nodeDiff1Disk;
  55   
  56  set diskMoved(node,node,disk) 'feasible moves';
  57  singleton set p1(peg),p2(peg);
  58  loop(nodeDiff1disk(node1,node2,disk),
  59     p1(peg) = nodeval(node1,disk)=ord(peg);
  60     p2(peg) = nodeval(node2,disk)=ord(peg);
  61     diskMoved(node1,node2,disk) = smallest(node1,disk,p1) and smallest(node2,disk,p2);
  62  );
  63  display diskMoved;
  64   
  65  arc(node1,node2) = sum(diskMoved(node1,node2,disk),1);
  66   
  67  *----------------------------------------------------------------------
  68  * shortest path model
  69  *----------------------------------------------------------------------
  70   
  71  Parameters
  72     supply(node)
  73     demand(node)
  74  ;
  75  supply(node)$(sum(nodes(node,disk,'pegA'),1) = n) = 1;
  76  demand(node)$(sum(nodes(node,disk,'pegB'),1) = n) = 1;
  77   
  78  binary variable f(node,node) 'flow';
  79  variable z 'objective';
  80   
  81  equations
  82     flowbal(node) 'flow balance'
  83     obj           'objective'
  84  ;
  85   
  86  obj.. z =e= sum(arc,f(arc));
  87   
  88  flowbal(node1)..
  89     sum(arc(node2,node1),f(node2,node1)) + supply(node1) =e= sum(arc(node1,node2),f(node1,node2)) + demand(node1);
  90   
  91  model shortestpath /all/;
  92  solve shortestpath minimizing z using rmip;
  93  display f.l;
  94   
  95  *----------------------------------------------------------------------
  96  * reporting
  97  *----------------------------------------------------------------------
  98   
  99  set
 100      move/move1*move100/
 101      trace(move,node,node,disk,peg,peg)
 102  ;
 103   
 104  singleton sets
 105    cur(node) 'current node' /node1/
 106    next(node) 'next node'
 107  ;
 108   
 109  cur(node) = supply(node)>0;
 110   
 111  loop(move$card(cur),
 112   
 113      next(node) = f.l(cur,node)>0.5;
 114   
 115      loop(diskMoved(cur,next,disk),
 116          p1(peg) = nodeval(cur,disk)=ord(peg);
 117          p2(peg) = nodeval(next,disk)=ord(peg);
 118          trace(move,cur,next,disk,p1,p2) = yes;
 119      );
 120   
 121      cur(node) = next(node);
 122  );
 123   
 124  option trace:0:0:1;
 125  display trace;


