G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi
         
         Standard problem can be solved with a simple recursion. Here we use a MIP
         model that uses an inventory modeling paradigm.
         
   9   
  10   
  11  *-----------------------------------------------------------------------------------
  12  * size of problem
  13  *-----------------------------------------------------------------------------------
  14   
  17   
  18  *-----------------------------------------------------------------------------------
  19  * recursion in Python
  20  *-----------------------------------------------------------------------------------
  21   
  22   
  39   
  40   
  41  *-----------------------------------------------------------------------------------
  42  * data
  43  *-----------------------------------------------------------------------------------
  44   
  45  * max number of moves
  46  * we can guess (overestimate) or use the known value 2^n-1
  47  *$set tmax 25
  49   
  50  sets
  51     dummy 'for ordering' /initial/
  52     peg /pegA,pegB,pegC/
  53     disk  /disk1*disk4/
  54     t 'moves or timesteps' /t1*t15/
  55  ;
  56  display peg,disk,t;
  57   
  58  alias (peg,peg1,peg2);
  59   
  60  Parameters
  61      n 'number of disks' /4/
  62      size(disk) 'size of each disk: 1..n'
  63      maxsize 'maximum size of disk'
  64      initial(t,disk,peg) 'initial inventory (state)'
  65      final(disk,peg) 'final inventory (state)'
  66  ;
  67   
  68  abort$(card(t)<2**n-1) "increase size of set t";
  69   
  70  size(disk) = ord(disk);
  71  maxsize = smax(disk,size(disk));
  72   
  73  * initial state: all disks on peg A
  74  * has t index to make it easier to use in the constraints
  75  *initial('t1',disk,'pegA') = 1;
  76  initial('t1','disk1','pegA') = 1;
  77  initial('t1','disk2','pegA') = 1;
  78  initial('t1','disk3','pegA') = 1;
  79  initial('t1','disk4','pegA') = 1;
  80   
  81  * final state: all disks on peg B
  82  *final(disk,'pegB') = 1;
  83  final('disk1','pegB') = 1;
  84  final('disk2','pegB') = 1;
  85  final('disk3','pegB') = 1;
  86  final('disk4','pegB') = 1;
  87   
  88  display n,size,maxsize,initial,final;
  89   
  90   
  91  *-----------------------------------------------------------------------------------
  92  * MIP model
  93  *-----------------------------------------------------------------------------------
  94   
  95   
  96  binary variable
  97     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  98     inv(t,disk,peg)        'inventory after move'
  99     done(t)                'we are done'
 100  ;
 101  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
 102  smallestPrev.lo(t,peg) = 1;
 103  smallestPrev.up(t,peg) = maxsize;
 104   
 105  variable z 'obj';
 106   
 107  equations
 108     move1disk(t)           'move 1 disk (or 0 if done)'
 109     bndsmall(t,disk,peg)   'bound on smallest size of disk'
 110     smallfrom(t,peg)       'need to select smallest disk from source peg'
 111     smallto(t,peg)         'size restriction on destination peg'
 112     inventory(t,disk,peg)  'inventory balance'
 113     isdone(t)              'we are done'
 114     ordering(t)            'optional'
 115     assignment(t,disk)     'optional assignment constraint'
 116     obj                    'objective'
 117  ;
 118   
 119   
 120  * if done=1: move zero disks
 121  * if done=0: move exactly one disk
 122  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
 123   
 124  * don't move a disk from and to the same peg
 125  move.fx(t,disk,peg,peg) = 0;
 126   
 127  * we can only move the smallest disk
 128  parameter initsmallest(t,peg);
 129  initsmallest('t1',peg) = maxsize;
 130  initsmallest('t1','pegA') = smin(disk,size(disk));
 131  display initsmallest;
 132   
 133  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
 134  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
 135  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
 136  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
 137   
 138  * inventory balance
 139  inventory(t,disk,peg)..
 140    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + initial(t,disk
      ,peg);
 141   
 142  * done if all disks are at peg B
 143  *isdone(t).. sum(disk,inv(t,disk,'pegB')) =g= n*done(t);
 144  isdone(t).. sum((disk,peg)$final(disk,peg),inv(t,disk,peg)) =g= n*done(t);
 145   
 146  obj.. z =e= sum(t,done(t));
 147   
 148  * optional constraints
 149  ordering(t-1).. done(t) =g= done(t-1);
 150  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 151   
 152  * optional fixes
 153  set lastt(t);
 154  lastt(t) = ord(t)=card(t);
 155  done.fx(lastt) = 1;
 156  inv.fx(lastt,disk,peg) = final(disk,peg);
 157   
 158  model m /all/;
 159   
 160  *-----------------------------------------------------------------------------------
 161  * Solve
 162  *-----------------------------------------------------------------------------------
 163   
 164  solve m maximizing z using mip;
 165  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 166   
 167  * raw results
 168  option move:0:2:2;
 169  display smallestPrev.l,move.l,inv.l,done.l;
 170   
 171  *-----------------------------------------------------------------------------------
 172  * Reporting
 173  *-----------------------------------------------------------------------------------
 174   
 175  set sinv(*,disk,peg) 'include initial, and stop after done';
 176  sinv('initial',disk,peg) = initial('t1',disk,peg);
 177  loop(t,
 178     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 179     break$(done.l(t)>0.5);
 180  );
 181  display sinv;
 182   
 183  scalar numMoves 'number of moves';
 184  numMoves = sum(t$sum(sinv(t,disk,peg),1),1);
 185  display numMoves;
 186   
 187  *-----------------------------------------------------------------------------------
 188  * Visualization
 189  *-----------------------------------------------------------------------------------
 190   
 191  abort.noError$(n>6 or 1=0) "skipping plot";
 192   
 194   
 195  file f /hanoiplots.html/;
 196  put f;
 197   
 198  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 199  put '<h2>Towers of Hanoi MIP Results</h2>'/;
 200  put 'Number of pegs: ',card(peg):0:0,'<br>'/;
 201  put 'Number of disks: 4 <br>'/;
 202  put 'Number of moves: ',numMoves:0:0,'<br>'/;
 203  put 'MIP model has ',m.numvar:0:0,' variables (of which ',m.numdvar:0:0,' binary) and ',m.numequ:0:0,' equations<br><br>'/;
 204   
 205  put '<table border="1">'/;
 206  put '<tr>'/;
 207   
 209   
 210  alias (t1,*);
 211  parameter ndisks(*,peg) 'number of disks on each peg';
 212  ndisks(t1,peg) = sum(sinv(t1,disk,peg),1);
 213  display ndisks;
 214   
 215  scalar nd,x,y,w,k /0/;
 216  parameter pegpos(peg) /pegA 3, pegB 6, pegC 9/;
 217   
 218  loop(t1$sum(sinv(t1,disk,peg),1),
 219     if (k=4,
 220         put "</tr><tr>"/;
 221         k = 0;
 222      );
 223     k = k + 1;
 224   
 225     put '<td style="text-align: center">'/;
 226     put '<svg height="100" width="300" viewBox="0 0 12 6">'/;
 227   
 228     loop(peg,
 229  * draw peg
 230        put '<line x1="',(pegpos(peg)):0:0,'" y1="1" x2="',(pegpos(peg)):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>
      '/;
 231  * draw disk
 232        nd = ndisks(t1,peg);
 233        loop(sinv(t1,disk,peg),
 234           y = n+1-nd+1;
 235           w = size(disk)*3/n;
 236           x = 3*ord(peg)-0.5*w;
 237  *         display x,w,y;
 238           put '<rect x="',x:4:2,'" y="',y:4:2,'" height="1" width="',w:4:2,'" fill="lightblue"/>'/;
 239           put '<text x="',(3*ord(peg)):0:0,'" y="',(y+0.6):3:1,'" dominant-baseline="middle" text-anchor="middle" font-size="
      0.6">',(ord(disk)):0:0,'</text>'/;
 240           nd = nd-1;
 241        );
 242     );
 243     put '</svg><br>',t1.tl:0/;
 244     put '</td>'/;
 245  );
 246   
 247  put '</tr></table>';
 248  putclose;
 249  executetool 'win32.ShellExecute "hanoiplots.html"';
 250   


