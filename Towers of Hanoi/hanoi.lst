      + move(t2,disk1,pegB,pegB) + move(t2,disk1,pegB,pegC) + move(t2,disk1,pegC,pegA) + move(t2,disk1,pegC,pegB)
     
      + move(t2,disk1,pegC,pegC) + move(t2,disk2,pegA,pegA) + move(t2,disk2,pegA,pegB) + move(t2,disk2,pegA,pegC)
     
