---- done  we are done

done(t1)
                (.LO, .L, .UP, .M = 0, 0, 1, 0)
        1       move1disk(t2)
       -3       isdone(t1)
       -1       ordering(t1)
       -1       obj

done(t2)
                (.LO, .L, .UP, .M = 0, 0, 1, 0)
        1       move1disk(t3)
       -3       isdone(t2)
        1       ordering(t1)
       -1       ordering(t2)
       -1       obj

done(t3)
                (.LO, .L, .UP, .M = 0, 0, 1, 0)
