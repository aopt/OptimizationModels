G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi
         
   6   
   7  *-----------------------------------------------------------------------------------
   8  * size of problem
   9  *-----------------------------------------------------------------------------------
  10   
  13   
  14  *-----------------------------------------------------------------------------------
  15  * recursion in Python
  16  *-----------------------------------------------------------------------------------
  17   
  18   
  35   
  36  *-----------------------------------------------------------------------------------
  37  * data
  38  *-----------------------------------------------------------------------------------
  39   
  40  * max number of moves
  41  * we can guess (overestimate) or use the known value 2^n-1
  42  *$set tmax 25
  44   
  45  sets
  46     dummy 'for ordering' /initial/
  47     peg /pegA,pegB,pegC/
  48     disk  /disk1*disk3/
  49     t 'moves or timesteps' /t1*t7/
  50  ;
  51  display peg,disk,t;
  52   
  53  alias (peg,peg1,peg2);
  54   
  55  Parameters
  56      n 'number of disks' /3/
  57      size(disk) 'size of each disk: 1..n'
  58      maxsize 'maximum size of disk'
  59      initial(t,disk,peg) 'initial inventory (state)'
  60      final(disk,peg) 'final inventory (state)'
  61  ;
  62   
  63  abort$(card(t)<2**n-1) "increase size of set t";
  64   
  65  size(disk) = ord(disk);
  66  maxsize = smax(disk,size(disk));
  67   
  68  * initial state: all disks on peg A
  69  * has t index to make it easier to use in the constraints
  70  initial('t1',disk,'pegA') = 1;
  71   
  72  * final state: all disks on peg B
  73  final(disk,'pegB') = 1;
  74   
  75  display n,size,maxsize,initial,final;
  76   
  77  *-----------------------------------------------------------------------------------
  78  * MIP model
  79  *-----------------------------------------------------------------------------------
  80   
  81  binary variable
  82     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  83     inv(t,disk,peg)        'inventory after move'
  84     done(t)                'we are done'
  85  ;
  86  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
  87  smallestPrev.lo(t,peg) = 1;
  88  smallestPrev.up(t,peg) = maxsize;
  89   
  90  variable z 'obj';
  91   
  92  equations
  93     move1disk(t)           'move 1 disk (or 0 if done)'
  94     bndsmall(t,disk,peg)   'bound on smallest size of disk'
  95     smallfrom(t,peg)       'need to select smallest disk from source peg'
  96     smallto(t,peg)         'size restriction on destination peg'
  97     inventory(t,disk,peg)  'inventory balance'
  98     isdone(t)              'we are done'
  99     ordering(t)            'optional'
 100     assignment(t,disk)     'optional assignment constraint'
 101     obj                    'objective'
 102  ;
 103   
 104   
 105  * if done=1: move zero disks
 106  * if done=0: move exactly one disk
 107  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
 108   
 109  * don't move a disk from and to the same peg
 110  move.fx(t,disk,peg,peg) = 0;
 111   
 112  * we can only move the smallest disk
 113  parameter initsmallest(t,peg);
 114  initsmallest('t1',peg) = maxsize;
 115  initsmallest('t1','pegA') = smin(disk,size(disk));
 116  display initsmallest;
 117   
 118  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
 119  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
 120  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
 121  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
 122   
 123  * inventory balance
 124  inventory(t,disk,peg)..
 125    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + initial(t,disk
      ,peg);
 126   
 127  * done if all disks are at peg B
 128  isdone(t).. sum(disk,inv(t,disk,'pegB')) =g= n*done(t);
 129   
 130  obj.. z =e= sum(t,done(t));
 131   
 132  * optional constraints
 133  ordering(t-1).. done(t) =g= done(t-1);
 134  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 135   
 136  * optional fixes
 137  set lastt(t);
 138  lastt(t) = ord(t)=card(t);
 139  done.fx(lastt) = 1;
 140  inv.fx(lastt,disk,peg) = final(disk,peg);
 141   
 142  model m /all/;
 143   
 144  *-----------------------------------------------------------------------------------
 145  * Solve
 146  *-----------------------------------------------------------------------------------
 147   
 148  solve m maximizing z using mip;
 149  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 150   
 151  * raw results
 152  option move:0:2:2;
 153  display smallestPrev.l,move.l,inv.l,done.l;
 154   
 155  *-----------------------------------------------------------------------------------
 156  * Reporting
 157  *-----------------------------------------------------------------------------------
 158   
 159  set sinv(*,disk,peg) 'include initial, and stop after done';
 160  sinv('initial',disk,peg) = initial('t1',disk,peg);
 161  loop(t,
 162     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 163     break$(done.l(t)>0.5);
 164  );
 165  display sinv;
 166   
 167  *-----------------------------------------------------------------------------------
 168  * Visualization
 169  *-----------------------------------------------------------------------------------
 170   
 171  abort.noError$(n>6 or 1=0) "skipping plot";
 172   
 174   
 175  file f /hanoiplots.html/;
 176  put f;
 177   
 178  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 179  put '<h2>Towers of Hanoi Results</h2>'/;
 180  put 'Number of disks: 3'/;
 181   
 182  put '<table border="1">'/;
 183  put '<tr>'/;
 184   
 186   
 187  alias (t1,*);
 188  parameter ndisks(*,peg) 'number of disks on each peg';
 189  ndisks(t1,peg) = sum(sinv(t1,disk,peg),1);
 190  display ndisks;
 191   
 192  scalar nd,x,y,w,k /0/;
 193   
 194  loop(t1$sum(sinv(t1,disk,peg),1),
 195     if (k=4,
 196         put "</tr><tr>"/;
 197         k = 0;
 198      );
 199     k = k + 1;
 200   
 201     put '<td style="text-align: center">'/;
 202     put '<svg height="100" width="300" viewBox="0 0 12 5">'/;
 203  * draw pegs
 204     put '<line x1="3" y1="1" x2="3" y2="5" style="stroke:brown;stroke-width:0.1"/>'/;
 205     put '<line x1="6" y1="1" x2="6" y2="5" style="stroke:brown;stroke-width:0.1"/>'/;
 206     put '<line x1="9" y1="1" x2="9" y2="5" style="stroke:brown;stroke-width:0.1"/>'/;
 207   
 208     loop(peg,
 209        nd = ndisks(t1,peg);
 210        loop(sinv(t1,disk,peg),
 211           y = n+1-nd+1;
 212           w = size(disk)*3/n;
 213           x = 3*ord(peg)-0.5*w;
 214  *         display x,w,y;
 215           put '<rect x="',x:4:2,'" y="',y:4:2,'" height="1" width="',w:4:2,'" fill="lightblue"/>'/;
 216           put '<text x="',(3*ord(peg)):0:0,'" y="',(y+0.6):3:1,'" dominant-baseline="middle" text-anchor="middle" font-size="
      0.6">',(ord(disk)):0:0,'</text>'/;
 217           nd = nd-1;
 218        );
 219     );
 220     put '</svg><br>',t1.tl:0/;
 221     put '</td>'/;
 222  );
 223   
 224  put '</tr></table>';
 225  putclose;
 226  executetool 'win32.ShellExecute "hanoiplots.html"';


