---- smallto  =L=  size restriction on destination peg

smallto(t1,pegA)..  move(t1,disk1,pegA,pegA) + move(t1,disk1,pegB,pegA) + move(t1,disk1,pegC,pegA) + 2*move(t1,disk2,pegA,pegA)
     
      + 2*move(t1,disk2,pegB,pegA) + 2*move(t1,disk2,pegC,pegA) + 3*move(t1,disk3,pegA,pegA) + 3*move(t1,disk3,pegB,pegA)
     
      + 3*move(t1,disk3,pegC,pegA) - smallestPrev(t1,pegA) =L= 0 ; (LHS = -1)
     
smallto(t1,pegB)..  move(t1,disk1,pegA,pegB) + move(t1,disk1,pegB,pegB) + move(t1,disk1,pegC,pegB) + 2*move(t1,disk2,pegA,pegB)
     
      + 2*move(t1,disk2,pegB,pegB) + 2*move(t1,disk2,pegC,pegB) + 3*move(t1,disk3,pegA,pegB) + 3*move(t1,disk3,pegB,pegB)
     
      + 3*move(t1,disk3,pegC,pegB) - smallestPrev(t1,pegB) =L= 0 ; (LHS = -3)
     
smallto(t1,pegC)..  move(t1,disk1,pegA,pegC) + move(t1,disk1,pegB,pegC) + move(t1,disk1,pegC,pegC) + 2*move(t1,disk2,pegA,pegC)
     
      + 2*move(t1,disk2,pegB,pegC) + 2*move(t1,disk2,pegC,pegC) + 3*move(t1,disk3,pegA,pegC) + 3*move(t1,disk3,pegB,pegC)
     
      + 3*move(t1,disk3,pegC,pegC) - smallestPrev(t1,pegC) =L= 0 ; (LHS = -3)
     
