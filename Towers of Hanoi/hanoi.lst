---- inventory  =E=  inventory balance

inventory(t1,disk1,pegA)..  move(t1,disk1,pegA,pegB) + move(t1,disk1,pegA,pegC) - move(t1,disk1,pegB,pegA)
     
      - move(t1,disk1,pegC,pegA) + inv(t1,disk1,pegA) =E= 1 ; (LHS = 0, INFES = 1 ****)
     
inventory(t1,disk1,pegB)..  - move(t1,disk1,pegA,pegB) + move(t1,disk1,pegB,pegA) + move(t1,disk1,pegB,pegC)
     
      - move(t1,disk1,pegC,pegB) + inv(t1,disk1,pegB) =E= 0 ; (LHS = 0)
     
inventory(t1,disk1,pegC)..  - move(t1,disk1,pegA,pegC) - move(t1,disk1,pegB,pegC) + move(t1,disk1,pegC,pegA)
     
      + move(t1,disk1,pegC,pegB) + inv(t1,disk1,pegC) =E= 0 ; (LHS = 0)
     
