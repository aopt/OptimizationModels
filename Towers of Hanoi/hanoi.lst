move1disk(t1)..  move(t1,disk1,pegA,pegA) + move(t1,disk1,pegA,pegB) + move(t1,disk1,pegA,pegC) + move(t1,disk1,pegB,pegA)
     
      + move(t1,disk1,pegB,pegB) + move(t1,disk1,pegB,pegC) + move(t1,disk1,pegC,pegA) + move(t1,disk1,pegC,pegB)
     
      + move(t1,disk1,pegC,pegC) + move(t1,disk2,pegA,pegA) + move(t1,disk2,pegA,pegB) + move(t1,disk2,pegA,pegC)
     
