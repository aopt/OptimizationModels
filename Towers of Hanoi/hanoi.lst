isdone(t1)..  inv(t1,disk1,pegB) + inv(t1,disk2,pegB) + inv(t1,disk3,pegB) - 3*done(t1) =G= 0 ; (LHS = 0)
     
isdone(t2)..  inv(t2,disk1,pegB) + inv(t2,disk2,pegB) + inv(t2,disk3,pegB) - 3*done(t2) =G= 0 ; (LHS = 0)
     
isdone(t3)..  inv(t3,disk1,pegB) + inv(t3,disk2,pegB) + inv(t3,disk3,pegB) - 3*done(t3) =G= 0 ; (LHS = 0)
     
