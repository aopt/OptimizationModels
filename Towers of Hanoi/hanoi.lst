      + move(t1,disk2,pegC,pegB) + move(t1,disk2,pegC,pegC) + move(t1,disk3,pegA,pegA) + move(t1,disk3,pegA,pegB)
     
      + move(t1,disk3,pegA,pegC) + move(t1,disk3,pegB,pegA) + move(t1,disk3,pegB,pegB) + move(t1,disk3,pegB,pegC)
     
