G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi
         
         Standard problem can be solved with a simple recursion. Here we use a MIP
         model that uses an inventory modeling paradigm.
         
   9   
  10   
  11  *-----------------------------------------------------------------------------------
  12  * size of problem
  13  *-----------------------------------------------------------------------------------
  14   
  17   
  18  *-----------------------------------------------------------------------------------
  19  * recursion in Python
  20  *-----------------------------------------------------------------------------------
  21   
  22   
  39   
  40   
  41  *-----------------------------------------------------------------------------------
  42  * data
  43  *-----------------------------------------------------------------------------------
  44   
  45  * max number of moves
  46  * we can guess (overestimate) or use the known value 2^n-1
  47  *$set tmax 25
  49   
  50  sets
  51     dummy 'for ordering' /initial/
  52     peg /pegA,pegB,pegC/
  53     disk  /disk1*disk4/
  54     t 'moves or timesteps' /t1*t15/
  55  ;
  56  display peg,disk,t;
  57   
  58  alias (peg,peg1,peg2);
  59   
  60  Parameters
  61      n 'number of disks' /4/
  62      size(disk) 'size of each disk: 1..n'
  63      maxsize 'maximum size of disk'
  64  ;
  65   
  66  Sets
  67    initial(disk,peg) 'initial inventory (state)'
  68    final(disk,peg) 'final inventory (state)'
  69   
  70   
  71  abort$(card(t)<2**n-1) "increase size of set t";
  72   
  73  size(disk) = ord(disk);
  74  maxsize = smax(disk,size(disk));
  75   
  76  * initial state: all disks on peg A
  77  * has t index to make it easier to use in the constraints
  78  initial(disk,'pegA') = yes;
  79   
  80  * final state: all disks on peg B
  81  final(disk,'pegB') = yes;
  82   
  83  display n,size,maxsize,initial,final;
  84   
  85   
  86  *-----------------------------------------------------------------------------------
  87  * MIP model
  88  *-----------------------------------------------------------------------------------
  89   
  90   
  91  binary variable
  92     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  93     inv(t,disk,peg)        'inventory after move'
  94     done(t)                'we are done'
  95  ;
  96  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
  97  smallestPrev.lo(t,peg) = 1;
  98  smallestPrev.up(t,peg) = maxsize;
  99   
 100  variable z 'obj';
 101   
 102  equations
 103     move1disk(t)           'move 1 disk (or 0 if done)'
 104     bndsmall(t,disk,peg)   'bound on smallest size of disk'
 105     smallfrom(t,peg)       'need to select smallest disk from source peg'
 106     smallto(t,peg)         'size restriction on destination peg'
 107     inventory(t,disk,peg)  'inventory balance'
 108     isdone(t)              'we are done'
 109     ordering(t)            'optional'
 110     assignment(t,disk)     'optional assignment constraint'
 111     obj                    'objective'
 112  ;
 113   
 114   
 115  * if done=1: move zero disks
 116  * if done=0: move exactly one disk
 117  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
 118   
 119  * don't move a disk from and to the same peg
 120  move.fx(t,disk,peg,peg) = 0;
 121   
 122  * we can only move the smallest disk
 123  parameter initsmallest(t,peg) 'smallest disk on each peg for initial configuration';
 124  initsmallest('t1',peg)$(sum(initial(disk,peg),1)=0) = maxsize;
 125  initsmallest('t1',peg)$(sum(initial(disk,peg),1)>0) = smin(initial(disk,peg),size(disk));
 126  display initsmallest;
 127   
 128  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
 129  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
 130  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
 131  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
 132   
 133  * inventory balance
 134  inventory(t,disk,peg)..
 135    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + 1$(initial(dis
      k,peg) and ord(t)=1);
 136   
 137  * done if all disks are at peg B
 138  isdone(t).. sum((disk,peg)$final(disk,peg),inv(t,disk,peg)) =g= n*done(t);
 139   
 140  obj.. z =e= sum(t,done(t));
 141   
 142  * optional constraints
 143  ordering(t-1).. done(t) =g= done(t-1);
 144  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 145   
 146  * optional fixes
 147  set lastt(t);
 148  lastt(t) = ord(t)=card(t);
 149  done.fx(lastt) = 1;
 150  inv.fx(lastt,disk,peg) = final(disk,peg);
 151   
 152  model m /all/;
 153   
 154  *-----------------------------------------------------------------------------------
 155  * Solve
 156  *-----------------------------------------------------------------------------------
 157   
 158  solve m maximizing z using mip;
 159  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 160   
 161  * raw results
 162  option move:0:2:2;
 163  display smallestPrev.l,move.l,inv.l,done.l;
 164   
 165  *-----------------------------------------------------------------------------------
 166  * Reporting
 167  *-----------------------------------------------------------------------------------
 168   
 169  set sinv(*,disk,peg) 'include initial, and stop after done';
 170  sinv('initial',initial) = yes;
 171  loop(t,
 172     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 173     break$(done.l(t)>0.5);
 174  );
 175  display sinv;
 176   
 177  scalar numMoves 'number of moves';
 178  numMoves = sum(t$sum(sinv(t,disk,peg),1),1);
 179  display numMoves;
 180   
 181  *-----------------------------------------------------------------------------------
 182  * Visualization
 183  *-----------------------------------------------------------------------------------
 184   
 185  abort.noError$(n>6 or 1=0) "skipping plot";
 186   
 188   
 189  file f /hanoiplots.html/;
 190  put f;
 191   
 192  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 193  put '<h2>Towers of Hanoi MIP Results</h2>'/;
 194  put 'Number of pegs: ',card(peg):0:0,'<br>'/;
 195  put 'Number of disks: 4 <br>'/;
 196  put 'Number of moves: ',numMoves:0:0,'<br>'/;
 197  put 'MIP model has ',m.numvar:0:0,' variables (of which ',m.numdvar:0:0,' binary) and ',m.numequ:0:0,' equations<br><br>'/;
 198   
 199  put '<table border="1">'/;
 200  put '<tr>'/;
 201   
 203   
 204  alias (t1,*);
 205  parameter ndisks(*,peg) 'number of disks on each peg';
 206  ndisks(t1,peg) = sum(sinv(t1,disk,peg),1);
 207  display ndisks;
 208   
 209  scalar nd,x,y,w,k /0/;
 210  parameter pegpos(peg) 'x position of pegs';
 211  pegpos(peg) = 3*ord(peg);
 212   
 213  loop(t1$sum(sinv(t1,disk,peg),1),
 214     if (k=4,
 215         put "</tr><tr>"/;
 216         k = 0;
 217      );
 218     k = k + 1;
 219   
 220     put '<td style="text-align: center">'/;
 221     put '<svg height="100" width="300" viewBox="0 0 12 6">'/;
 222   
 223     loop(peg,
 224  * draw peg
 225        put '<line x1="',pegpos(peg):0:0,'" y1="1" x2="',pegpos(peg):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>'/;
 226  * draw disk
 227        nd = ndisks(t1,peg);
 228        loop(sinv(t1,disk,peg),
 229           y = n+1-nd+1;
 230           w = size(disk)*3/n;
 231           x = 3*ord(peg)-0.5*w;
 232  *         display x,w,y;
 233           put '<rect x="',x:0:2,'" y="',y:0:2,'" height="1" width="',w:0:2,'" fill="lightblue"/>'/;
 234           put '<text x="',pegpos(peg):0:2,'" y="',(y+0.6):0:2,'" dominant-baseline="middle" text-anchor="middle" font-size="0
      .6">',(ord(disk)):0:0,'</text>'/;
 235           nd = nd-1;
 236        );
 237     );
 238     put '</svg><br>',t1.tl:0/;
 239     put '</td>'/;
 240  );
 241   
 242  put '</tr></table>';
 243  putclose;
 244  executetool 'win32.ShellExecute "hanoiplots.html"';
 245   


