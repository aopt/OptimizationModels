GAMS 52.1.0  4f802a74 Nov 28, 2025          WEX-WEI x86 64bit/MS Windows - 01/08/26 07:25:37 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Towers of Hanoi, network formulation
       
         4 disks, 4 pegs
          
   8   
   9   
  10  *-----------------------------------------------------------------------------------
  11  * size of problem
  12  *-----------------------------------------------------------------------------------
  13   
  16   
  17  *-----------------------------------------------------------------------------------
  18  * nodes
  19  *-----------------------------------------------------------------------------------
  20   
  22   
  23  set
  24    node /node1*node256/
  25    disk /disk1*disk4/
  26    peg /pegA,pegB,PegC,PegD/
  27    nodes(node,disk,peg) / system.powersetRight /
  28  ;
  29   
  30  scalars
  31     n  'number of disks' /4/
  32     nn 'number of nodes' /256/
  33     p  'number of pegs'
  34  ;
  35  p = card(peg);
  36   
  37  display disk,peg,node,nodes;
  38   
  39  *-----------------------------------------------------------------------------------
  40  * arcs
  41  *-----------------------------------------------------------------------------------
  42   
  43  set arc(node,node);
  44   
  45  alias (node,node1,node2), (disk,disk1,disk2), (peg,peg1,peg2), (nodes,nodes1,nodes2);
  46   
  47  set smallest(node,disk,peg) 'smallest disk on peg';
  48  smallest(node,disk,peg) = smin(disk2$nodes(node,disk2,peg),ord(disk2)) = ord(disk);
  49  display smallest;
  50   
  51  parameter nodeVal(node,disk) 'peg number of (node,disk)';
  52  nodeVal(node,disk) = sum(nodes(node,disk,peg),ord(peg));
  53  display nodeVal;
  54   
  55  set nodediff1(node,node) '(node1,node2) combos with one difference';
  56  nodediff1(node1,node2) = sum(disk$(abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5),1)=1;
  57  display nodediff1;
  58   
  59  set nodeDiff1disk(node,node,disk) 'augment nodediff1 with disk id';
  60  nodeDiff1Disk(nodeDiff1(node1,node2),disk) = abs(nodeVal(node1,disk)-nodeVal(node2,disk))>0.5;
  61  display nodeDiff1Disk;
  62   
  63  set diskMoved(node,node,disk) 'feasible moves';
  64  singleton set p1(peg),p2(peg);
  65  loop(nodeDiff1disk(node1,node2,disk),
  66     p1(peg) = nodeval(node1,disk)=ord(peg);
  67     p2(peg) = nodeval(node2,disk)=ord(peg);
  68     diskMoved(node1,node2,disk) = smallest(node1,disk,p1) and smallest(node2,disk,p2);
  69  );
  70  display diskMoved;
  71   
  72  arc(node1,node2) = sum(diskMoved(node1,node2,disk),1);
  73   
  74   
  75  * check
  76  scalars
  77     narcs 'number of directed arcs in Hanoi graph'
  78     narcs2 'card(arc)'
  79  ;
  80  narcs = p*(p-1)*[power(p,n) - power(p-2,n)]/2;
  81  narcs2 = card(arc);
  82  abort$(narcs<>narcs2) "number of arcs is incorrect",narcs,narcs2;
  83   
  84   
  85  *----------------------------------------------------------------------
  86  * shortest path model
  87  *----------------------------------------------------------------------
  88   
  89  Sets
  90    initial(disk,peg) 'initial inventory (state)' / (disk1*disk4).pegA /
  91    final(disk,peg) 'final inventory (state)'     / (disk1*disk4).pegB /
  92  ;
  93   
  94   
  95  Parameters
  96     supply(node)
  97     demand(node)
  98  ;
  99  supply(node)$(sum(nodes(node,initial),1) = n) = 1;
 100  demand(node)$(sum(nodes(node,final),1) = n) = 1;
 101   
 102  binary variable f(node,node) 'flow';
 103  variable z 'objective';
 104   
 105  equations
 106     flowbal(node) 'flow balance'
 107     obj           'objective'
 108  ;
 109   
 110  obj.. z =e= sum(arc,f(arc));
 111   
 112  flowbal(node1)..
 113     sum(arc(node2,node1),f(node2,node1)) + supply(node1) =e= sum(arc(node1,node2),f(node1,node2)) + demand(node1);
 114   
 115  model shortestpath /all/;
 116  solve shortestpath minimizing z using rmip;
 117  display f.l;
 118   
 119  *----------------------------------------------------------------------
 120  * reporting
 121  *----------------------------------------------------------------------
 122   
 123  set
 124      move/move1*move100/
 125      trace(move,node,node,disk,peg,peg)
 126  ;
 127   
 128  singleton sets
 129    cur(node) 'current node' /node1/
 130    next(node) 'next node'
 131  ;
 132   
 133  cur(node) = supply(node)>0;
 134   
 135  loop(move$card(cur),
 136   
 137      next(node) = f.l(cur,node)>0.5;
 138   
 139      loop(diskMoved(cur,next,disk),
 140          p1(peg) = nodeval(cur,disk)=ord(peg);
 141          p2(peg) = nodeval(next,disk)=ord(peg);
 142          trace(move,cur,next,disk,p1,p2) = yes;
 143      );
 144   
 145      cur(node) = next(node);
 146  );
 147   
 148  option trace:0:0:1;
 149  display trace;
 150   
 151  *-----------------------------------------------------------------------------------
 152  * Visualization
 153  *-----------------------------------------------------------------------------------
 154   
 155  abort.noError$(n>6 or 1=0) "skipping plot";
 156   
 158   
 159  file fname /hanoiplots6.html/;
 160  put fname;
 161   
 162  put '<style>table,th,td {border-collapse: collapse;}</style>'/;
 163  put '<h2>Towers of Hanoi Extension 2 Network Results</h2>'/;
 164  put 'Number of pegs: ',card(peg):0:0,'<br>'/;
 165  put 'Number of disks: 4 <br>'/;
 166  put 'Number of moves: ',z.l:0:0,'<br>'/;
 167  put 'Network has ',nn:0:0,' nodes and ',narcs:0:0,' arcs<br><br>';
 168   
 169  put '<table border="1">'/;
 170  put '<tr>'/;
 171   
 173   
 174  scalar nd,x,y,w,k /0/;
 175  parameter pegpos(peg) 'x position of pegs';
 176  pegpos(peg) = 3*ord(peg);
 177   
 178  cur(node) = supply(node)>0;
 179   
 180  loop(move$card(cur),
 181     if (k=4,
 182         put "</tr><tr>"/;
 183         k = 0;
 184      );
 185     k = k + 1;
 186   
 187     put '<td style="text-align: center">'/;
 188     put '<svg height="100" width="300" viewBox="0 0 12 6">'/;
 189   
 190     loop(peg,
 191  * draw peg
 192        put '<line x1="',(pegpos(peg)):0:0,'" y1="1" x2="',(pegpos(peg)):0:0,'" y2="6" style="stroke:brown;stroke-width:0.1"/>
      '/;
 193  * draw disk
 194        nd = sum(nodes(cur,disk,peg),1);
 195        loop(nodes(cur,disk,peg),
 196           y = n+1-nd+1;
 197           w = ord(disk)*3/n;
 198           x = pegpos(peg)-0.5*w;
 199  *         display x,w,y;
 200           put '<rect x="',x:0:2,'" y="',y:0:2,'" height="1" width="',w:0:2,'" fill="lightblue"/>'/;
 201           put '<text x="',pegpos(peg):0:2,'" y="',(y+0.6):0:2,'" dominant-baseline="middle" text-anchor="middle" font-size="0
      .6">',(ord(disk)):0:0,'</text>'/;
 202           nd = nd-1;
 203        );
 204     );
 205     put '</svg><br>',cur.tl:0/;
 206     put '</td>'/;
 207   
 208     next(node) = f.l(cur,node)>0.5;
 209     cur(node) = next(node);
 210   
 211  );
 212   
 213  put '</tr></table>';
 214  putclose;
 215  executetool 'win32.ShellExecute "hanoiplots6.html"';


