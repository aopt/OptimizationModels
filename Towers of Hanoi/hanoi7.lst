C o m p i l a t i o n


       
         Towers of Hanoi
       
         Is solution unique?   
         
   8   
   9   
  10  *-----------------------------------------------------------------------------------
  11  * size of problem
  12  *-----------------------------------------------------------------------------------
  13   
  15   
  16  *-----------------------------------------------------------------------------------
  17  * data
  18  *-----------------------------------------------------------------------------------
  19   
  20  * max number of moves
  21  * we can guess (overestimate) or use the known value 2^n-1
  22  *$set tmax 25
  24   
  25  sets
  26     dummy 'for ordering' /initial/
  27     peg /pegA,pegB,pegC/
  28     disk  /disk1*disk4/
  29     t 'moves or timesteps' /t1*t15/
  30  ;
  31  display peg,disk,t;
  32   
  33  alias (peg,peg1,peg2);
  34   
  35  Parameters
  36      n 'number of disks' /4/
  37      size(disk) 'size of each disk: 1..n'
  38      maxsize 'maximum size of disk'
  39  ;
  40   
  41  Sets
  42    initial(disk,peg) 'initial inventory (state)'
  43    final(disk,peg) 'final inventory (state)'
  44   
  45   
  46  abort$(card(t)<2**n-1) "increase size of set t";
  47   
  48  size(disk) = ord(disk);
  49  maxsize = smax(disk,size(disk));
  50   
  51  * initial state: all disks on peg A
  52  * has t index to make it easier to use in the constraints
  53  initial(disk,'pegA') = yes;
  54   
  55  * final state: all disks on peg B
  56  final(disk,'pegB') = yes;
  57   
  58  display n,size,maxsize,initial,final;
  59   
  60   
  61  *-----------------------------------------------------------------------------------
  62  * MIP model
  63  *-----------------------------------------------------------------------------------
  64   
  65   
  66  binary variable
  67     move(t,disk,peg,peg)   'disk is moved from one peg to another'
  68     inv(t,disk,peg)        'inventory after move'
  69     done(t)                'we are done'
  70  ;
  71  variable smallestPrev(t,peg) 'smallest disk in previous iteration';
  72  smallestPrev.lo(t,peg) = 1;
  73  smallestPrev.up(t,peg) = maxsize;
  74   
  75  variable z 'obj';
  76   
  77  equations
  78     move1disk(t)           'move 1 disk (or 0 if done)'
  79     bndsmall(t,disk,peg)   'bound on smallest size of disk'
  80     smallfrom(t,peg)       'need to select smallest disk from source peg'
  81     smallto(t,peg)         'size restriction on destination peg'
  82     inventory(t,disk,peg)  'inventory balance'
  83     isdone(t)              'we are done'
  84     ordering(t)            'optional'
  85     assignment(t,disk)     'optional assignment constraint'
  86     obj                    'objective'
  87  ;
  88   
  89   
  90  * if done=1: move zero disks
  91  * if done=0: move exactly one disk
  92  move1disk(t).. sum((disk,peg1,peg2),move(t,disk,peg1,peg2)) =e= 1-done(t-1);
  93   
  94  * don't move a disk from and to the same peg
  95  move.fx(t,disk,peg,peg) = 0;
  96   
  97  * we can only move the smallest disk
  98  parameter initsmallest(t,peg) 'smallest disk on each peg for initial configuration';
  99  initsmallest('t1',peg)$(sum(initial(disk,peg),1)=0) = maxsize;
 100  initsmallest('t1',peg)$(sum(initial(disk,peg),1)>0) = smin(initial(disk,peg),size(disk));
 101  display initsmallest;
 102   
 103  smallestPrev.fx('t1',peg) = initsmallest('t1',peg);
 104  bndsmall(t,disk,peg)$(ord(t)>1).. smallestPrev(t,peg) =l= size(disk)*inv(t-1,disk,peg) + n*(1-inv(t-1,disk,peg));
 105  smallfrom(t,peg)..     sum((disk,peg2),size(disk)*move(t,disk,peg,peg2)) =l= smallestPrev(t,peg);
 106  smallto(t,peg)..       sum((disk,peg1),size(disk)*move(t,disk,peg1,peg)) =l= smallestPrev(t,peg);
 107   
 108  * inventory balance
 109  inventory(t,disk,peg)..
 110    inv(t,disk,peg) =e= inv(t-1,disk,peg) - sum(peg2,move(t,disk,peg,peg2)) + sum(peg1,move(t,disk,peg1,peg)) + 1$(initial(dis
      k,peg) and ord(t)=1);
 111   
 112  * done if all disks are at peg B
 113  isdone(t).. sum((disk,peg)$final(disk,peg),inv(t,disk,peg)) =g= n*done(t);
 114   
 115  obj.. z =e= sum(t,done(t));
 116   
 117  * optional constraints
 118  ordering(t-1).. done(t) =g= done(t-1);
 119  assignment(t,disk).. sum(peg,inv(t,disk,peg)) =e= 1;
 120   
 121  * optional fixes
 122  set lastt(t);
 123  lastt(t) = ord(t)=card(t);
 124  done.fx(lastt) = 1;
 125  inv.fx(lastt,disk,peg) = final(disk,peg);
 126   
 127  model m /all/;
 128   
 129  *-----------------------------------------------------------------------------------
 130  * Solve
 131  *-----------------------------------------------------------------------------------
 132   
 133  solve m maximizing z using mip;
 134  abort$(m.modelstat <> 1 and m.modelstat <> 8) "no solution";
 135   
 136  * raw results
 137  option move:0:2:2;
 138  display smallestPrev.l,move.l,inv.l,done.l;
 139   
 140  *-----------------------------------------------------------------------------------
 141  * Reporting
 142  *-----------------------------------------------------------------------------------
 143   
 144  set sinv(*,disk,peg) 'include initial, and stop after done';
 145  sinv('initial',initial) = yes;
 146  loop(t,
 147     sinv(t,disk,peg) = inv.l(t,disk,peg)>0.5;
 148     break$(done.l(t)>0.5);
 149  );
 150  display sinv;
 151   
 152  scalar numMoves 'number of moves';
 153  numMoves = sum(t$sum(sinv(t,disk,peg),1),1);
 154  display numMoves;
 155   
 156  *-----------------------------------------------------------------------------------
 157  * Is solution unique?
 158  * try to find another solution with N=2^n-1 steps
 159  *-----------------------------------------------------------------------------------
 160   
 161  set sol(t,disk,peg,*);
 162  sol(t,disk,peg,'1') = inv.l(t,disk,peg)>0.5;
 163  sol(t,disk,peg,'0') = inv.l(t,disk,peg)<0.5;
 164   
 165  equation cut;
 166  cut.. sum(sol(t,disk,peg,'1'),inv(t,disk,peg)) - sum(sol(t,disk,peg,'0'),inv(t,disk,peg)) =l= sum(sol(t,disk,peg,'1'),1) - 1
      ;
 167   
 168  model m2 /m,cut/;
 169  solve m2 maximizing z using mip;
 170  abort$(m2.modelstat = 1 or m.modelstat = 8) "solution not unique";
 171   


