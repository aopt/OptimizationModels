GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 05/17/26 08:15:04 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
          Largest Empty Rotated Square.
          
          This version: exogenous angle
          This gives us a MIP model.
       
       
  10   
  11   
  12   
  13  *---------------------------------------------------------------
  14  * options
  15  *---------------------------------------------------------------
  16   
  17  * 0: no plot
  18  * 1: produce HTML plot
  20   
  21  * baron, antigone don't have sin(),cos() functions, so we use scip for this example
  22  option minlp=scip;
  23   
  24  option seed=12345;
  25   
  26  *---------------------------------------------------------------
  27  * data
  28  *---------------------------------------------------------------
  29   
  30  scalar maxsize 'size of the box' / 10 /;
  31   
  32  sets
  33     i     'points' /point1*point100/
  34     a     'square attributes' /x,y,s/
  35     c(a)  'coordinates' /x,y/
  36  ;
  37   
  38  parameter p(i,c) 'points';
  39  p(i,c) = uniform(0,maxsize);
  40  display p;
  41   
  42   
  43  *---------------------------------------------------------------
  44  * MIP MODEL
  45  *---------------------------------------------------------------
  46   
  47  scalars
  48     angle 'degrees' / 25 /
  49     theta 'angle in radians'
  50     M  'big-M'
  51  ;
  52  M = 2 * maxSize;
  53  theta = angle*pi/180;
  54  display theta;
  55   
  56   
  57  *
  58  * transform data points
  59  *
  60  parameter q(i,c) 'transformed data points: rotate by -theta';
  61  q(i,'x') =  p(i,'x')*cos(theta) + p(i,'y')*sin(theta);
  62  q(i,'y') = -p(i,'x')*sin(theta) + p(i,'y')*cos(theta);
  63  display q;
  64   
  65   
  66  *
  67  * transform corner points (for picture)
  68  * not used in the model, but useful for visualization
  69  *
  70   
  71  set k 'corner points box' /0-0, 0-1, 1-0, 1-1/;
  72  parameter box(k,c) 'box corners';
  73  box('0-0','x') = 0; box('0-0','y') = 0;
  74  box('0-1','x') = 0; box('0-1','y') = maxsize;
  75  box('1-0','x') = maxsize; box('1-0','y') = 0;
  76  box('1-1','x') = maxsize; box('1-1','y') = maxsize;
  77  display box;
  78   
  79  parameter tbox(k,c) 'box corners (transformed)';
  80  tbox(k,'x') =  box(k,'x')*cos(theta) + box(k,'y')*sin(theta);
  81  tbox(k,'y') = -box(k,'x')*sin(theta) + box(k,'y')*cos(theta);
  82  display tbox;
  83   
  84   
  85  set
  86     case 'for comparison' /less,greater/
  87     corners /00,01,10,11/
  88  ;
  89  table offset(corners,c) 'unit offset of corner points from lower-left'
  90          x  y
  91      00  0  0
  92      01  0  1
  93      10  1  0
  94      11  1  1
  95  ;
  96   
  97  variable
  98     sq(a) 'square location and size (transformed coordinates)'
  99     sq2(corners,c) 'corner points (original coordinates)'
 100  ;
 101  sq2.lo(corners,c) = 0;
 102  sq2.up(corners,c) = maxsize;
 103   
 104  binary variable d(i,c,case) 'd=1 means: relax no-overlap constraint';
 105  variable z 'objective';
 106   
 107  Equations
 108     emptysq1(i,c) 'no-overlap constraint: less-than version'
 109     emptysq2(i,c) 'no-overlap constraint: greater-than version'
 110     sumd(i)       '(at least) one no-overlap constraint must hold'
 111     transformx    "transform x',y' -> x back to original coordinates"
 112     transformy    "transform x',y' -> y back to original coordinates"
 113     objsq         'objective'
 114  ;
 115   
 116  * this is like the original axis-aligned square model
 117  objsq.. z =e= sq('s');
 118  emptysq1(i,c).. q(i,c) =l= sq(c) + d(i,c,'less')*M;
 119  emptysq2(i,c).. q(i,c) =g= sq(c) + sq('s') - d(i,c,'greater')*M;
 120  sumd(i)..  sum((c,case),d(i,c,case)) =e= 3;
 121   
 122  * transform back to original coordinates
 123  transformx(corners).. sq2(corners,'x') =e= (sq('x')+offset(corners,'x')*sq('s'))*cos(theta) - (sq('y')+offset(corners,'y')*s
      q('s'))*sin(theta);
 124  transformy(corners).. sq2(corners,'y') =e= (sq('x')+offset(corners,'x')*sq('s'))*sin(theta) + (sq('y')+offset(corners,'y')*s
      q('s'))*cos(theta);
 125   
 126  model emptysquare /all/;
 127  solve emptysquare maximizing z using mip;
 128   
 129  parameter square(*,*) 'optimal values';
 130  square(corners,c) = sq2.l(corners,c);
 131  square('side','-') = sq.l('s');
 132  square('area','-') = sqr(square('side','-'));
 133  display square;
 134   
 135   
 136  *---------------------------------------------------------------------
 137  * visualization
 138  *---------------------------------------------------------------------
 139   
 142   
 144   
 145   
 146  file fdata /data.js/; put fdata;
 147   
 148  * points
 149  put "p=["/;
 150  loop(i,
 151    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,"},"/;
 152  );
 153  put "]"/;
 154   
 155  put "q=["/;
 156  loop(i,
 157    put "  {i:'",i.tl:0,"',x:",q(i,'x'):0:4,",y:",q(i,'y'):0:4,"},"/;
 158  );
 159  put "]"/;
 160   
 161  put "box={x:0,y:0,size:",maxsize:0:4,"}"/;
 162  put "angle=",angle:0:4/;
 163   
 164  put "tbox=["/;
 165  loop(k,
 166    put "  {k:'",k.tl:0,"',x:",tbox(k,'x'):0:4,",y:",tbox(k,'y'):0:4,"},"/;
 167  );
 168  put "]"/;
 169   
 170  put "tr_sq={x:",sq.l('x'):0:4,",y:",sq.l('y'):0:4,",side:",sq.l('s'):0:4,",area:",(sq.l('s')**2):0:4,"}"/;
 171   
 172  put "cp=["/;
 173  loop(corners,
 174    put "  {k:'",corners.tl:0,"',x:",square(corners,'x'):0:4,",y:",square(corners,'y'):0:4,"},"/;
 175  );
 176  put "]"/;
 177  putclose;
 178   
 179   
 393   
 394  executetool 'win32.ShellExecute "plot.html"';
 395   


