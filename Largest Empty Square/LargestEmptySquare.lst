GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 05/12/26 04:23:08 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Find largest shapes that don't cover any points.
         
         Shapes:
            1. Square (MIP)
            2. Diamond (MIP)
            3. Rectangle (MISOCP)
            4. Circle (nonconvex NLP)
            5. 5 different "next best" rectangles
        
       
  14   
  15  *---------------------------------------------------------------
  16  * options
  17  *---------------------------------------------------------------
  18   
  19  * 0: no plot
  20  * 1: produce HTML plot)
  22   
  23  option qcp=cplex,mip=cplex,miqcp=cplex,nlp=baron;
  24   
  25  option seed=12345;
  26   
  27  *---------------------------------------------------------------
  28  * data
  29  *---------------------------------------------------------------
  30   
  31  scalar maxsize 'size of the box' / 10 /;
  32   
  33  sets
  34     i     'points' /point1*point100/
  35     cr    'circle attributes' /x,y,r/
  36     c(cr) 'coordinates' /x,y/
  37  ;
  38   
  39  parameter p(i,c) 'points';
  40  p(i,c) = uniform(0,maxsize);
  41  display p;
  42   
  43  *---------------------------------------------------------------
  44  * 1. largest empty square model (MIP)
  45  *---------------------------------------------------------------
  46   
  47  set case 'for comparison' /less,greater/;
  48   
  49  positive variable sq(*) 'square location and size';
  50  binary variable d(i,c,case) 'd=1 means: relax no-overlap constraint';
  51  variable z 'objective';
  52   
  53  Equations
  54     emptysq1(i,c) 'no-overlap constraint: less-than version'
  55     emptysq2(i,c) 'no-overlap constraint: greater-than version'
  56     sumd(i)       '(at least) one no-overlap constraint must hold'
  57     maxsq         'stay inside our box'
  58     objsq         'objective'
  59  ;
  60   
  61  objsq.. z =e= sq('side');
  62  maxsq(c)..  sq(c) + sq('s') =l= maxsize;
  63  emptysq1(i,c).. p(i,c) =l= sq(c) + d(i,c,'less')*maxsize;
  64  emptysq2(i,c).. p(i,c) =g= sq(c) + sq('side') - d(i,c,'greater')*maxsize;
  65  sumd(i)..  sum((c,case),d(i,c,case)) =e= 3;
  66   
  67  model emptysquare /all/;
  68  solve emptysquare maximizing z using mip;
  69   
  70  parameter square(*) 'optimal values';
  71  square(c) = sq.l(c);
  72  square('side') = sq.l('side');
  73  square('area') = sqr(sq.l('side'));
  74  display square;
  75   
  76  *---------------------------------------------------------------
  77  * 2. largest empty diamond model (MIP)
  78  *---------------------------------------------------------------
  79   
  80  set pm   'var splitting for abs()' /'+','-'/;
  81   
  82  positive variables
  83     diamnd(*)   'center + dist of diamond'
  84     absdiffd(i,c,*) 'Δ(i,c) = |p(i,c)-center(c)|'
  85  ;
  86  binary variable delta 'for variable splitting';
  87   
  88  variable dmin 'Manhattan distance to closest point';
  89   
  90  equation
  91     eabsdiff1(i,c) '|p(i,c)-center(c)|'
  92     eabsdiff2(i,c) '|p(i,c)-center(c)|'
  93     eabsdiff3(i,c) '|p(i,c)-center(c)|'
  94     smallestd      'smallest distance'
  95     elbnd(c)       'diamond must be inside box'
  96     eubnd(c)       'diamond must be inside box'
  97  ;
  98   
  99  eabsdiff1(i,c)..  absdiffd(i,c,'+')-absdiffd(i,c,'-') =e= p(i,c)-diamnd(c);
 100  eabsdiff2(i,c)..  absdiffd(i,c,'+') =l= delta(i,c)*Maxsize;
 101  eabsdiff3(i,c)..  absdiffd(i,c,'-') =l= (1-delta(i,c))*Maxsize;
 102  smallestd(i)..    dmin =l= sum((c,pm),absdiffd(i,c,pm));
 103  elbnd(c)..        diamnd(c) - dmin =g= 0;
 104  eubnd(c)..        diamnd(c) + dmin =l= maxsize;
 105   
 106  model emptydiamond /all-emptysquare/;
 107  solve emptydiamond maximizing dmin using mip;
 108   
 109  parameter diamond(*) 'optimal values';
 110  diamond(c) = diamnd.l(c);
 111  diamond('L1 dist') = dmin.l;
 112  diamond('diagonal') = 2*dmin.l;
 113  diamond('side') = sqrt(2*sqr(dmin.l));
 114  diamond('area') = 2*sqr(dmin.l);
 115  display diamond;
 116   
 117  *---------------------------------------------------------------
 118  * largest empty rectangle model (MISOCP)
 119  *---------------------------------------------------------------
 120   
 121  set a 'attribute' /pos,side/;
 122  positive variable rect(a,c) 'rectangle location and size';
 123  binary variable d(i,c,case) 'd=1 means: relax no-overlap constraint';
 124  variables t 'to be maximized';
 125   
 126  Equations
 127     maxrect(c)        'stay inside box'
 128     emptyrect1(i,c)   'no-overlap: less-than version'
 129     emptyrect2(i,c)   'no-overlap: greater-than version'
 130     socp              '2nd order cone constraint'
 131  ;
 132   
 133  maxrect(c)..  rect('pos',c) + rect('side',c) =l= maxsize;
 134  emptyrect1(i,c).. p(i,c) =l= rect('pos',c) + d(i,c,'less')*maxsize;
 135  emptyrect2(i,c).. p(i,c) =g= rect('pos',c) + rect('side',c) - d(i,c,'greater')*maxsize;
 136  socp.. sqr(t) =l= rect('side','x')*rect('side','y');
 137   
 138  model maxrectangle /maxrect,emptyrect1,emptyrect2,socp,sumd/;
 139  solve maxrectangle maximizing t using miqcp;
 140   
 141  parameter rectangle(a,c) 'optimal rectangle';
 142  rectangle(a,c) = rect.l(a,c);
 143  display rectangle;
 144   
 145  *---------------------------------------------------------------
 146  * largest empty circle model (nonconvex NLP)
 147  *---------------------------------------------------------------
 148   
 149  Variables
 150      circle(cr)  'center+radius'
 151      diff(i,c)   'intermediate variables'
 152  ;
 153   
 154  equations
 155     calcdiff(i,c)    'compute diff'
 156     emptycircle(i)   'no points inside circle'
 157     objcircle        'objective'
 158     bnd1(c)          'stay inside box'
 159     bnd2(c)          'stay inside box'
 160  ;
 161   
 162  objcircle.. z =e= circle('r');
 163  calcdiff(i,c).. diff(i,c) =e= p(i,c)-circle(c);
 164  emptycircle(i).. sum(c, sqr(diff(i,c))) =g= sqr(circle('r'));
 165  bnd1(c).. circle(c) =g= circle('r');
 166  bnd2(c).. circle(c) =l= maxsize-circle('r');
 167   
 168  circle.lo(cr) = 0;
 169  circle.up(cr) = maxsize;
 170   
 171  model maxcircle /objcircle,calcdiff,emptycircle,bnd1,bnd2/;
 172  solve maxcircle maximizing z using nlp;
 173   
 174  display circle.l;
 175   
 176   
 177  *---------------------------------------------------------------
 178  * five best rectangles
 179  *---------------------------------------------------------------
 180   
 181  scalar difftol 'min difference between rectangles |Δx|+|Δy|>difftol' /3/;
 182   
 183  set
 184     run  'solve runs' /run1*run5/
 185     prevrun(run) 'previous runs'
 186  ;
 187   
 188  parameter prevrect(run,*,*);
 189   
 190  binary variable bindiff(run,c);
 191  positive variable absdiff(run,c,pm);
 192   
 193  equation
 194      difference1(run,c)
 195      difference2(run,c)
 196      difference3(run,c)
 197      difference4(run)
 198   
 199  ;
 200   
 201  difference1(prevrun,c).. absdiff(prevrun,c,'+')-absdiff(prevrun,c,'-') =e= prevrect(prevrun,'pos',c) - rect('pos',c);
 202  difference2(prevrun,c).. absdiff(prevrun,c,'+') =l= bindiff(prevrun,c)*maxsize;
 203  difference3(prevrun,c).. absdiff(prevrun,c,'-') =l= (1-bindiff(prevrun,c))*maxsize;
 204  difference4(prevrun).. sum((c,pm),absdiff(prevrun,c,pm)) =g= difftol;
 205   
 206   
 207  model maxrectangle2 /maxrectangle,difference1,difference2,difference3,difference4/;
 208   
 209   
 210  prevrect(run,'pos',c) = 0;
 211  prevrun(run) = no;
 212  loop(run,
 213     solve maxrectangle2 maximizing t using miqcp;
 214     display rect.l;
 215     prevrect(run,'pos',c) = rect.l('pos',c);
 216     prevrect(run,'side',c) = rect.l('side',c);
 217     prevrun(run) = yes;
 218     display prevrect;
 219  );
 220   
 221   
 222   
 223  *---------------------------------------------------------------------
 224  * visualization
 225  *---------------------------------------------------------------------
 226   
 229   
 231   
 232   
 233  file fdata /data.js/; put fdata;
 234   
 235  * points
 236  put "p=["/;
 237  loop(i,
 238    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,"},"/;
 239  );
 240  put "]"/;
 241  put "pnts={n:",(card(i)):0:0,
 242         ",map:'[0,",maxsize:0:0,"]&times;[0,",maxsize:0:0,"]'",
 243         ",minx:",(smin(i,p(i,'x'))):0:3,
 244         ",miny:",(smin(i,p(i,'y'))):0:3,
 245         ",maxx:",(smax(i,p(i,'x'))):0:3,
 246         ",maxy:",(smax(i,p(i,'y'))):0:3,
 247         ",avgx:",(sum(i,p(i,'x'))/card(i)):0:3,
 248         ",avgy:",(sum(i,p(i,'y'))/card(i)):0:3,
 249         "}"/;
 250  put "sq={x:",square('x'):0:3,
 251        ",y:",square('y'):0:3,
 252        ",side:",square('side'):0:3,
 253        ",area:",(sqr(square('side'))):0:3,
 254        "}"/;
 255  put "d={x:",diamond('x'):0:3,
 256         ",y:",diamond('y'):0:3,
 257         ",area:",diamond('area'):0:3,
 258         ",side:",diamond('side'):0:3,
 259         ",diagonal:",diamond('diagonal'):0:3,
 260         "}"/;
 261  put "r={x:",rectangle('pos','x'):0:3,
 262         ",y:",rectangle('pos','y'):0:3,
 263         ",sx:",rectangle('side','x'):0:3,
 264         ",sy:",rectangle('side','y'):0:3,
 265         ",a:",(rectangle('side','x')*rectangle('side','y')):0:3,"}"/;
 266  put "circle={x:",circle.l('x'):0:3,",y:",circle.l('y'):0:3,",r:",circle.l('r'):0:3,
 267          ",a:",(pi*sqr(circle.l('r'))):0:3,"}"/;
 268  put "rs=["/;
 269  loop(run,
 270    put "  {x:",prevrect(run,'pos','x'):0:3,
 271        ",y:",prevrect(run,'pos','y'):0:3,
 272        ",sx:",prevrect(run,'side','x'):0:3,
 273        ",sy:",prevrect(run,'side','y'):0:3,
 274        ",a:",(prevrect(run,'side','x')*prevrect(run,'side','y')):0:3,
 275        "},"/;
 276  );
 277  put "]"/;
 278   
 279  putclose;
 280   
 281   
 620   
 621  executetool 'win32.ShellExecute "plot.html"';
 622   
 624   
