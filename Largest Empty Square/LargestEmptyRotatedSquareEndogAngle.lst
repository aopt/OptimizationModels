G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
          Largest Empty Rotated Square.
          
          This version: endogenous angle
          This gives us a MINLP model.
       
   9   
  10   
  11   
  12  *---------------------------------------------------------------
  13  * options
  14  *---------------------------------------------------------------
  15   
  16  * 0: no plot
  17  * 1: produce HTML plot
  19   
  20  * baron, antigone don't have sin(),cos() functions, so we use scip for this example
  21  option minlp=xpress;
  22   
  23  option seed=12345;
  24   
  25  *---------------------------------------------------------------
  26  * data
  27  *---------------------------------------------------------------
  28   
  29  scalar maxsize 'size of the box' / 10 /;
  30   
  31  sets
  32     i     'points' /point1*point100/
  33     a     'square attributes' /x,y,s/
  34     c(a)  'coordinates' /x,y/
  35  ;
  36   
  37  parameter p(i,c) 'points';
  38  p(i,c) = uniform(0,maxsize);
  39  display p;
  40   
  41   
  42  *---------------------------------------------------------------
  43  * MINLP MODEL
  44  *---------------------------------------------------------------
  45   
  46  scalars  M  'big-M';
  47  M = 2 * maxSize;
  48   
  49  set
  50     case 'for comparison' /less,greater/
  51     corners /00,01,10,11/
  52  ;
  53  table offset(corners,c) 'unit offset of corner points from lower-left'
  54          x  y
  55      00  0  0
  56      01  0  1
  57      10  1  0
  58      11  1  1
  59  ;
  60   
  61  variable
  62     q(i,c) 'transformed data points: rotate by -theta'
  63     sq(a) 'square location and size (transformed coordinates)'
  64     sq2(corners,c) 'corner points (original coordinates)'
  65     theta 'angle of rotation'
  66  ;
  67  q.lo(i,c) = -2*maxsize;
  68  q.up(i,c) = 2*maxsize;
  69   
  70  theta.lo = 0;
  71  theta.up = 90*pi/180;
  72   
  73  sq.lo(a) = -2*maxsize;
  74  sq.up(a) = 2*maxsize;
  75   
  76  sq2.lo(corners,c) = 0;
  77  sq2.up(corners,c) = maxsize;
  78   
  79  binary variable d(i,c,case) 'd=1 means: relax no-overlap constraint';
  80  variable z 'objective';
  81   
  82  Equations
  83     transfdatax(i) 'transform data points: x coordinate'
  84     transfdatay(i) 'transform data points: y coordinate'
  85     emptysq1(i,c)  'no-overlap constraint: less-than version'
  86     emptysq2(i,c)  'no-overlap constraint: greater-than version'
  87     sumd(i)        '(at least) one no-overlap constraint must hold'
  88     transformx     "transform x',y' -> x back to original coordinates"
  89     transformy     "transform x',y' -> y back to original coordinates"
  90     objsq          'objective'
  91  ;
  92   
  93  * transform data points
  94  transfdatax(i).. q(i,'x') =e=  p(i,'x')*cos(theta) + p(i,'y')*sin(theta);
  95  transfdatay(i).. q(i,'y') =e= -p(i,'x')*sin(theta) + p(i,'y')*cos(theta);
  96   
  97   
  98  * this is like the original axis-aligned square model
  99  objsq.. z =e= sq('s');
 100  emptysq1(i,c).. q(i,c) =l= sq(c) + d(i,c,'less')*M;
 101  emptysq2(i,c).. q(i,c) =g= sq(c) + sq('s') - d(i,c,'greater')*M;
 102  sumd(i)..  sum((c,case),d(i,c,case)) =e= 3;
 103   
 104  * transform back to original coordinates
 105  transformx(corners).. sq2(corners,'x') =e= (sq('x')+offset(corners,'x')*sq('s'))*cos(theta) - (sq('y')+offset(corners,'y')*s
      q('s'))*sin(theta);
 106  transformy(corners).. sq2(corners,'y') =e= (sq('x')+offset(corners,'x')*sq('s'))*sin(theta) + (sq('y')+offset(corners,'y')*s
      q('s'))*cos(theta);
 107   
 108  *theta.fx = 0;
 109  *theta.fx = 25*pi/180;
 110  *theta.fx = 45*pi/180;
 111   
 112  model emptysquare /all/;
 113  solve emptysquare maximizing z using minlp;
 114   
 115  display theta.l, sq.l, sq2.l;
 116   
 117   
 118  parameter square(*,*) 'optimal values';
 119  square(corners,c) = sq2.l(corners,c);
 120  square('side','-') = sq.l('s');
 121  square('area','-') = sqr(square('side','-'));
 122  display square;
 123   
 124   
 125  *---------------------------------------------------------------------
 126  * visualization
 127  *---------------------------------------------------------------------
 128   
 131   
 133   
 134   
 135  file fdata /data.js/; put fdata;
 136   
 137  * points
 138  put "p=["/;
 139  loop(i,
 140    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,"},"/;
 141  );
 142  put "]"/;
 143   
 144  put "box={x:0,y:0,size:",maxsize:0:4,"}"/;
 145  put "angle=",theta.l:0:4/;
 146  put "angledeg=",(theta.l*180/pi):0:4/;
 147  put "side=",square('side','-'):0:4/;
 148  put "area=",square('area','-'):0:4/;
 149   
 150   
 151  put "cp=["/;
 152  loop(corners,
 153    put "  {k:'",corners.tl:0,"',x:",square(corners,'x'):0:4,",y:",square(corners,'y'):0:4,"},"/;
 154  );
 155  put "]"/;
 156  putclose;
 157   
 158   
 263   
 264  executetool 'win32.ShellExecute "plot.html"';
 265   


