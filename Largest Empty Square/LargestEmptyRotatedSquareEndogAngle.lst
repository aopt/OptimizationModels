GAMS 53.1.0  6a03d3b9 Feb 16, 2026          WEX-WEI x86 64bit/MS Windows - 05/20/26 02:12:09 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
          Largest Empty Rotated Square.
          
          This version: endogenous angle
          This gives us a MINLP or MIQCP model.
       
   9   
  10   
  11   
  12  *---------------------------------------------------------------
  13  * options
  14  *---------------------------------------------------------------
  15   
  16  * 0: no plot
  17  * 1: produce HTML plot
  19   
  20  * baron, antigone don't have sin(),cos() functions, so we use xpress and gurobi for this example
  21  option minlp=xpress,miqcp=xpress;
  22  *option minlp=gurobi,miqcp=gurobi;
  23   
  24  option seed=12345;
  25   
  26  *---------------------------------------------------------------
  27  * data
  28  *---------------------------------------------------------------
  29   
  30  scalar maxsize 'size of the outer box' / 10 /;
  31   
  32  sets
  33     i     'points' /point1*point100/
  34     a     'square attributes' /x,y,s/
  35     c(a)  'coordinates' /x,y/
  36  ;
  37   
  38  parameter p(i,c) 'points';
  39  p(i,c) = uniform(0,maxsize);
  40  display p;
  41   
  42   
  43  *---------------------------------------------------------------
  44  * MINLP model with angles
  45  *---------------------------------------------------------------
  46   
  47  scalars  M  'big-M';
  48  M = 2 * maxSize;
  49   
  50  set
  51     case    'for comparison' /less,greater/
  52     corners 'enumerate four corners' /00,01,10,11/
  53  ;
  54  table offset(corners,c) 'unit offset of corner points from lower-left'
  55          x  y
  56      00  0  0
  57      01  0  1
  58      10  1  0
  59      11  1  1
  60  ;
  61   
  62   
  63  variable
  64     q(i,c) 'transformed data points: rotate by -theta'
  65     sq(a) 'square location and size (transformed coordinates)'
  66     sq2(corners,c) 'corner points (original coordinates)'
  67     theta 'angle of rotation'
  68  ;
  69  q.lo(i,c) = -2*maxsize;
  70  q.up(i,c) = 2*maxsize;
  71   
  72  theta.lo = 0;
  73  theta.up = 90*pi/180 - 0.00001;
  74   
  75  sq.lo(a) = -2*maxsize;
  76  sq.up(a) = 2*maxsize;
  77   
  78  sq2.lo(corners,c) = 0;
  79  sq2.up(corners,c) = maxsize;
  80   
  81  binary variable d(i,c,case) 'd=1 means: relax no-overlap constraint';
  82  variable z 'objective';
  83   
  84  Equations
  85     transfdatax(i)          'transform data points: x coordinate'
  86     transfdatay(i)          'transform data points: y coordinate'
  87     emptysq1(i,c)           'no-overlap constraint: less-than version'
  88     emptysq2(i,c)           'no-overlap constraint: greater-than version'
  89     sumd(i)                 '(at least) one no-overlap constraint must hold'
  90     transformx(corners)     "transform x',y' -> x back to original coordinates"
  91     transformy(corners)     "transform x',y' -> y back to original coordinates"
  92     objsq                   'objective'
  93  ;
  94   
  95  * transform data points
  96  transfdatax(i).. q(i,'x') =e=  p(i,'x')*cos(theta) + p(i,'y')*sin(theta);
  97  transfdatay(i).. q(i,'y') =e= -p(i,'x')*sin(theta) + p(i,'y')*cos(theta);
  98   
  99   
 100  * this is like the original axis-aligned square model
 101  objsq.. z =e= sq('s');
 102  emptysq1(i,c).. q(i,c) =l= sq(c) + d(i,c,'less')*M;
 103  emptysq2(i,c).. q(i,c) =g= sq(c) + sq('s') - d(i,c,'greater')*M;
 104  sumd(i)..  sum((c,case),d(i,c,case)) =e= 3;
 105   
 106  * transform back to original coordinates
 107  transformx(corners).. sq2(corners,'x') =e= (sq('x')+offset(corners,'x')*sq('s'))*cos(theta) - (sq('y')+offset(corners,'y')*s
      q('s'))*sin(theta);
 108  transformy(corners).. sq2(corners,'y') =e= (sq('x')+offset(corners,'x')*sq('s'))*sin(theta) + (sq('y')+offset(corners,'y')*s
      q('s'))*cos(theta);
 109   
 110   
 111  * to simulate earlier runs
 112  *theta.fx = 0;
 113  *theta.fx = 25*pi/180;
 114  *theta.fx = 45*pi/180;
 115   
 116  model emptysquare1 /all/;
 117  solve emptysquare1 maximizing z using minlp;
 118   
 119  display theta.l, sq.l, sq2.l;
 120   
 121   
 122  parameter m1results(*,*) 'optimal values model 1';
 123  m1results(corners,c) = sq2.l(corners,c);
 124  m1results('side','-') = sq.l('s');
 125  m1results('area','-') = sqr(m1results('side','-'));
 126  m1results('angle (rad)','-') = theta.l;
 127  m1results('angle (deg)','-') = theta.l * 180 / pi;
 128  display m1results;
 129   
 130  *---------------------------------------------------------------
 131  * MIQCP model without angles
 132  *---------------------------------------------------------------
 133   
 134  * reset variable levels so we don't have a good starting point for the MIQCP model
 135  * just in case the solver would use these
 136  sq.l(a) = 0;
 137  sq2.l(corners,c) = 0;
 138  d.l(i,c,case) = 0;
 139  q.l(i,c) = 0;
 140   
 141  variables
 142      sintheta 'sine of angle'
 143      costheta 'cosine of angle'
 144  ;
 145  * note: angle is between 0 and 0.5pi, so cos and sin are nonnegative
 146  costheta.lo = 1e-6;
 147  sintheta.lo = 0;
 148  costheta.up = 1;
 149  sintheta.up = 1;
 150   
 151  equations
 152     transfdata2x(i)           'transform data points: x coordinate'
 153     transfdata2y(i)           'transform data points: y coordinate'
 154     transform2x(corners)      "transform x',y' -> x back to original coordinates"
 155     transform2y(corners)      "transform x',y' -> y back to original coordinates"
 156     sincos                    'unit circle constraint'
 157  ;
 158   
 159  * transform data points
 160  transfdata2x(i).. q(i,'x') =e=  p(i,'x')*costheta + p(i,'y')*sintheta;
 161  transfdata2y(i).. q(i,'y') =e= -p(i,'x')*sintheta + p(i,'y')*costheta;
 162   
 163  * transform back to original coordinates
 164  transform2x(corners).. sq2(corners,'x') =e= (sq('x')+offset(corners,'x')*sq('s'))*costheta - (sq('y')+offset(corners,'y')*sq
      ('s'))*sintheta;
 165  transform2y(corners).. sq2(corners,'y') =e= (sq('x')+offset(corners,'x')*sq('s'))*sintheta + (sq('y')+offset(corners,'y')*sq
      ('s'))*costheta;
 166   
 167  sincos.. sqr(costheta) + sqr(sintheta) =e= 1;
 168   
 169  model emptysquare2 /all-transfdatax-transfdatay-transformx-transformy/;
 170  solve emptysquare2 maximizing z using miqcp;
 171   
 172   
 173  scalar angle;
 174  * recover the angle from the sine and cosine values
 175  angle = arctan(sintheta.l/costheta.l);
 176   
 177  display angle,sintheta.l, costheta.l, sq.l, sq2.l;
 178   
 179  parameter m2results(*,*) 'optimal values model 2';
 180  m2results(corners,c) = sq2.l(corners,c);
 181  m2results('side','-') = sq.l('s');
 182  m2results('area','-') = sqr(m2results('side','-'));
 183  m2results('angle (rad)','-') = angle;
 184  m2results('angle (deg)','-') = angle * 180 / pi;
 185  display m1results,m2results;
 186   
 187  parameter perf(*,*) 'performance comparison';
 188  $macro modelperf(m,s) \
 189     perf(s,'#vars') = m.numvar;\
 190     perf(s,'#dvars') = m.numdvar;\
 191     perf(s,'#equs') = m.numequ;\
 192     perf(s,'obj') = m.objval;\
 193     perf(s,'time') = m.resusd;\
 194     perf(s,'its') = m.iterusd;\
 195     perf(s,'nodes') = m.nodusd;
 196   perf('model 1','#vars') = emptysquare1.numvar;perf('model 1','#dvars') = emptysquare1.numdvar;perf('model 1','#equs') = emp
      tysquare1.numequ;perf('model 1','obj') = emptysquare1.objval;perf('model 1','time') = emptysquare1.resusd;perf('model 1','it
      s') = emptysquare1.iterusd;perf('model 1','nodes') = emptysquare1.nodusd;
 197   perf('model 2','#vars') = emptysquare2.numvar;perf('model 2','#dvars') = emptysquare2.numdvar;perf('model 2','#equs') = emp
      tysquare2.numequ;perf('model 2','obj') = emptysquare2.objval;perf('model 2','time') = emptysquare2.resusd;perf('model 2','it
      s') = emptysquare2.iterusd;perf('model 2','nodes') = emptysquare2.nodusd;
 198  display perf;
 199   
 200  *---------------------------------------------------------------
 201  * visualization
 202  *---------------------------------------------------------------
 203   
 206   
 208   
 209   
 210  file fdata /data.js/; put fdata;
 211   
 212  * points
 213  put "p=["/;
 214  loop(i,
 215    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,"},"/;
 216  );
 217  put "]"/;
 218   
 219  put "box={x:0,y:0,size:",maxsize:0:4,"}"/;
 220  put "angle=",m1results('angle (rad)','-'):0:4/;
 221  put "angledeg=",m1results('angle (deg)','-'):0:4/;
 222  put "side=",m1results('side','-'):0:4/;
 223  put "area=",m1results('area','-'):0:4/;
 224   
 225   
 226  put "cp=["/;
 227  loop(corners,
 228    put "  {k:'",corners.tl:0,"',x:",m1results(corners,'x'):0:4,",y:",m1results(corners,'y'):0:4,"},"/;
 229  );
 230  put "]"/;
 231  putclose;
 232   
 233   
 338   
 339  executetool 'win32.ShellExecute "plot.html"';
 340   


