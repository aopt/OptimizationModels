C o m p i l a t i o n


       
         Calculate convex hull of a set of points using an MINLP or MIP model
       
   6   
   7  option seed = 12345;
   8   
   9  option minlp=baron, mip=cplex;
  10   
  11  *-----------------------------------------------------
  12  * data
  13  *-----------------------------------------------------
  14   
  15  set
  16     i 'data points' /point1*point15/
  17     k 'coordinates' /x,y/
  18  ;
  19   
  20  parameter p(*,*) 'data points';
  21  p(i,k) = uniform(0,10);
  22  display p;
  23   
  24  *-----------------------------------------------------
  25  * convex hull python code
  26  *-----------------------------------------------------
  27   
  28  set hull(i) 'convex hull computed by scipy';
  29   
  30  embeddedCode Python:
  31  import scipy as sp
  32  import numpy as np
  33  import gams.transfer as gt
  34   
  35  print("Computing convex hull...")
  36  i = list(gams.get("i"))
  37  p = gt.Container(gams.db)["p"].toDense()
  38  hull = sp.spatial.ConvexHull(p)
  39  h = [i[pt] for pt in hull.vertices]
  40  gams.set("hull",h)
  41  endEmbeddedCode hull
  42   
  43  display hull;
  44   
  45  p(i,'hull/scipy') = hull(i);
  46  p('count','hull/scipy') = card(hull);
  47  display p;
  48   
  49   
  50  *-----------------------------------------------------
  51  * minlp convex hull model
  52  *-----------------------------------------------------
  53   
  54  alias(i,j);
  55   
  56  variable
  57    lambda(i,j) 'weights'
  58  ;
  59  lambda.lo(i,j) = 0;
  60  lambda.up(i,j) = 1;
  61  lambda.fx(i,i) = 0;
  62   
  63  variable z 'objective';
  64   
  65  binary variable
  66     h(i)    'hull'
  67     nh(i)   'interior'
  68  ;
  69   
  70  Equation
  71     choose(i)     'point is either hull or interior'
  72     inside(i,k)   'convex combination, only for nh(i)=1'
  73     sum_lambda(i) 'normalize weights, only fot n(i)=1'
  74     count         'number of hull points'
  75  ;
  76   
  77  choose(i).. h(i)+nh(i) =e= 1;
  78   
  79  inside(i,k)..
  80      p(i,k)*nh(i) =e= sum(j, lambda(i,j)*p(j,k)*h(j));
  81   
  82  sum_lambda(i).. sum(j, lambda(i,j)*h(j)) =e= nh(i);
  83   
  84  count.. z =e= sum(i, h(i));
  85   
  86  model m /all/;
  87   
  88   
  89  solve m minimizing z using minlp;
  90   
  91  display h.l,nh.l,lambda.l;
  92   
  93  p(i,'hull/minlp') = h.l(i)>0.5;
  94  p('count','hull/minlp') = sum(i$(h.l(i)>0.5),1);
  95  display p;
  96   
  97   
  98  *-----------------------------------------------------
  99  * mip convex hull model
 100  *-----------------------------------------------------
 101   
 102  Equations
 103     lambda_bnd(i,j) 'h(j)=0 => lambda(i,j)=0'
 104     inside2(i,k)    'linearization uses lambda_bnd'
 105     sum_lambda2     'linear version'
 106  ;
 107   
 108  lambda_bnd(i,j)..  lambda(i,j) =l= h(j);
 109  inside2(i,k)..     p(i,k)*nh(i) =e= sum(j, lambda(i,j)*p(j,k));
 110  sum_lambda2(i)..   sum(j, lambda(i,j)) =e= nh(i);
 111   
 112  model m2 /choose,lambda_bnd,inside2,sum_lambda2,count/;
 113  solve m2 minimizing z using mip;
 114   
 115  display h.l,lambda.l;
 116   
 117  p(i,'hull/mip') = h.l(i)>0.5;
 118  p('count','hull/mip') = sum(i$(h.l(i)>0.5),1);
 119  display p;
 120   


