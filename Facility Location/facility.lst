      </tr>'/;
 410  put '<tr><td>Max distance</td><td align="right"><pre>',res2('max distance'):8:3,'</pre></td></
      tr>'/;
 411  put '<tr><td>Binary variables</td><td align="right"><pre>',res2('binary variables'):0:0,'</pre
      ></td></tr>'/;
