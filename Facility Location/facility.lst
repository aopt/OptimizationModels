GAMS 49.1.0  5c4d4ed6 Feb 15, 2025          WEX-WEI x86 64bit/MS Windows - 04/24/25 12:25:22 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
       Continuous Facility Location
       
       Model 1:
       Find number of facilities needed to service all customers with
       constraint on the distance between facility and customer.
       
       Model 2:
       Given the number of facilities found in model 1, find an optimal
       location of these facilities (by minimizing the sum of squared
       distances) and the optimal assignment of customers to
       facilities.
       
       Model 3:
       We can minimize the distances using a MISOCP (Mixed-Integer
       Second Order Cone program). This takes forever for n=75
       so we skip this here.
       
       Model 4:
       This is a Medoid version: the candidate locations are the
       demand points. This is formulated as a multi-objective
       model, but we can run the objectives (min facilities,
       min sum distances) separately by changing the weights.
       
       Model 5:
       Produce efficient frontier between maxDist and numFacs
       based on Medoid model 4.
       
       Reporting is done using HTML + Plotly. 
       
       
  34   
  35   
  36  option reslim=1000;
  37  option miqcp=cplex;
  38  option seed=12345;
  39   
  40  * third model (MISOCP) is very expensive
  41  * it is better to skip this
  42  * runmodel3=0 : skip model 3
  43  * runmodel3<>0 : run model 3
  45   
  46  * enable (1) or disable (0) symmetry breakers
  48   
  49  * set to 0 if no HTML report
  51   
  52  *-----------------------------------------------------------------------------------------
  53  * data
  54  *-----------------------------------------------------------------------------------------
  55   
  56  Sets
  57     dummy 'for ordering of displays' /numFacs,MaxDist,time/
  58     i 'demand points'        /demand1*demand75/
  59     j 'possible facilities'  /facility1*facility10/
  60     c 'coordinates'          /x,y/
  61  ;
  62   
  63  Parameters
  64     dloc(*,c) 'demand point locations'
  65     maxDist   'maximum distance allowed between facility and demand point (for 1x1 map)' /0.25/
  66     wh        'width and height of our region' /1/
  67     symm      "0:don't use 1:use symmetry breakers" /1/
  68  ;
  69   
  70  maxDist = maxDist*wh;
  71   
  72  dloc(i,c) = uniform(0,wh);
  73  dloc('min',c) = smin(i,dloc(i,c));
  74  dloc('max',c) = smax(i,dloc(i,c));
  75  display maxDist,dloc;
  76   
  77  *-----------------------------------------------------------------------------------------
  78  * model 1: find minimum number of facilities needed
  79  *          we put some effort into finding small big-M values
  80  *          this is a bit of overkill
  81  *-----------------------------------------------------------------------------------------
  82   
  83   
  84  *
  85  * for proper big M calculation we need to know farthest possible distances
  86  *
  87  sets
  88    LU 'lower or upper' /L,U/
  89    b(LU,LU) 'box' /L.L, L.U, U.L, U.U/
  90  ;
  91  alias (LU,LUx,LUy);
  92  Parameters
  93      corners(LU,LU,c) 'corners of box for facility locations'
  94      farthest(i) 'max possible squared distance between demand point i and possible location of
       facility'
  95  ;
  96  corners('L',LUy,'x') = dloc('min','x');
  97  corners('U',LUy,'x') = dloc('max','x');
  98  corners(LUx,'L','y') = dloc('min','y');
  99  corners(LUx,'U','y') = dloc('max','y');
 100  display corners;
 101   
 102  farthest(i) = smax(b,sum(c,sqr(dloc(i,c)-corners(b,c))));
 103  display farthest;
 104   
 105   
 106  *
 107  * model 1:  MIQCP
 108  *
 109  variables
 110      floc(j,c)   'facility locations'
 111      isOpen(j)   'facility is being used'
 112      assign(i,j) 'assign customers to facility'
 113      nOpen       'number of open facilities'
 114  ;
 115  binary variables isOpen,assign;
 116   
 117  equations
 118     distance(i,j)   'squared distance equation'
 119     assignDemand(i) 'assign customer to exactly one facility'
 120     closed(i,j)     'do not assign customers to closed facilties'
 121     numFacilities   'number of open facilities'
 122     order(j)        'optional: open facilities are first ones'
 123  ;
 124   
 125  distance(i,j).. sum(c, sqr(dloc(i,c)-floc(j,c))) =l= sqr(maxDist)*assign(i,j) + farthest(i)*(1
      -assign(i,j));
 126   
 127  assignDemand(i).. sum(j, assign(i,j)) =e= 1;
 128   
 129  closed(i,j).. assign(i,j) =l= isOpen(j);
 130   
 131  numFacilities.. nOpen =e= sum(j, isOpen(j));
 132   
 133  order(j+1)$symm.. isOpen(j) =g= isOpen(j+1);
 134   
 135  * facility locations should be inside the box formed by the demand points
 136  floc.lo(j,c) = smin(b,corners(b,c));
 137  floc.up(j,c) = smax(b,corners(b,c));
 138   
 139  *
 140  * solve
 141  *
 142  model m1 /all/;
 143  solve m1 minimizing nOpen using miqcp;
 144  abort$(m1.modelstat <> 1 and m1.modelstat <> 8) "No solution";
 145   
 146   
 147  *
 148  * collect results
 149  *
 150  set f(j) 'open facilities';
 151  f(j) = isOpen.l(j)>0.5;
 152  display nOpen.l,j,f;
 153   
 154  parameter res1(*) 'results model 1';
 155  res1('facilities needed (min)') = round(nOpen.l);
 156  res1('sum squared distances') = sum((i,j)$(assign.l(i,j)>0.5),sum(c, sqr(dloc(i,c)-floc.l(j,c)
      )));
 157  res1('max squared distance') = smax((i,j)$(assign.l(i,j)>0.5),sum(c, sqr(dloc(i,c)-floc.l(j,c)
      )));
 158  res1('sum distances') = sum((i,j)$(assign.l(i,j)>0.5),sqrt(sum(c, sqr(dloc(i,c)-floc.l(j,c))))
      );
 159  res1('max distance') = smax((i,j)$(assign.l(i,j)>0.5),sqrt(sum(c, sqr(dloc(i,c)-floc.l(j,c))))
      );
 160  res1('solver time') = m1.resusd;
 161  res1('nodes') = m1.nodusd;
 162  res1('binary variables') = m1.numdvar;
 163  display res1;
 164   
 165  set assign1(i,j) 'model1 results';
 166  assign1(i,j) = assign.l(i,j)>0.5;
 167   
 168  parameter floc1(j,c) 'model1 results';
 169  floc1(f,c) = floc.l(f,c);
 170   
 171   
 172  *-----------------------------------------------------------------------------------------
 173  * model 2: find optimal assignment of customer to open facilities
 174  *          minimize sum of squared distances
 175  *-----------------------------------------------------------------------------------------
 176   
 177   
 178  positive variable d2(i,j) 'squared distance between customer and facility';
 179   
 180  variable totdist2 'sum of squared distances';
 181   
 182  equations
 183     distance2(i,j)   'squared distance equation'
 184     assignDemandf(i) 'assign customer to exactly one facility'
 185     objective2       'minimize sum of squared distances'
 186     orderx(j)        'order by x coordinate'
 187  ;
 188   
 189  objective2.. totdist2 =e= sum((i,f),d2(i,f));
 190   
 191  distance2(i,f).. d2(i,f) =g= sum(c, sqr(dloc(i,c)-floc(f,c))) - farthest(i)*(1-assign(i,f));
 192   
 193  assignDemandf(i).. sum(f, assign(i,f)) =e= 1;
 194   
 195  orderx(j+1)$(f(j) and symm).. floc(j,'x') =l= floc(j+1,'x');
 196   
 197  d2.up(i,f) = sqr(maxDist);
 198   
 199  model m2 /objective2,distance2,assignDemandf,orderx/;
 200  solve m2 minimizing totdist2 using miqcp;
 201  abort$(m2.modelstat <> 1 and m2.modelstat <> 8) "No solution";
 202   
 203  display totdist2.l, assign.l
 204   
 205  parameter res2(*) 'results model 2';
 206  res2('sum squared distances (min)') = sum((i,f)$(assign.l(i,f)>0.5),sum(c, sqr(dloc(i,c)-floc.
      l(f,c))));
 207  res2('max squared distance') = smax((i,f)$(assign.l(i,f)>0.5),sum(c, sqr(dloc(i,c)-floc.l(f,c)
      )));
 208  res2('sum distances') = sum((i,f)$(assign.l(i,f)>0.5),sqrt(sum(c, sqr(dloc(i,c)-floc.l(f,c))))
      );
 209  res2('max distance') = smax((i,f)$(assign.l(i,f)>0.5),sqrt(sum(c, sqr(dloc(i,c)-floc.l(f,c))))
      );
 210  res2('solver time') = m2.resusd;
 211  res2('nodes') = m2.nodusd;
 212  res2('binary variables') = m2.numdvar;
 213  display res2;
 214   
 215  set assign2(i,j) 'model2 results';
 216  assign2(i,f) = assign.l(i,f)>0.5;
 217   
 218  parameter floc2(j,c) 'model2 results';
 219  floc2(f,c) = floc.l(f,c);
 220   
 221   
 222  *-----------------------------------------------------------------------------------------
 223  * model 3: find optimal assignment of customer to open facilities
 224  *          minimize sum of distances
 225  *          MISOCP formulation
 226  * this is too slow for larger data sets
 227  *-----------------------------------------------------------------------------------------
 228   
 230   
 231   
 232  *-----------------------------------------------------------------------------------------
 233  * Model 4: k-mediods model
 234  *-----------------------------------------------------------------------------------------
 235   
 236  alias (i,ii);
 237  parameter dist(i,ii) 'any distance measure, here the euclidean distance';
 238  dist(i,ii) = sqrt(sum(c, sqr(dloc(i,c)-dloc(ii,c))));
 239   
 240  scalars
 241     w1 'obj weight: distance'
 242     w2 'obj weight: number of facilities'
 243  ;
 244   
 245  binary variables
 246     facSelect(i) 'select point i as facility'
 247     assigni(i,ii) 'assign demand point i to facility ii'
 248  ;
 249   
 250  positive variables
 251      totDist  'obj1: sum of distances'
 252      numFacs  'obj2: number of facilities'
 253  ;
 254   
 255  variable z 'objective';
 256   
 257  Equations
 258     objMultiple 'weighted sum objective'
 259     objDist     'obj1: sum of distances'
 260     objNumFacs  'obj2: number of facilities'
 261     eAssign(i)  'each customer must be assigned to one facility'
 262     close(i,i)  'if point i is not a facility, then we can not serve customers from there'
 263  ;
 264   
 265  set ok(i,ii) 'allowed assignments';
 266  ok(i,ii) =  sqrt(sum(c, sqr(dloc(i,c)-dloc(ii,c)))) <= maxDist;
 267   
 268  * bi-objective
 269  objMultiple.. z =e= w1*totDist+w2*numFacs;
 270  objDist..     totDist =e= sum(ok(i,ii),dist(ok)*assigni(ok));
 271  objNumFacs..  numFacs =e= sum(i,facSelect(i));
 272   
 273  * constraints
 274  eAssign(i)..  sum(ok(i,ii),assigni(ok)) =e= 1;
 275  close(ok(i,ii)).. assigni(ok) =l= facSelect(ii);
 276   
 277  model m4 /objMultiple,objDist,objNumFacs,eAssign,close/;
 278   
 279  parameter res4(*) 'results model 4';
 280   
 281  * we solve in two phases:
 282  * 1. minimize number of facilities needed
 283  * 2. fix numFacs and minimize sum of distances
 284   
 285  w1 = 0; w2 = 1;
 286  solve m4 minimizing z using mip;
 287  display numfacs.l;
 288  res4('solver time (min numFacs)') = m4.resusd;
 289  res4('nodes (min numFacs)') = m4.nodusd;
 290  res4('binary variables (min numFacs)') = m4.numdvar;
 291  res4('number of facilities') = round(numFacs.l);
 292   
 293  numfacs.fx = round(numfacs.l);
 294  w1 = 1; w2 = 0;
 295  solve m4 minimizing z using mip;
 296  res4('solver time (min totDist)') = m4.resusd;
 297  res4('nodes (min totDist)') = m4.nodusd;
 298  res4('binary variables (min totDist)') = m4.numdvar;
 299   
 300   
 301  res4('sum squared distances') = sum(ok(i,ii)$(assigni.l(i,ii)>0.5),sum(c, sqr(dloc(i,c)-dloc(i
      i,c))));
 302  res4('max squared distance') = smax(ok(i,ii)$(assigni.l(i,ii)>0.5),sum(c, sqr(dloc(i,c)-dloc(i
      i,c))));
 303  res4('sum distances (min)') = sum(ok(i,ii)$(assigni.l(i,ii)>0.5),sqrt(sum(c, sqr(dloc(i,c)-dlo
      c(ii,c)))));
 304  res4('max distance') = smax(ok(i,ii)$(assigni.l(i,ii)>0.5),sqrt(sum(c, sqr(dloc(i,c)-dloc(ii,c
      )))));
 305  display res4;
 306   
 307  set assign4(i,i) 'model4 results';
 308  assign4(ok) = assigni.l(ok)>0.5;
 309   
 310  set facSelected(i) 'facilities selected';
 311  facSelected(i) = facSelect.l(i) > 0.5;
 312  display facSelected;
 313   
 314  parameter ordFac(i) 'numbering for coloring';
 315  ordFac(FacSelected) = facSelected.pos;
 316  display ordFac;
 317   
 318  *-----------------------------------------------------------------------------------------
 319  * Model 5: trace trade-off between max distance and number of facilities
 320  *-----------------------------------------------------------------------------------------
 321   
 322  variable zmaxdist 'objective: minimize maxdist';
 323   
 324  ok(i,ii) = yes;
 325   
 326  equations
 327  *   maxDistance(i,ii) 'assign(i,ii)=1 ==> dist(i,ii) <= maxdist'
 328     maxDistance(i) 'assign(i,ii)=1 ==> dist(i,ii) <= maxdist'
 329  ;
 330  scalar fxNumFacs 'fixed number of facilities';
 331   
 332  *maxDistance(i,ii).. assigni(i,ii)*dist(i,ii) =l= zmaxdist;
 333  maxDistance(i).. sum(ii,assigni(i,ii)*dist(i,ii)) =l= zmaxdist;
 334   
 335  zmaxDist.lo = 0;
 336   
 337  model m5 /maxDistance,objNumFacs,eAssign,close/;
 338   
 339  set k /k1*k10/;
 340  parameter m5results(k,*);
 341  loop (k,
 342     numFacs.fx = ord(k);
 343     solve m5 minimizing zmaxdist using mip;
 344     abort$(m5.modelstat <> 1 and m5.modelstat <> 8) "No solution";
 345     m5results(k,'numFacs') = ord(k);
 346     m5results(k,'maxDist') = zmaxdist.l;
 347     m5results(k,'time') = m5.resusd;
 348     m5results(k,'nodes') = m5.nodusd;
 349  );
 350  display m5results;
 351   
 352   
