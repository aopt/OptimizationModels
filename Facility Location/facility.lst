G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
       Continuous Facility Location
       
       Model 1:
       Find number of facilities needed to service all customers with
       constraint on the distance between facility and customer.
       
       Model 2:
       Given the number of facilities found in model 1, find an optimal
       location of these facilities (by minimizing the sum of squared
       distances) and the optimal assignment of customers to
       facilities.
       
  16   
  17  *-----------------------------------------------------------------------------------------
  18  * data
  19  *-----------------------------------------------------------------------------------------
  20   
  21  option seed = 12345;
  22   
  23  Sets
  24     i 'demand points' /demand1*demand75/
  25     j 'facilities'    /facility1*facility10/
  26     c 'coordinates'   /x,y/
  27  ;
  28   
  29  Parameters
  30     dloc(i,c) 'demand point locations'
  31     maxDist   'maximum distance allowed between facility and demand point' /0.25/
  32     wh        'width and height of our region' /1/
  33  ;
  34   
  35  dloc(i,c) = uniform(0,wh);
  36   
  37  *-----------------------------------------------------------------------------------------
  38  * model 1: find minimum number of facilities needed
  39  *-----------------------------------------------------------------------------------------
  40   
  41  scalar M 'big M constant';
  42  M = sqr(wh);
  43   
  44  variables
  45      floc(j,c)   'facility locations'
  46      isOpen(j)   'facility is being used'
  47      assign(i,j) 'assign customers to facility'
  48      nOpen       'number of open facilities'
  49  ;
  50  binary variables isOpen,assign;
  51   
  52  equations
  53     distance(i,j)   'squared distance equation'
  54     assignDemand(i) 'assign customer to exactly one facility'
  55     closed(i,j)     'do not assign customers to closed facilties'
  56     numFacilities   'number of open facilities'
  57     order(j)        'optional: open facilities are first ones'
  58  ;
  59   
  60  distance(i,j).. sum(c, sqr(dloc(i,c)-floc(j,c))) =l= sqr(maxDist) + M*(1-assign(i,j));
  61   
  62  assignDemand(i).. sum(j, assign(i,j)) =e= 1;
  63   
  64  closed(i,j).. assign(i,j) =l= isOpen(j);
  65   
  66  numFacilities.. nOpen =e= sum(j, isOpen(j));
  67   
  68  order(j+1).. isOpen(j) =g= isOpen(j+1);
  69   
  70  model m1 /all/;
  71  option miqcp=cplex;
  72  solve m1 minimizing nOpen using miqcp;
  73  abort$(m1.modelstat <> 1 and m1.modelstat <> 8) "No solution";
  74  display nOpen.l;
  75   
  76  parameter res1(*) 'results model 1';
  77  res1('facilities needed') = round(nOpen.l);
  78  res1('sum squared distances') = sum((i,j)$(assign.l(i,j)>0.5),sum(c, sqr(dloc(i,c)-floc.l(j,c))));
  79  res1('max squared distance') = smax((i,j)$(assign.l(i,j)>0.5),sum(c, sqr(dloc(i,c)-floc.l(j,c))));
  80  res1('solver time') = m1.resusd;
  81  res1('binary variables') = m1.numdvar;
  82  display res1;
  83   
  84  set f(j) 'open facilities';
  85  f(j) = isOpen.l(j)>0.5;
  86   
  87  set assign1(i,j) 'model1 results';
  88  assign1(i,j) = assign.l(i,j)>0.5;
  89   
  90  parameter floc1(j,c) 'model1 results';
  91  floc1(f,c) = floc.l(f,c);
  92   
  93  *-----------------------------------------------------------------------------------------
  94  * model 2: find optimal assignment of customer to open facilities
  95  *-----------------------------------------------------------------------------------------
  96   
  97   
  98  positive variable d(i,j) 'squared distance between customer and facility';
  99   
 100  variable totdist 'sum of squared distances';
 101   
 102  equations
 103     distance2(i,j)   'squared distance equation'
 104     assignDemand2(i) 'assign customer to exactly one facility'
 105     objective        'minimize sum of squared distances'
 106     orderx(j)        'order by x coordinate'
 107  ;
 108   
 109  objective.. totdist =e= sum((i,f),d(i,f));
 110   
 111  distance2(i,f).. d(i,f) =g= sum(c, sqr(dloc(i,c)-floc(f,c))) - M*(1-assign(i,f));
 112   
 113  assignDemand2(i).. sum(f, assign(i,f)) =e= 1;
 114   
 115  orderx(j+1)$f(j).. floc(j,'x') =l= floc(j+1,'x');
 116   
 117  d.up(i,f) = sqr(maxDist);
 118   
 119  model m2 /objective,distance2,assignDemand2/;
 120  solve m2 minimizing totdist using miqcp;
 121  abort$(m2.modelstat <> 1 and m2.modelstat <> 8) "No solution";
 122   
 123  display totdist.l, assign.l
 124   
 125  parameter res2(*) 'results model 2';
 126  res2('sum squared distances') = sum((i,f)$(assign.l(i,f)>0.5),sum(c, sqr(dloc(i,c)-floc.l(f,c))));
 127  res2('max squared distance') = smax((i,f)$(assign.l(i,f)>0.5),sum(c, sqr(dloc(i,c)-floc.l(f,c))));
 128  res2('solver time') = m2.resusd;
 129  res2('binary variables') = m2.numdvar;
 130  display res2;
 131   
 132  set assign2(i,j) 'model2 results';
 133  assign2(i,f) = assign.l(i,f)>0.5;
 134   
 135  parameter floc2(j,c) 'model2 results';
 136  floc2(f,c) = floc.l(f,c);
 137   
 138   
 139  *-----------------------------------------------------------------------------------------
 140  * visualization
 141  *-----------------------------------------------------------------------------------------
 142   
 145   
 146   
 147  file fdata /data.js/;
 148  put fdata;
 149  put "datatable=`"/;
 150  put '<table>'/;
 151  put '<tr><td>Demand points</td><td align="right"><pre>',card(i):0:0,'</pre></td></tr>'/;
 152  put '<tr><td>Map size (width and height)</td><td align="right"><pre>',wh:7:3,'</pre></td></tr>'/;
 153  put '<tr><td>Max distance customer → facility</td><td align="right"><pre>',maxDist:7:3,'</pre></td></tr>'/;
 154  put '<tr><td>Max squared distance customer → facility</td><td align="right"><pre>',sqr(maxDist):7:3,'</pre></td></tr>'/;
 155  put '</table>'/;
 156  put "`;"/;
 157  put "points=["/;
 158  loop(i,
 159     put "{x:",dloc(i,'x'):6:4,",y:",dloc(i,'y'):6:4,"},"/;
 160  );
 161  put "];"/;
 162  put "m1table=`"/;
 163  put '<table>'/;
 164  put '<tr><td>Number facilities needed</td><td align="right"><pre>',res1('facilities needed'):0:0,'</pre></td></tr>'/;
 165  put '<tr><td>Sum squared distances</td><td align="right"><pre>',res1('sum squared distances'):7:3,'</pre></td></tr>'/;
 166  put '<tr><td>Max squared distance</td><td align="right"><pre>',res1('max squared distance'):7:3,'</pre></td></tr>'/;
 167  put '<tr><td>Solver time</td><td align="right"><pre>',res1('solver time'):7:3,'</pre></td></tr>'/;
 168  put '<tr><td>Binary variables</td><td align="right"><pre>',res1('binary variables'):0:0,'</pre></td></tr>'/;
 169  put '</table>'/;
 170  put "`;"/;
 171  put "floc1=["/;
 172  loop(f,
 173     put "{x:",floc1(f,'x'):6:4,",y:",floc1(f,'y'):6:4,"},"/;
 174  );
 175  put "];"/;
 176  put "assign1=["/;
 177  loop(assign1(i,f(j)),
 178     put "{i:",ord(i):0:0,",f:",ord(j):0:0,"},"/;
 179  );
 180  put "];"/;
 181  put "m2table=`"/;
 182  put '<table>'/;
 183  put '<tr><td>Sum squared distances</td><td align="right"><pre>',res2('sum squared distances'):7:3,'</pre></td></tr>'/;
 184  put '<tr><td>Max squared distance</td><td align="right"><pre>',res2('max squared distance'):7:3,'</pre></td></tr>'/;
 185  put '<tr><td>Solver time</td><td align="right"><pre>',res2('solver time'):7:3,'</pre></td></tr>'/;
 186  put '<tr><td>Binary variables</td><td align="right"><pre>',res2('binary variables'):0:0,'</pre></td></tr>'/;
 187  put '</table>'/;
 188  put "`;"/;
 189  put "floc2=["/;
 190  loop(f,
 191     put "{x:",floc2(f,'x'):6:4,",y:",floc2(f,'y'):6:4,"},"/;
 192  );
 193  put "];"/;
 194  put "assign2=["/;
 195  loop(assign2(i,f(j)),
 196     put "{i:",ord(i):0:0,",f:",ord(j):0:0,"},"/;
 197  );
 198  put "];"/;
 199   
 200  putclose;
