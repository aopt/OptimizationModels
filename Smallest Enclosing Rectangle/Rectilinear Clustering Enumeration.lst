C o m p i l a t i o n


       
         cluster points using axis-aligned rectangles
         
         1. Enumerate all rectangles
         2. Set Covering type of model
       
   9   
  10   
  11  *---------------------------------------------------------------
  12  * Settings
  13  *---------------------------------------------------------------
  14   
  15  option seed=12345;
  16   
  17  *---------------------------------------------------------------
  18  * data
  19  *---------------------------------------------------------------
  20   
  21  scalars
  22     maxsize 'size of the outer box' / 10 /
  23     k 'number of rectangles'   / 5 /
  24  ;
  25   
  26  sets
  27     i   'points' /point1*point50/
  28     r0  'base set rectangles' /rectangle1*rectangle100000/
  29     c   'coordinates' /x,y/
  30     lu  'lower/upper values' /min,max/
  31  ;
  32   
  33  parameter p(i,c) 'points';
  34  p(i,c) = uniform(0,maxsize);
  35  display p;
  36   
  37   
  38  *---------------------------------------------------------------
  39  * enumeration algorithm
  40  *---------------------------------------------------------------
  41   
  42  scalars
  43      n 'number of points'
  44      nr 'number of possible rectangles'
  45  ;
  46  n = card(i);
  47   
  48  sets
  49    r(r0) 'rectangles'
  50    contain(i,r0) 'point i is in rect r'
  51  ;
  52   
  53  Parameter
  54    rect(r0,c,lu) 'rectangle coordinates'
  55  ;
  56   
  57  * create dense data structure for export to Python
  58  p(i,c)$(p(i,c)=0) = EPS;
  59   
  60  EmbeddedCode Python:
  61   
  62  #
  63  # number of points
  64  #
  65   
  66  n = int(list(gams.get("n"))[0])
  67   
  68  #
  69  # get points and store as list of tuples (id,x,y)
  70  #
  71   
  72  pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
  73  points=[]
  74  for i in range(n):
  75      px = next(pgen)
  76      py = next(pgen)
  77      points.append((px[0],px[2],py[2]))
  78   
  79  #
  80  # import enumeration code
  81  #
  82   
  83  import sys
  84  sys.path.insert(0,'')
  85   
  86  import renumerate as renum
  87   
  88  print(f"renumerate {renum.version}")
  89   
  90  #
  91  # start working....
  92  #
  93  print(f"points:{n}")
  94  rects, mapped_points = renum.find_all_boundary_rectangles(points)
  95  print(f"rectangles:{len(rects)}")
  96   
  97  #
  98  # export to GAMS
  99  #
 100  gams.set('nr',[len(rects)])
 101  gams.set('r',list(rects.keys()))  
 102  gams.set('contain', [(p,r) for r in rects.keys() for p in rects[r]['covered_points']] )
 103   
 104  coord = []
 105  for r in rects:
 106      bounds = rects[r]['bounds']
 107      coord.append((r,'x','min',bounds['x_min']))
 108      coord.append((r,'x','max',bounds['x_max']))
 109      coord.append((r,'y','min',bounds['y_min']))
 110      coord.append((r,'y','max',bounds['y_max']))
 111  gams.set('rect',coord)  
 112   
 113   
 114  endEmbeddedCode nr,r,contain,rect
 115   
 116  abort$(nr>card(r0)) "set r0 is too small to store all rectangles";
 117   
 118  display nr;
 119   
 120  *---------------------------------------------------------------
 121  * calculate area and perimeter
 122  *---------------------------------------------------------------
 123   
 124  Parameters
 125      Area(r0)
 126      Perimeter(r0)
 127  ;
 128   
 129  Area(r) = prod(c,rect(r,c,'max')-rect(r,c,'min'));
 130  Perimeter(r) = 2*sum(c,rect(r,c,'max')-rect(r,c,'min'));
 131   
 132  *---------------------------------------------------------------
 133  * optimization
 134  *---------------------------------------------------------------
 135   
 136  binary variable
 137      select(r0)        'rectangle selection'
 138  ;
 139  variables
 140      totalArea        'objective'
 141      totalPerimeter   'objective'
 142  ;
 143   
 144  Equations
 145      obj1
 146      obj2
 147      cover(i)
 148      count
 149  ;
 150   
 151  obj1.. totalArea =e= sum(r, Area(r)*select(r));
 152  obj2.. totalPerimeter =e= sum(r, Perimeter(r)*select(r));
 153   
 154  cover(i)..  sum(contain(i,r), select(r)) =g= 1;
 155   
 156  count.. sum(r, select(r)) =e= k;
 157   
 158  model m1 /all-obj2/;
 159  model m2 /all-obj1/;
 160   
 161  solve m1 using mip minimizing totalArea;


