$onText

   Find smallest axis-aligned rectangle containing k out of n points.
     
   https://yetanothermathprogrammingconsultant.blogspot.com/2026/09/minimum-enclosing-rectangle-for-k-out.html
   
$offtext

*---------------------------------------------------------------
* options
*---------------------------------------------------------------

* 0: no plot
* 1: produce HTML plot)
$set htmlplot 1

option miqcp=antigone;

* don't stop on tolerance: we want global optimal solutions
option optcr=0;

option seed=12345;

*---------------------------------------------------------------
* data
*---------------------------------------------------------------

scalars
   maxsize 'size of the outer box' / 10 /
   k       'number of points to select' / 25 /
;

sets
   i   'points' /point1*point100/
   c   'coordinates' /x,y/
   lu  'lower/upper values' /min,max/
;

parameter p(i,c) 'points';
p(i,c) = uniform(0,maxsize);

option k:0,p:8;
display k,p;

*---------------------------------------------------------------
* derived data
*---------------------------------------------------------------

* bounding box for data points
parameter box(c,lu) 'min/max values';
box(c,'min') = smin(i, p(i,c));
box(c,'max') = smax(i, p(i,c));

display box;

*---------------------------------------------------------------
* model: enclose k points 
*---------------------------------------------------------------

binary variable delta(i) 'point is selected';

variable
   rect(c,lu) 'rectangle to contain k points'
   d(c)       'length of sides'
   area       'size of rectangle'    
;

* bounds
rect.lo(c,lu) = box(c,'min');
rect.up(c,lu) = box(c,'max');

d.lo(c) = 0;
d.up(c) = box(c,'max') - box(c,'min');


equations
    obj      'objective: area of enclosing rectangle'
    count    'number of points to select'
    inside_min(i,c)  'points are inside'
    inside_max(i,c)  'points are inside'
    calcd(c)         'calculate d' 
;

count..  sum(i, delta(i)) =e= k;

* inside: delta(i)=1  ==> rect(c,'min') <= p(i,c) <= rect(c,'max') 
inside_min(i,c)..  rect(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
inside_max(i,c)..  rect(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');

calcd(c).. d(c) =e= rect(c,'max')-rect(c,'min');

obj.. area =e= d('x')*d('y');

model m /all/;
solve m minimizing area using miqcp;
abort$(m.solvestat<>%solveStat.normalCompletion%) "Solver problem";

display rect.l,delta.l,area.l;


parameter solution(*,*) 'comparison';
solution('miqcp','area') = area.l;
solution('miqcp','xmin') = rect.l('x','min');
solution('miqcp','xmax') = rect.l('x','max');
solution('miqcp','ymin') = rect.l('y','min');
solution('miqcp','ymax') = rect.l('y','max');


*---------------------------------------------------------------------
* quick solution consistency check
* recalc area from delta variables
*---------------------------------------------------------------------

Scalars
  checktol 'tolerance for check' /1e-6/
  k2 'number of selected points'
  area2 'calculated from selected points'
  absdiff 'difference'  
;

k2 = sum(i,round(delta.l(i)));
area2 = prod(c, smax(i$(delta.l(i)>0.5), p(i,c)) - smin(i$(delta.l(i)>0.5), p(i,c)));
absdiff = abs(area.l-area2);

abort$(k2<>k) "number of selected points incorrect",k2;
abort$(absdiff > checktol) "solution check failed",absdiff;


*---------------------------------------------------------------------
* algorithm
*---------------------------------------------------------------------

scalar n 'number of data points';
n = card(i);

embeddedCode Python:

n = int(list(gams.get("n"))[0]);
k = int(list(gams.get("k"))[0]);
print(f"n={n},k={k}")

# get points and store as list of tuples (id,x,y)
points=[]
pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
for i in range(n):
    px = next(pgen)
    py = next(pgen)
    points.append((i+1,px[2],py[2]))

# the rest was largely generated by ChatGPT

y_values = sorted({y for _, _, y in points})

best = None

# Try every possible bottom and top edge.
for i, bottom in enumerate(y_values):
    for top in y_values[i:]:
        # Points inside this horizontal band, sorted by x.
        in_band = sorted(
            (x, number)
            for number, x, y in points
            if bottom <= y <= top
        )

        if len(in_band) < k:
            continue

        # Any minimal-width interval containing k points can be
        # represented by k consecutive points in this sorted list.
        for start in range(len(in_band) - k + 1):
            left = in_band[start][0]
            right = in_band[start + k - 1][0]
            width = right - left
            height = top - bottom
            area = width * height

            if best is None or area < best["area"]:
                best = {
                    "area": area,
                    "left": left,
                    "right": right,
                    "bottom": bottom,
                    "top": top,
                    "point_numbers": [
                        number
                        for _, number in in_band[start:start + k]
                    ],
                }

# print results
print(f"x bounds: [{best['left']:.3f}, {best['right']:.3f}]")
print(f"y bounds: [{best['bottom']:.3f}, {best['top']:.3f}]")
print(f"width: {best['right'] - best['left']:.3f}")
print(f"height: {best['top'] - best['bottom']:.3f}")
print(f"area: {best['area']:.3f}")
# print(f"selected points: {sorted(best['point_numbers'])}")

# export to GAMS
sol = [('enumeration','area',best['area']),
       ('enumeration','xmin',best['left']),
       ('enumeration','xmax',best['right']),
       ('enumeration','ymin',best['bottom']),
       ('enumeration','ymax',best['top']),
      ]
gams.set('solution',sol)

endEmbeddedCode solution

* introduce set element *at compile time*
set dummy 'register elements' /enumeration/;

display solution;

*---------------------------------------------------------------------
* visualization
*---------------------------------------------------------------------

$set html  plot.html
$set data  data.js

$if %htmlplot%==0 $goto skipplot


file fdata /%data%/; put fdata;

* points
put "p=["/;
loop(i,
  put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,",delta:";
  put$(delta.l(i)>0.5) "'red'";
  put$(delta.l(i)<0.5) "'darkblue'";
  put "},"/;
);
put "]"/;
put "pnts={n:",(card(i)):0:0,
       ",map:'[0,",maxsize:0:0,"]&times;[0,",maxsize:0:0,"]'",
       ",minx:",box('x','min'):0:3,
       ",miny:",box('y','min'):0:3,
       ",maxx:",box('x','max'):0:3,
       ",maxy:",box('y','max'):0:3,
       ",avgx:",(sum(i,p(i,'x'))/card(i)):0:3,
       ",avgy:",(sum(i,p(i,'y'))/card(i)):0:3,
       ",k:",k:0:0,
       ",rxmin:",(rect.l('x','min')):0:3,
       ",rxmax:",(rect.l('x','max')):0:3,
       ",rymin:",(rect.l('y','min')):0:3,
       ",rymax:",(rect.l('y','max')):0:3,
       ",area:",(area.l):0:3,
       "}"/;

putclose;

$onecho > %html%
<html>
<script src="https://cdn.plot.ly/plotly-3.4.0.min.js" charset="utf-8"></script>
<script src="%data%" charset="utf-8"></script>
<style>
.brdr {
  border: 1px solid black;
  border-collapse: collapse;
}
th, td {
  padding-left: 4px;
  padding-right: 4px;
}
</style>

<h1>Data</h1>
<table><tr><td>
<table class="brdr">
<tr><th colspan=2 class="brdr">points</th></tr>
<tr><td class="brdr">&#x1D45B;</td><td class="brdr" id="d_n"></td></tr>
<tr><td class="brdr">map</td><td class="brdr" id="d_map"></td></tr>
<tr><td class="brdr">min &#x1D465;</td><td class="brdr" id="d_minx"></td></tr>
<tr><td class="brdr">max &#x1D465;</td><td class="brdr" id="d_maxx"></td></tr>
<tr><td class="brdr">avg &#x1D465;</td><td class="brdr" id="d_avgx"></td></tr>
<tr><td class="brdr">min &#x1D466;</td><td class="brdr" id="d_miny"></td></tr>
<tr><td class="brdr">max &#x1D466;</td><td class="brdr" id="d_maxy"></td></tr>
<tr><td class="brdr">avg &#x1D466;</td><td class="brdr" id="d_avgy"></td></tr>
</table>
</td><td>
<div id="plotDiv0" style="width: 800px; height: 600px;"></div>
</td></tr></table>


<h1>Smallest Rectangle</h1>
<table><tr><td>
<table class="brdr">
<tr><th colspan=2 class="brdr">solution</th></tr>
<tr><td class="brdr">&#x1D45B;</td><td class="brdr" id="d_n2"></td></tr>
<tr><td class="brdr">&#x1D458;</td><td class="brdr" id="d_k"></td></tr>
<tr><td class="brdr">&#x1D465;min</td><td class="brdr" id="xmin">0</td></tr>
<tr><td class="brdr">&#x1D465;max</td><td class="brdr" id="xmax">0</td></tr>
<tr><td class="brdr">&#x1D466;min</td><td class="brdr" id="ymin">0</td></tr>
<tr><td class="brdr">&#x1D466;max</td><td class="brdr" id="ymax">0</td></tr>
<tr><td class="brdr">area</td><td class="brdr" id="area">0</td></tr>
</table>
</td><td>
<div id="plotDiv1" style="width: 800px; height: 600px;"></div>
</td></tr></table>


<script>

document.getElementById("d_n").innerHTML = pnts['n'];
document.getElementById("d_map").innerHTML = pnts['map'];
document.getElementById("d_minx").innerHTML = pnts['minx'];
document.getElementById("d_maxx").innerHTML = pnts['maxx'];
document.getElementById("d_miny").innerHTML = pnts['miny'];
document.getElementById("d_maxy").innerHTML = pnts['maxy'];
document.getElementById("d_avgx").innerHTML = pnts['avgx'];
document.getElementById("d_avgy").innerHTML = pnts['avgy'];

document.getElementById("d_n2").innerHTML = pnts['n'];
document.getElementById("d_k").innerHTML = pnts['k'];
document.getElementById("xmin").innerHTML = pnts['rxmin'];
document.getElementById("xmax").innerHTML = pnts['rxmax'];
document.getElementById("ymin").innerHTML = pnts['rymin'];
document.getElementById("ymax").innerHTML = pnts['rymax'];
document.getElementById("area").innerHTML = pnts['area'];



px = p.map((x) => x['x'])
py = p.map((x) => x['y'])
delta = p.map((x) => x['delta'])

var data1 = {
  x: px,
  y: py,
  mode: 'markers',
  type: 'scatter',
  name: 'data points',
  color: 'darkblue'
  
};

var layout1 = {
  autosize: false,
  width: 650,
  height: 600,
  showlegend: false,
  title: {text:"Data Points"},
}


var data2 = {
  x: px,
  y: py,
  mode: 'markers',
  type: 'scatter',
  name: 'solution',
  marker: { color: delta },
  showlegend: false,

};

var layout2 = {
  autosize: false,
  width: 650,
  height: 600,
  showlegend: false,
  title: {text:"Solution"},
  shapes: [{type:'rect',
            xref:'x',
            yref:'y',
            x0:pnts['rxmin'],
            y0:pnts['rymin'],
            x1:pnts['rxmax'],
            y1:pnts['rymax'],
            line:{color:'darkred',width:2,opacity:0.5},
            fillcolor:'rgba(0, 255, 255, 0.5)',
            },]
}


var trc1 = [data1];
var options1 = {staticPlot: true, displayModeBar: false, responsive: false};
Plotly.newPlot('plotDiv0', trc1, layout1, options1);

var trc2 = [data2];
var options2 = {staticPlot: true, displayModeBar: false, responsive: false};
Plotly.newPlot('plotDiv1', trc2, layout2, options2);


</script>
</html>
$offecho

executetool 'win32.ShellExecute "%html%"';

$label skipplot

