G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
       
         Find smallest axis-aligned 3d containing box containing
         a subset of given 3d points such that the total weight
         of the points inside the box is larger than a given number.
           
       
  10   
  11   
  12  *---------------------------------------------------------------
  13  * options
  14  *---------------------------------------------------------------
  15   
  16  option minlp=antigone;
  17   
  18  option seed=12345;
  19   
  20  *---------------------------------------------------------------
  21  * data
  22  *---------------------------------------------------------------
  23   
  24  scalars
  25     maxsize 'size of the outer box' / 10 /
  26     minWeight  'required total weight' / 25 /
  27  ;
  28   
  29  sets
  30     i    'points' /point1*point100/
  31     a    'attributes (coordinates,weight)' /x,y,z,w/
  32     c(a) 'coordinates' /x,y,z/
  33     lu   'lower/upper values' /min,max/
  34  ;
  35   
  36  parameters p(i,a) 'points';
  37   
  38  p(i,c) = uniform(0,maxsize);
  39  p(i,'w') = uniform(0,3);
  40  display minWeight,p;
  41   
  42   
  43  *---------------------------------------------------------------
  44  * derived data
  45  *---------------------------------------------------------------
  46   
  47  parameter box(c,lu) 'outer box: min/max values';
  48  box(c,'min') = smin(i, p(i,c));
  49  box(c,'max') = smax(i, p(i,c));
  50  display box;
  51   
  52  *---------------------------------------------------------------
  53  * model: enclose k points
  54  *---------------------------------------------------------------
  55   
  56  binary variable delta(i) 'point is selected';
  57   
  58  variable
  59     sbox(c,lu)  'box to contain selected points'
  60     d(c)       'length of sides'
  61     volume     'size of box'
  62  ;
  63   
  64  * bounds
  65  sbox.lo(c,lu) = box(c,'min');
  66  sbox.up(c,lu) = box(c,'max');
  67   
  68  d.lo(c) = 0;
  69  d.up(c) = box(c,'max') - box(c,'min');
  70   
  71   
  72  equations
  73      obj      'objective: area of enclosing rectangle'
  74      sumweight   'weight restriction'
  75      inside_min(i,c)  'points are inside'
  76      inside_max(i,c)  'points are inside'
  77      calcd(c)         'calculate d'
  78  ;
  79   
  80  sumweight..  sum(i, p(i,'w')*delta(i)) =g= minWeight;
  81   
  82  * inside: delta(i)=1  ==> sbox(c,'min') <= p(i,c) <= sbox(c,'max')
  83  inside_min(i,c)..  sbox(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
  84  inside_max(i,c)..  sbox(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');
  85   
  86  calcd(c).. d(c) =e= sbox(c,'max')-box(c,'min');
  87   
  88  obj.. volume =e= d('x')*d('y')*d('z');
  89   
  90  model m /all/;
  91  solve m minimizing volume using minlp;
  92   
  93  scalars
  94    count 'number of selected points'
  95    totw  'total weight of selected points'
  96  ;
  97  count = sum(i$(delta.l(i)>0.5),1);
  98  totw = sum(i$(delta.l(i)>0.5),p(i,'w'));
  99   
 100  display sbox.l,delta.l,volume.l,count,totw;


