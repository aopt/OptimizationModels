   4   
   5  * 0: no plot
   6  * 1: produce HTML plot)
   8   
   9  option minlp=antigone;
  10   
  11  option seed=12345;
  12   
  13  *---------------------------------------------------------------
  14  * data
  15  *---------------------------------------------------------------
  16   
  17  scalars
  18     maxsize 'size of the outer box' / 10 /
  19     minWeight  'required total weight' / 25 /
  20  ;
  21   
  22  sets
  23     i    'points' /point1*point100/
  24     a    'attributes (coordinates,weight)' /x,y,z,w/
  25     c(a) 'coordinates' /x,y,z/
  26     lu   'lower/upper values' /min,max/
  27  ;
  28   
  29  parameters p(i,a) 'points';
  30   
  31  p(i,c) = uniform(0,maxsize);
  32  p(i,'w') = uniform(0,2);
  33  display minWeight,p;
  34   
  35   
  36  *---------------------------------------------------------------
  37  * derived data
  38  *---------------------------------------------------------------
  39   
  40  parameter box(c,lu) 'outer box: min/max values';
  41  box(c,'min') = smin(i, p(i,c));
  42  box(c,'max') = smax(i, p(i,c));
  43  display box;
  44   
  45  *---------------------------------------------------------------
  46  * model: enclose k points
  47  *---------------------------------------------------------------
  48   
  49  binary variable delta(i) 'point is selected';
  50   
  51  variable
  52     sbox(c,lu)  'box to contain selected points'
  53     d(c)       'length of sides'
  54     volume     'size of box'
  55  ;
  56   
  57  * bounds
  58  sbox.lo(c,lu) = box(c,'min');
  59  sbox.up(c,lu) = box(c,'max');
  60   
  61  d.lo(c) = 0;
  62  d.up(c) = box(c,'max') - box(c,'min');
  63   
  64   
  65  equations
  66      obj      'objective: area of enclosing rectangle'
  67      sumweight   'weight restriction'
  68      inside_min(i,c)  'points are inside'
  69      inside_max(i,c)  'points are inside'
  70      calcd(c)         'calculate d'
  71  ;
  72   
  73  sumweight..  sum(i, p(i,'w')*delta(i)) =g= minWeight;
  74   
  75  * inside: delta(i)=1  ==> sbox(c,'min') <= p(i,c) <= sbox(c,'max')
  76  inside_min(i,c)..  sbox(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
  77  inside_max(i,c)..  sbox(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');
  78   
  79  calcd(c).. d(c) =e= sbox(c,'max')-box(c,'min');
  80   
  81  obj.. volume =e= d('x')*d('y')*d('z');
  82   
  83  model m /all/;
  84  solve m minimizing volume using minlp;
  85   
  86  scalars
  87    count 'number of selected points'
  88    totw  'total weight of selected points'
  89  ;
  90  count = sum(i$(delta.l(i)>0.5),1);
  91  totw = sum(i$(delta.l(i)>0.5),p(i,'w'));
  92   
  93  display sbox.l,delta.l,volume.l,count,totw;


