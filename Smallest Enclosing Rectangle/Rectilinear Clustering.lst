G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         cluster points using axis-aligned rectangles
         
         Two implementations:
         
            minimize area (nonconvex MIQCP)
            minimize perimeter (linear MIP)
       
  11   
  12   
  13  *---------------------------------------------------------------
  14  * Settings
  15  *---------------------------------------------------------------
  16   
  17  option seed=12345;
  18   
  19  option mip = copt;
  20  option miqcp = copt;
  21   
  22   
  23  *---------------------------------------------------------------
  24  * data
  25  *---------------------------------------------------------------
  26   
  27  scalars
  28     maxsize 'size of the outer box' / 10 /
  29  ;
  30   
  31  sets
  32     i   'points' /point1*point50/
  33     k   'rectangles' /rectangle1*rectangle5/
  34     c   'coordinates' /x,y/
  35     lu  'lower/upper values' /min,max/
  36  ;
  37   
  38  parameter p(i,c) 'points';
  39  p(i,c) = uniform(0,maxsize);
  40   
  41  option k:0,p:8;
  42  display k,p;
  43   
  44  *---------------------------------------------------------------
  45  * derived data
  46  *---------------------------------------------------------------
  47   
  48  * bounding box for data points
  49  parameter box(c,lu) 'min/max values';
  50  box(c,'min') = smin(i, p(i,c));
  51  box(c,'max') = smax(i, p(i,c));
  52   
  53  display box;
  54   
  55  *---------------------------------------------------------------
  56  * non-convex quadratic and linear model
  57  *---------------------------------------------------------------
  58   
  59  binary variables delta(i,k) 'assign point to rectangle';
  60   
  61  positive variables
  62      rect(k,c,lu) 'rectangle coordinates'
  63      d(k,c)  'width and length of rectangle'
  64  ;
  65   
  66  variables
  67     totalArea      'objective (nonconvex quadratic)'
  68     totalPerimeter 'objectic (linear)'
  69  ;
  70   
  71  * bounds
  72  rect.lo(k,c,lu) = box(c,'min');
  73  rect.up(k,c,lu) = box(c,'max');
  74  d.up(k,c) = box(c,'max')-box(c,'min');
  75   
  76  Equations
  77     obj1                'nonconvex quadratic: min sum area'
  78     obj2                'linear: min sum perimeter'
  79     inside_min(i,k,c)   'point i is inside rectangle k'
  80     inside_max(i,k,c)   'point i is inside rectangle k'
  81     inside_one(i)       'each point must be inside one rectangle'
  82     calc_d(k,c)         'calc height/width of rectangle'
  83     extra(k)            'symmetry breaker'
  84  ;
  85   
  86  obj1.. totalArea =e= sum(k, prod(c,d(k,c)));
  87  obj2.. totalPerimeter =e= sum(k, 2*sum(c,d(k,c)));
  88   
  89  inside_min(i,k,c).. rect(k,c,'min') =l= delta(i,k)*p(i,c) + (1-delta(i,k))*box(c,'max');
  90  inside_max(i,k,c).. rect(k,c,'max') =g= delta(i,k)*p(i,c) + (1-delta(i,k))*box(c,'min');
  91   
  92  inside_one(i).. sum(k, delta(i,k)) =e= 1;
  93   
  94  calc_d(k,c).. d(k,c) =e= rect(k,c,'max') - rect(k,c,'min');
  95   
  96  extra(k+1).. rect(k,'x','min') =l= rect(k+1,'x','min');
  97   
  98  model mArea      'quadratic' / all - obj2 /;
  99  model mPerimeter 'linear'    / all - obj1 /;
 100   
 101  *---------------------------------------------------------------
 102  * Solve and save results
 103  *---------------------------------------------------------------
 104   
 105  set dummy /min,max,len,points,count,area,perimeter/;
 106   
 107  parameter
 108      results(*,*,*,*) 'by cluster'
 109      assign(*,k)      'assignment=round(delta)'
 110      rect1            'saved version for postprocessing'
 111      rect2            'saved version for postprocessing'
 112  ;
 113   
 114  option assign:0;
 115   
 116  solve mArea minimizing totalArea using miqcp;
 117  abort$(mArea.solvestat<>1) "Abnormal completion";
 118  assign(i,k) = round(delta.l(i,k));
 119  assign('count',k) = sum(i,assign(i,k));
 120  display delta.l, assign, rect.l, d.l, totalArea.l;
 121   
 122  rect1(k,c,lu) = rect.l(k,c,lu);
 123   
 124  results('min area obj',k,c,'min') = rect.l(k,c,'min');
 125  results('min area obj',k,c,'max') = rect.l(k,c,'max');
 126  results('min area obj',k,c,'len') = d.l(k,c);
 127  results('min area obj',k,'','points') = sum(i$(delta.l(i,k)>0.5),1);
 128  results('min area obj',k,'','area') = prod(c,d.l(k,c));
 129  results('min area obj',k,'','perimeter') = 2*sum(c,d.l(k,c));
 130  results('min area obj','total','','points') = sum((i,k)$(delta.l(i,k)>0.5),1);
 131  results('min area obj','total','','area') = sum(k,prod(c,d.l(k,c)));
 132  results('min area obj','total','','perimeter') = sum(k,2*sum(c,d.l(k,c)));
 133   
 134  solve mPerimeter minimizing totalPerimeter using mip;
 135  abort$(mPerimeter.solvestat<>1) "Abnormal completion";
 136  assign(i,k) = round(delta.l(i,k));
 137  assign('count',k) = sum(i,assign(i,k));
 138  display delta.l, assign, rect.l, d.l, totalPerimeter.l;
 139   
 140  rect2(k,c,lu) = rect.l(k,c,lu);
 141   
 142  results('min perim obj',k,c,'min') = rect.l(k,c,'min');
 143  results('min perim obj',k,c,'max') = rect.l(k,c,'max');
 144  results('min perim obj',k,c,'len') = d.l(k,c);
 145  results('min perim obj',k,'','points') = sum(i$(delta.l(i,k)>0.5),1);
 146  results('min perim obj',k,'','area') = prod(c,d.l(k,c));
 147  results('min perim obj',k,'','perimeter') = 2*sum(c,d.l(k,c));
 148  results('min perim obj','total','','points') = sum((i,k)$(delta.l(i,k)>0.5),1);
 149  results('min perim obj','total','','area') = sum(k,prod(c,d.l(k,c)));
 150  results('min perim obj','total','','perimeter') = sum(k,2*sum(c,d.l(k,c)));
 151   
 152  option results:3;
 153  display results;


