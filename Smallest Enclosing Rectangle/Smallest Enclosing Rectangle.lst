GAMS 54.1.0  37378ce0 Jun 15, 2026          WEX-WEI x86 64bit/MS Windows - 09/26/26 17:17:59 Page 1
G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Find smallest axis-aligned rectangle containing k out of n points.
           
         References:
            Timothy M. Chan, Sariel Har-Peled
            Smallest k-Enclosing Rectangle Revisited
            https://arxiv.org/abs/1903.06785
       
  11   
  12  *---------------------------------------------------------------
  13  * options
  14  *---------------------------------------------------------------
  15   
  16  * 0: no plot
  17  * 1: produce HTML plot)
  19   
  20  option miqcp=antigone;
  21   
  22  option seed=12345;
  23   
  24  *---------------------------------------------------------------
  25  * data
  26  *---------------------------------------------------------------
  27   
  28  scalar maxsize 'size of the outer box' / 10 /;
  29   
  30  sets
  31     i   'points' /point1*point100/
  32     c   'coordinates' /x,y/
  33  ;
  34   
  35  parameter p(i,c) 'points';
  36  p(i,c) = uniform(0,maxsize);
  37  display p;
  38   
  39   
  40  *---------------------------------------------------------------
  41  * enclose all points (easy)
  42  *---------------------------------------------------------------
  43   
  44  Parameter
  45     rect1(c,*) 'contain all points'
  46  ;
  47   
  48  rect1(c,'min') = smin(i,p(i,c));
  49  rect1(c,'max') = smax(i,p(i,c));
  50  display rect1;
  51   
  52  *---------------------------------------------------------------
  53  * enclose k points
  54  *---------------------------------------------------------------
  55   
  56  scalar k 'number of points (subset)' /25/;
  57   
  58  binary variable delta(i) 'point is selected';
  59  variable
  60     rect2(c,*) 'contain k points'
  61     d(c)       'length of sides'
  62     area       'size of rectangle'
  63  ;
  64   
  65  * bounds
  66  rect2.lo(c,'min') = smin(i,p(i,c));
  67  rect2.lo(c,'max') = smin(i,p(i,c));
  68  rect2.up(c,'min') = smax(i,p(i,c));
  69  rect2.up(c,'max') = smax(i,p(i,c));
  70   
  71  d.lo(c) = 0;
  72  d.up(c) =  smax(i,p(i,c)) - smin(i,p(i,c));
  73   
  74   
  75  equations
  76      obj      'objective: area of enclosing rectangle'
  77      count    'number of points to select'
  78      inside_min(i,c)  'points are inside'
  79      inside_max(i,c)  'points are inside'
  80      calcd(c)         'calculate d'
  81  ;
  82   
  83  count..  sum(i, delta(i)) =e= k;
  84   
  85  * inside: delta(i)=1  ==> rect2(c,'min') <= p(i,c) <= rect2(c,'max')
  86  inside_min(i,c)..  rect2(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*maxsize;
  87  inside_max(i,c)..  rect2(c,'max') =g= delta(i)*p(i,c);
  88   
  89  calcd(c).. d(c) =e= rect2(c,'max')-rect2(c,'min');
  90   
  91  obj.. area =e= d('x')*d('y');
  92   
  93   
  94  model m /all/;
  95  solve m minimizing area using miqcp;
  96   
  97  display rect2.l,delta.l,area.l;
  98   
  99   
 100  *---------------------------------------------------------------------
 101  * visualization
 102  *---------------------------------------------------------------------
 103   
 106   
 108   
 109   
 110  file fdata /data.js/; put fdata;
 111   
 112  * points
 113  put "p=["/;
 114  loop(i,
 115    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,",delta:";
 116    put$(delta.l(i)>0.5) "'red'";
 117    put$(delta.l(i)<0.5) "'darkblue'";
 118    put "},"/;
 119  );
 120  put "]"/;
 121  put "pnts={n:",(card(i)):0:0,
 122         ",map:'[0,",maxsize:0:0,"]&times;[0,",maxsize:0:0,"]'",
 123         ",minx:",(smin(i,p(i,'x'))):0:3,
 124         ",miny:",(smin(i,p(i,'y'))):0:3,
 125         ",maxx:",(smax(i,p(i,'x'))):0:3,
 126         ",maxy:",(smax(i,p(i,'y'))):0:3,
 127         ",avgx:",(sum(i,p(i,'x'))/card(i)):0:3,
 128         ",avgy:",(sum(i,p(i,'y'))/card(i)):0:3,
 129         ",k:",k:0:0,
 130         ",rxmin:",(rect2.l('x','min')):0:3,
 131         ",rxmax:",(rect2.l('x','max')):0:3,
 132         ",rymin:",(rect2.l('y','min')):0:3,
 133         ",rymax:",(rect2.l('y','max')):0:3,
 134         ",area:",(area.l):0:3,
 135         "}"/;
 136   
 137  putclose;
 138   
 275   
 276  executetool 'win32.ShellExecute "plot.html"';
 277   
 279   


