G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


       
         Find smallest axis-aligned rectangle containing k out of n points.
           
         References:
            Timothy M. Chan, Sariel Har-Peled
            Smallest k-Enclosing Rectangle Revisited
            https://arxiv.org/abs/1903.06785
       
  11   
  12  *---------------------------------------------------------------
  13  * options
  14  *---------------------------------------------------------------
  15   
  16  * 0: no plot
  17  * 1: produce HTML plot)
  19   
  20  option miqcp=antigone;
  21   
  22  option seed=12345;
  23   
  24  *---------------------------------------------------------------
  25  * data
  26  *---------------------------------------------------------------
  27   
  28  scalars
  29     maxsize 'size of the outer box' / 10 /
  30     k       'number of points to select' / 25 /
  31  ;
  32   
  33  sets
  34     i   'points' /point1*point100/
  35     c   'coordinates' /x,y/
  36     lu  'lower/upper values' /min,max/
  37  ;
  38   
  39  parameter p(i,c) 'points';
  40  p(i,c) = uniform(0,maxsize);
  41   
  42  display k,p;
  43   
  44  *---------------------------------------------------------------
  45  * derived data
  46  *---------------------------------------------------------------
  47   
  48  parameter box(c,lu) 'min/max values';
  49  box(c,'min') = smin(i, p(i,c));
  50  box(c,'max') = smax(i, p(i,c));
  51   
  52  display box;
  53   
  54  *---------------------------------------------------------------
  55  * model: enclose k points
  56  *---------------------------------------------------------------
  57   
  58  binary variable delta(i) 'point is selected';
  59   
  60  variable
  61     rect(c,lu) 'rectangle to contain k points'
  62     d(c)       'length of sides'
  63     area       'size of rectangle'
  64  ;
  65   
  66  * bounds
  67  rect.lo(c,lu) = box(c,'min');
  68  rect.up(c,lu) = box(c,'max');
  69   
  70  d.lo(c) = 0;
  71  d.up(c) = box(c,'max') - box(c,'min');
  72   
  73   
  74  equations
  75      obj      'objective: area of enclosing rectangle'
  76      count    'number of points to select'
  77      inside_min(i,c)  'points are inside'
  78      inside_max(i,c)  'points are inside'
  79      calcd(c)         'calculate d'
  80  ;
  81   
  82  count..  sum(i, delta(i)) =e= k;
  83   
  84  * inside: delta(i)=1  ==> rect(c,'min') <= p(i,c) <= rect(c,'max')
  85  inside_min(i,c)..  rect(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
  86  inside_max(i,c)..  rect(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');
  87   
  88  calcd(c).. d(c) =e= rect(c,'max')-rect(c,'min');
  89   
  90  obj.. area =e= d('x')*d('y');
  91   
  92   
  93  model m /all/;
  94  solve m minimizing area using miqcp;
  95   
  96  display rect.l,delta.l,area.l;
  97   
  98   
  99  *---------------------------------------------------------------------
 100  * algorithm
 101  *---------------------------------------------------------------------
 102   
 103  scalar n;
 104  n = card(i);
 105   
 106  embeddedCode Python:
 107   
 108  n = int(list(gams.get("n"))[0]);
 109  k = int(list(gams.get("k"))[0]);
 110  print(f"n={n},k={k}")
 111   
 112  # get points and store as list of tuples (id,x,y)
 113  points=[]
 114  pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
 115  for i in range(n):
 116      px = next(pgen)
 117      py = next(pgen)
 118      points.append((i+1,px[2],py[2]))
 119   
 120  # the test was generated by ChatGPT
 121  # I think this can be improved upon
 122   
 123  y_values = sorted({y for _, _, y in points})
 124   
 125  best = None
 126   
 127  # Try every possible bottom and top edge.
 128  for i, bottom in enumerate(y_values):
 129      for top in y_values[i:]:
 130          # Points inside this horizontal band, sorted by x.
 131          in_band = sorted(
 132              (x, number)
 133              for number, x, y in points
 134              if bottom <= y <= top
 135          )
 136   
 137          if len(in_band) < k:
 138              continue
 139   
 140          # Any minimal-width interval containing k points can be
 141          # represented by k consecutive points in this sorted list.
 142          for start in range(len(in_band) - k + 1):
 143              left = in_band[start][0]
 144              right = in_band[start + k - 1][0]
 145              width = right - left
 146              height = top - bottom
 147              area = width * height
 148   
 149              if best is None or area < best["area"]:
 150                  best = {
 151                      "area": area,
 152                      "left": left,
 153                      "right": right,
 154                      "bottom": bottom,
 155                      "top": top,
 156                      "point_numbers": [
 157                          number
 158                          for _, number in in_band[start:start + k]
 159                      ],
 160                  }
 161   
 162  print(f"x bounds: [{best['left']}, {best['right']}]")
 163  print(f"y bounds: [{best['bottom']}, {best['top']}]")
 164  print(f"width: {best['right'] - best['left']}")
 165  print(f"height: {best['top'] - best['bottom']}")
 166  print(f"area: {best['area']}")
 167  print(f"25 contained points: {sorted(best['point_numbers'])}")
 168   
 169  endEmbeddedCode
