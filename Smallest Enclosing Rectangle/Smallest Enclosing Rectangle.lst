C o m p i l a t i o n


       
         Find smallest axis-aligned rectangle containing k out of n points.
           
         https://yetanothermathprogrammingconsultant.blogspot.com/2026/09/minimum-enclosing-rectangle-for-k-out.html
         
   8   
   9  *---------------------------------------------------------------
  10  * options
  11  *---------------------------------------------------------------
  12   
  13  * 0: no plot
  14  * 1: produce HTML plot)
  16   
  17  option miqcp=antigone;
  18   
  19  * don't stop on tolerance: we want global optimal solutions
  20  option optcr=0;
  21   
  22  option seed=12345;
  23   
  24  *---------------------------------------------------------------
  25  * data
  26  *---------------------------------------------------------------
  27   
  28  scalars
  29     maxsize 'size of the outer box' / 10 /
  30     k       'number of points to select' / 25 /
  31  ;
  32   
  33  sets
  34     i   'points' /point1*point100/
  35     c   'coordinates' /x,y/
  36     lu  'lower/upper values' /min,max/
  37  ;
  38   
  39  parameter p(i,c) 'points';
  40  p(i,c) = uniform(1.0e-10,maxsize);
  41  * I don't want exact zeros (easier to export to Python)
  42   
  43   
  44  option k:0,p:8;
  45  display k,p;
  46   
  47  *---------------------------------------------------------------
  48  * derived data
  49  *---------------------------------------------------------------
  50   
  51  * bounding box for data points
  52  parameter box(c,lu) 'min/max values';
  53  box(c,'min') = smin(i, p(i,c));
  54  box(c,'max') = smax(i, p(i,c));
  55   
  56  display box;
  57   
  58  *---------------------------------------------------------------
  59  * model: enclose k points
  60  *---------------------------------------------------------------
  61   
  62  binary variable delta(i) 'point is selected';
  63   
  64  variable
  65     rect(c,lu) 'rectangle to contain k points'
  66     d(c)       'length of sides'
  67     area       'size of rectangle'
  68  ;
  69   
  70  * bounds
  71  rect.lo(c,lu) = box(c,'min');
  72  rect.up(c,lu) = box(c,'max');
  73   
  74  d.lo(c) = 0;
  75  d.up(c) = box(c,'max') - box(c,'min');
  76   
  77   
  78  equations
  79      obj      'objective: area of enclosing rectangle'
  80      count    'number of points to select'
  81      inside_min(i,c)  'points are inside'
  82      inside_max(i,c)  'points are inside'
  83      calcd(c)         'calculate d'
  84  ;
  85   
  86  count..  sum(i, delta(i)) =e= k;
  87   
  88  * inside: delta(i)=1  ==> rect(c,'min') <= p(i,c) <= rect(c,'max')
  89  inside_min(i,c)..  rect(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
  90  inside_max(i,c)..  rect(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');
  91   
  92  calcd(c).. d(c) =e= rect(c,'max')-rect(c,'min');
  93   
  94  obj.. area =e= d('x')*d('y');
  95   
  96  model m /all/;
  97  solve m minimizing area using miqcp;
  98  abort$(m.solvestat<>1) "Abnormal completion";
  99   
 100  display rect.l,delta.l,area.l;
 101   
 102   
 103  parameter solution(*,*) 'compare solutions';
 104  solution('area','miqcp') = area.l;
 105  solution('xmin','miqcp') = rect.l('x','min');
 106  solution('xmax','miqcp') = rect.l('x','max');
 107  solution('ymin','miqcp') = rect.l('y','min');
 108  solution('ymax','miqcp') = rect.l('y','max');
 109   
 110   
 111  *---------------------------------------------------------------------
 112  * quick solution consistency check
 113  * recalc area from delta variables
 114  *---------------------------------------------------------------------
 115   
 116  Scalars
 117    checktol 'tolerance for check' /1e-6/
 118    k2 'number of selected points'
 119    area2 'calculated from selected points'
 120    absdiff 'difference'
 121  ;
 122   
 123  k2 = sum(i,round(delta.l(i)));
 124  area2 = prod(c, smax(i$(delta.l(i)>0.5), p(i,c)) - smin(i$(delta.l(i)>0.5), p(i,c)));
 125  absdiff = abs(area.l-area2);
 126   
 127  abort$(k2<>k) "number of selected points incorrect",k2;
 128  abort$(absdiff > checktol) "solution check failed",absdiff;
 129   
 130  *---------------------------------------------------------------------
 131  * geometric algorithm
 132  *---------------------------------------------------------------------
 133   
 134  scalar n 'number of data points';
 135  n = card(i);
 136   
 137  parameter solution(*,*) 'compare solutions';
 138   
 139  embeddedCode Python:
 140   
 141  n = int(list(gams.get("n"))[0]);
 142  k = int(list(gams.get("k"))[0]);
 143  print(f"n={n},k={k}")
 144   
 145  # get points and store as list of tuples (id,x,y)
 146  points=[]
 147  pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
 148  for i in range(n):
 149      px = next(pgen)
 150      py = next(pgen)
 151      points.append((i+1,px[2],py[2]))
 152   
 153  # the rest was largely generated by ChatGPT
 154   
 155  y_values = sorted({y for _, _, y in points})
 156   
 157  best = None
 158   
 159  # Try every possible bottom and top edge.
 160  for i, bottom in enumerate(y_values):
 161      for top in y_values[i:]:
 162          # Points inside this horizontal band, sorted by x.
 163          in_band = sorted(
 164              (x, number)
 165              for number, x, y in points
 166              if bottom <= y <= top
 167          )
 168   
 169          if len(in_band) < k:
 170              continue
 171   
 172          # Any minimal-width interval containing k points can be
 173          # represented by k consecutive points in this sorted list.
 174          for start in range(len(in_band) - k + 1):
 175              left = in_band[start][0]
 176              right = in_band[start + k - 1][0]
 177              width = right - left
 178              height = top - bottom
 179              area = width * height
 180   
 181              if best is None or area < best["area"]:
 182                  best = {
 183                      "area": area,
 184                      "left": left,
 185                      "right": right,
 186                      "bottom": bottom,
 187                      "top": top,
 188                      "point_numbers": [
 189                          number
 190                          for _, number in in_band[start:start + k]
 191                      ],
 192                  }
 193   
 194  # print results
 195  print(f"x bounds: [{best['left']:.3f}, {best['right']:.3f}]")
 196  print(f"y bounds: [{best['bottom']:.3f}, {best['top']:.3f}]")
 197  print(f"width: {best['right'] - best['left']:.3f}")
 198  print(f"height: {best['top'] - best['bottom']:.3f}")
 199  print(f"area: {best['area']:.3f}")
 200  # print(f"selected points: {sorted(best['point_numbers'])}")
 201   
 202  # export to GAMS
 203  sol = [('area','enum',best['area']),
 204         ('xmin','enum',best['left']),
 205         ('xmax','enum',best['right']),
 206         ('ymin','enum',best['bottom']),
 207         ('ymax','enum',best['top']),
 208        ]
 209  gams.set('solution',sol)
 210   
 211  endEmbeddedCode solution
 212   
 213  * introduce set element *at compile time*
 214  set dummy 'register elements' /enum,sa/;
 215   
 216  display solution;
 217   
 218   
 219  *---------------------------------------------------------------------
 220  *  algorithm
 221  *---------------------------------------------------------------------
 222   
 223   
 224   
 225  embeddedCode Python:
 226   
 227  import random, math
 228   
 229  random.seed(123)
 230  random.seed(2) # finds optimal solution
 231   
 232  n = int(list(gams.get("n"))[0]);
 233  k = int(list(gams.get("k"))[0]);
 234  print(f"n={n},k={k}")
 235   
 236   
 237  # get points and store as list of tuples (id,x,y)
 238  points=[]
 239  pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
 240  for i in range(n):
 241      px = next(pgen)
 242      py = next(pgen)
 243      points.append((px[0],px[2],py[2]))
 244   
 245  numevals = 0
 246   
 247  def eval(sel):
 248     global numevals
 249     numevals = numevals + 1
 250     xmin = 1.0e+10
 251     ymin = 1.0e+10
 252     xmax = -1.0e10
 253     ymax = -1.0e10
 254   
 255     for ind in sel:
 256        p = points[ind]
 257        x = p[1]
 258        y = p[2]
 259        if x<xmin:xmin=x
 260        if y<ymin:ymin=y
 261        if x>xmax:xmax=x
 262        if y>ymax:ymax=y
 263     area = (xmax-xmin)*(ymax-ymin)
 264     return xmin,xmax,ymin,ymax,area
 265     
 266  def obj(sel):
 267      r = eval(sel)
 268      return r[4]
 269   
 270  def sa(obj, n, k, iters=100_000, T0=1.0, alpha=0.9999):
 271      sel = set(random.sample(range(n), k)); out = set(range(n)) - sel
 272      cur = obj(sel); best, best_val, T = set(sel), cur, T0
 273      for _ in range(iters):
 274          i, j = random.choice(tuple(sel)), random.choice(tuple(out))
 275          sel.remove(i); sel.add(j)
 276          new = obj(sel)
 277          if new <= cur or random.random() < math.exp((cur - new) / T):
 278              out.remove(j); out.add(i); cur = new
 279              if cur < best_val: best, best_val = set(sel), cur
 280          else:
 281              sel.remove(j); sel.add(i)
 282          T *= alpha
 283      return best, best_val
 284   
 285  best, best_val = sa(obj,n,k)
 286  print(f"best area: {best_val}")
 287  print(f"evaluations: {numevals}")
 288   
 289  # export to GAMS
 290  xmin,xmax,ymin,ymax,area = eval(best) 
 291  sol = [('area','sa',area),
 292         ('xmin','sa',xmin),
 293         ('xmax','sa',xmax),
 294         ('ymin','sa',ymin),
 295         ('ymax','sa',ymax),
 296        ]
 297  gams.set('solution',sol)
 298   
 299   
 300  endEmbeddedCode solution
 301   
 302  display solution;
