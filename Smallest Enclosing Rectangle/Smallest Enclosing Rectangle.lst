C o m p i l a t i o n


       
         Find smallest axis-aligned rectangle containing k out of n points.
           
         https://yetanothermathprogrammingconsultant.blogspot.com/2026/09/minimum-enclosing-rectangle-for-k-out.html
         
   8   
   9  *---------------------------------------------------------------
  10  * options
  11  *---------------------------------------------------------------
  12   
  13  * 0: no plot
  14  * 1: produce HTML plot)
  16   
  17  option miqcp=antigone;
  18   
  19  * don't stop on tolerance: we want global optimal solutions
  20  option optcr=0;
  21   
  22  option seed=12345;
  23   
  24  *---------------------------------------------------------------
  25  * data
  26  *---------------------------------------------------------------
  27   
  28  scalars
  29     maxsize 'size of the outer box' / 10 /
  30     k       'number of points to select' / 25 /
  31  ;
  32   
  33  sets
  34     i   'points' /point1*point100/
  35     c   'coordinates' /x,y/
  36     lu  'lower/upper values' /min,max/
  37  ;
  38   
  39  parameter p(i,c) 'points';
  40  p(i,c) = uniform(0,maxsize);
  41   
  42  option k:0,p:8;
  43  display k,p;
  44   
  45  *---------------------------------------------------------------
  46  * derived data
  47  *---------------------------------------------------------------
  48   
  49  * bounding box for data points
  50  parameter box(c,lu) 'min/max values';
  51  box(c,'min') = smin(i, p(i,c));
  52  box(c,'max') = smax(i, p(i,c));
  53   
  54  display box;
  55   
  56  *---------------------------------------------------------------
  57  * model: enclose k points
  58  *---------------------------------------------------------------
  59   
  60  binary variable delta(i) 'point is selected';
  61   
  62  variable
  63     rect(c,lu) 'rectangle to contain k points'
  64     d(c)       'length of sides'
  65     area       'size of rectangle'
  66  ;
  67   
  68  * bounds
  69  rect.lo(c,lu) = box(c,'min');
  70  rect.up(c,lu) = box(c,'max');
  71   
  72  d.lo(c) = 0;
  73  d.up(c) = box(c,'max') - box(c,'min');
  74   
  75   
  76  equations
  77      obj      'objective: area of enclosing rectangle'
  78      count    'number of points to select'
  79      inside_min(i,c)  'points are inside'
  80      inside_max(i,c)  'points are inside'
  81      calcd(c)         'calculate d'
  82  ;
  83   
  84  count..  sum(i, delta(i)) =e= k;
  85   
  86  * inside: delta(i)=1  ==> rect(c,'min') <= p(i,c) <= rect(c,'max')
  87  inside_min(i,c)..  rect(c,'min') =l= delta(i)*p(i,c) + (1-delta(i))*box(c,'max');
  88  inside_max(i,c)..  rect(c,'max') =g= delta(i)*p(i,c) + (1-delta(i))*box(c,'min');
  89   
  90  calcd(c).. d(c) =e= rect(c,'max')-rect(c,'min');
  91   
  92  obj.. area =e= d('x')*d('y');
  93   
  94  model m /all/;
  95  solve m minimizing area using miqcp;
  96  abort$(m.solvestat<>1) "Solver problem";
  97   
  98  display rect.l,delta.l,area.l;
  99   
 100   
 101  parameter solution(*,*) 'comparison';
 102  solution('miqcp','area') = area.l;
 103  solution('miqcp','xmin') = rect.l('x','min');
 104  solution('miqcp','xmax') = rect.l('x','max');
 105  solution('miqcp','ymin') = rect.l('y','min');
 106  solution('miqcp','ymax') = rect.l('y','max');
 107   
 108   
 109  *---------------------------------------------------------------------
 110  * quick solution consistency check
 111  * recalc area from delta variables
 112  *---------------------------------------------------------------------
 113   
 114  Scalars
 115    checktol 'tolerance for check' /1e-6/
 116    k2 'number of selected points'
 117    area2 'calculated from selected points'
 118    absdiff 'difference'
 119  ;
 120   
 121  k2 = sum(i,round(delta.l(i)));
 122  area2 = prod(c, smax(i$(delta.l(i)>0.5), p(i,c)) - smin(i$(delta.l(i)>0.5), p(i,c)));
 123  absdiff = abs(area.l-area2);
 124   
 125  abort$(k2<>k) "number of selected points incorrect",k2;
 126  abort$(absdiff > checktol) "solution check failed",absdiff;
 127   
 128   
 129  *---------------------------------------------------------------------
 130  * algorithm
 131  *---------------------------------------------------------------------
 132   
 133  scalar n 'number of data points';
 134  n = card(i);
 135   
 136  embeddedCode Python:
 137   
 138  n = int(list(gams.get("n"))[0]);
 139  k = int(list(gams.get("k"))[0]);
 140  print(f"n={n},k={k}")
 141   
 142  # get points and store as list of tuples (id,x,y)
 143  points=[]
 144  pgen = gams.get("p",keyFormat=KeyFormat.FLAT) 
 145  for i in range(n):
 146      px = next(pgen)
 147      py = next(pgen)
 148      points.append((i+1,px[2],py[2]))
 149   
 150  # the rest was largely generated by ChatGPT
 151   
 152  y_values = sorted({y for _, _, y in points})
 153   
 154  best = None
 155   
 156  # Try every possible bottom and top edge.
 157  for i, bottom in enumerate(y_values):
 158      for top in y_values[i:]:
 159          # Points inside this horizontal band, sorted by x.
 160          in_band = sorted(
 161              (x, number)
 162              for number, x, y in points
 163              if bottom <= y <= top
 164          )
 165   
 166          if len(in_band) < k:
 167              continue
 168   
 169          # Any minimal-width interval containing k points can be
 170          # represented by k consecutive points in this sorted list.
 171          for start in range(len(in_band) - k + 1):
 172              left = in_band[start][0]
 173              right = in_band[start + k - 1][0]
 174              width = right - left
 175              height = top - bottom
 176              area = width * height
 177   
 178              if best is None or area < best["area"]:
 179                  best = {
 180                      "area": area,
 181                      "left": left,
 182                      "right": right,
 183                      "bottom": bottom,
 184                      "top": top,
 185                      "point_numbers": [
 186                          number
 187                          for _, number in in_band[start:start + k]
 188                      ],
 189                  }
 190   
 191  # print results
 192  print(f"x bounds: [{best['left']:.3f}, {best['right']:.3f}]")
 193  print(f"y bounds: [{best['bottom']:.3f}, {best['top']:.3f}]")
 194  print(f"width: {best['right'] - best['left']:.3f}")
 195  print(f"height: {best['top'] - best['bottom']:.3f}")
 196  print(f"area: {best['area']:.3f}")
 197  # print(f"selected points: {sorted(best['point_numbers'])}")
 198   
 199  # export to GAMS
 200  sol = [('enumeration','area',best['area']),
 201         ('enumeration','xmin',best['left']),
 202         ('enumeration','xmax',best['right']),
 203         ('enumeration','ymin',best['bottom']),
 204         ('enumeration','ymax',best['top']),
 205        ]
 206  gams.set('solution',sol)
 207   
 208  endEmbeddedCode solution
 209   
 210  * introduce set element *at compile time*
 211  set dummy 'register elements' /enumeration/;
 212   
 213  display solution;
 214   
 215  *---------------------------------------------------------------------
 216  * visualization
 217  *---------------------------------------------------------------------
 218   
 221   
 223   
 224   
 225  file fdata /data.js/; put fdata;
 226   
 227  * points
 228  put "p=["/;
 229  loop(i,
 230    put "  {i:'",i.tl:0,"',x:",p(i,'x'):0:4,",y:",p(i,'y'):0:4,",delta:";
 231    put$(delta.l(i)>0.5) "'red'";
 232    put$(delta.l(i)<0.5) "'darkblue'";
 233    put "},"/;
 234  );
 235  put "]"/;
 236  put "pnts={n:",(card(i)):0:0,
 237         ",map:'[0,",maxsize:0:0,"]&times;[0,",maxsize:0:0,"]'",
 238         ",minx:",box('x','min'):0:3,
 239         ",miny:",box('y','min'):0:3,
 240         ",maxx:",box('x','max'):0:3,
 241         ",maxy:",box('y','max'):0:3,
 242         ",avgx:",(sum(i,p(i,'x'))/card(i)):0:3,
 243         ",avgy:",(sum(i,p(i,'y'))/card(i)):0:3,
 244         ",k:",k:0:0,
 245         ",rxmin:",(rect.l('x','min')):0:3,
 246         ",rxmax:",(rect.l('x','max')):0:3,
 247         ",rymin:",(rect.l('y','min')):0:3,
 248         ",rymax:",(rect.l('y','max')):0:3,
 249         ",area:",(area.l):0:3,
 250         "}"/;
 251   
 252  putclose;
 253   
 390   
 391  executetool 'win32.ShellExecute "plot.html"';
 392   
