C o m p i l a t i o n


       
         Clock problem
         
         References:
         https://www.scientificamerican.com/game/math-puzzle-find-the-time/
         https://yetanothermathprogrammingconsultant.blogspot.com/2025/11/clock-problem.html
       
  10   
  11   
  12  Set
  13     h 'hand' /h1,h2,h3/
  14     r 'role' /hour,minute,second/
  15  ;
  16  *alias (h,hh);
  17   
  18  variable
  19   
  20  * hands h1,h2,h3
  21     relpos(h) 'relative position of hands (define h1=0)'
  22     offset    'from relpos'
  23     hpos(h)   'final position of hands (relpos + offset mod 12, in decimal hours)'
  24     modulo(h) 'binary variable to implement mod 12'
  25   
  26  * role hour,minute,second
  27     assign(h,r) 'assign unique role to hand'
  28     rpos(r)     'position of hr/min/sec hand ∈[0,11.99]'
  29   
  30  * reporting
  31     v(r)        '(integer) value in hours,minutes and seconds'
  32   
  33  * objective
  34     z        'dummy objective variable'
  35  ;
  36  integer variable offset,v;
  37  binary variable modulo, assign;
  38   
  39  offset.up = 11;
  40   
  41  hpos.lo(h) = 0;
  42  hpos.up(h) = 11.999;
  43   
  44  v.lo(r) = 0;
  45  v.up(r) = 59;
  46  v.up('hour') = 11;
  47   
  48  * read relative positions from the clock:
  49  * h1 = 0, h2 = 2, h3 ∈ [6.8,7]
  50  table relposdata(h,*) 'relative position (interval) in units of hours (define h1=0)'
  51         lo    up
  52     h1   0    0
  53     h2   2    2
  54     h3   6.8  7
  55  ;
  56  relpos.lo(h) = relposdata(h,'lo');
  57  relpos.up(h) = relposdata(h,'up');
  58   
  59  equations
  60     obj 'dummy objective'
  61   
  62     e_hpos(h) 'position of hands (in decimal hours)'
  63     e_assign1 'unique assignment hand <=> role'
  64     e_assign2 'unique assignment hand <=> role'
  65     assignpos 'calc rpos from hpos (nonlinear)'
  66   
  67  * unit conversions
  68     seconds   'calc seconds from rpos'
  69     minutes   'calc minutes from rpos'
  70     hours     'calc hours from rpos'
  71  ;
  72   
  73  * label(h) = (relpos(h) + offset) mod 12
  74  e_hpos(h)..  hpos(h) =e= relpos(h) + offset - modulo(h)*12;
  75   
  76  * unique assignment hand <=> role
  77  e_assign1(r).. sum(h,assign(h,r)) =e= 1;
  78  e_assign2(h).. sum(r,assign(h,r)) =e= 1;
  79   
  80  assignpos(r).. rpos(r) =e= sum(h, assign(h,r)*hpos(h));
  81   
  82  seconds.. v('second') =e= rpos('second')*60/12;
  83  minutes.. v('minute') =e= rpos('minute')*60/12 - v('second')/60;
  84  hours..   v('hour') =e= rpos('hour') - v('minute')/60 - v('second')/60/60;
  85   
  86  obj.. z =e= 0;
  87   
  88  *------------------------------------------------
  89  * nonconvex quadratic model
  90  *------------------------------------------------
  91   
  92  model m1 /all/;
  93  option miqcp=baron;
  94  solve m1 minimizing z using miqcp;
  95  display relpos.l,offset.l,hpos.l,assign.l,rpos.l,v.l;
  96   
  97  *------------------------------------------------
  98  * linearized model
  99  *------------------------------------------------
 100   
 101  positive variables prd(h,r) 'product prd(h,r)=assign(h,r)*hpos(h)';
 102  prd.up(h,r) = hpos.up(h);
 103   
 104  equations
 105     prod1(h,r) 'linearization of product'
 106     prod2(h,r) 'linearization of product'
 107     prod3(h,r) 'linearization of product'
 108     assignpos2(r) 'linearization of product'
 109  ;
 110   
 111  prod1(h,r).. prd(h,r) =l= hpos.up(h)*assign(h,r);
 112  prod2(h,r).. prd(h,r) =l= hpos(h);
 113  prod3(h,r).. prd(h,r) =g= hpos(h)-hpos.up(h)*(1-assign(h,r));
 114   
 115  assignpos2(r)..  rpos(r) =e= sum(h, prd(h,r));
 116   
 117  model m2 /m1-assignpos,prod1,prod2,prod3,assignpos2/;
 118  solve m2 minimizing z using mip;
 119  display relpos.l,offset.l,hpos.l,assign.l,rpos.l,v.l;


